// The fantasy theme's street house (#1598): a storybook townhouse with
// turret oriels. See street_house.rs for the house, and
// catalogue::items::street for the conventions and for what is declared
// ahead of these rules (Storeys, Trade, Frontage, Depth, GroundH, FloorH)
// and after them (Glazing, ShopGlazing, Wall, PaneCard, LitRoom, DarkRoom).

const WallD = 0.4
const PaneSet = 0.14
const PlinthH = 0.6
const StepH = 0.55
const JettyH = 0.28
const CrownH = 0.8
const RoofH = 1.0
// A turret: its slot along the front, how far its drum stands out of the
// wall's face and how deep it reaches behind it, so the drum fills its
// slot at the face and no wall is needed behind it.
const TurW = 2.4
const EdgeW = 0.5
const TurOut = 1.2
const TurIn = 1.1
const TurD = 2.3
const CorbelH = 0.75
const CapH = 4.4

// -- 1. The house: its daub rolled once, then storeys, crown, roof --
Lot --> Extrude(GroundH + FloorH * (Storeys - 1) + CrownH + RoofH) Daub
Daub --> 24% Mat("Cream") Massing | 20% Mat("Ochre") Massing | 20% Mat("Sage") Massing
    | 18% Mat("Rose") Massing | 18% Mat("Lilac") Massing
Massing --> Split(Y) { GroundH: Ground | ~1: Uppers | CrownH: Crown | RoofH: RoofZone }
// Party walls: the sides, the full depth, turning the corners.
PartyIn --> Translate(0, 0, -WallD) Wall

// -- 2. The ground storey: guild shops or homes, in stone --
Ground --> Mat("Stone") Comp(Faces) { Front: GroundFace | Back: RearGroundInset
    | Left: PartyIn | Right: PartyIn | Top: NIL | Bottom: NIL }
GroundFace --> Split(Y) { ~1: GroundFrontInset | JettyH: Jetty }
// A jetty beam the whole frontage at every floor, so a row's beams run on.
Jetty --> Extrude(0.28) Mat("Timber") I("Beam")
GroundFrontInset --> Split(X) { WallD: NIL | ~1: GroundFrontIn | WallD: NIL }
GroundFrontIn --> Translate(0, 0, -WallD) GroundFront
GroundFront --> when(Trade == 1): ShopFront | else: HomeFront
ShopFront --> Split(X) { ~1: ShopRun | 2.0: Entrance | ~1: ShopRun }
ShopRun --> Repeat(X, 3.4) { ShopBay }
// Each shop its own painted sign board over its window.
ShopBay --> Split(Y) { ~1: ShopBayLow | 0.62: SignBand | 0.2: Wall }
SignBand --> Split(X) { 0.35: Wall | ~1: Sign | 0.35: Wall }
Sign --> 34% Mat("SignRed") SignBoard | 33% Mat("SignBlue") SignBoard
    | 33% Mat("SignGreen") SignBoard
SignBoard --> Extrude(WallD + 0.1) I("Fascia")
ShopBayLow --> Split(X) { 0.45: Wall | ~1: ShopUnit | 0.45: Wall }
ShopUnit --> when(scope.x > 2.2): Split(X) { ~1: ShopWindow | 1.0: ShopDoor }
    | else: ShopWindow
ShopWindow --> Split(Y) { PlinthH: Plinth | ~1: ShopGlazing | 0.22: Lintel }
ShopDoor --> Split(Y) { StepH: Step | 2.2: DoorLeaf | ~1: Glazing | 0.22: Lintel }
Plinth --> Extrude(WallD + 0.06) Mat("Moss") I("Trim")
Lintel --> Extrude(WallD + 0.05) Mat("Timber") I("Beam")
DoorLeaf --> 60% Mat("Door") Leaf | 40% Mat("DoorBlue") Leaf
Leaf --> Extrude(WallD - 0.18) I("Door")
// A stone step, standing out of the wall: the sink buries all but its top.
Step --> Extrude(WallD + 0.3) Mat("Stone") I("Trim")
HomeFront --> Split(X) { ~1: HomeRun | 2.0: Entrance | ~1: HomeRun }
HomeRun --> Repeat(X, 2.6) { HomeBay }
HomeBay --> Split(X) { ~1: Wall | 1.2: HomeWindow | ~1: Wall }
HomeWindow --> Split(Y) { 1.3: Wall | 0.1: Sill | 1.9: Glazing | 0.22: Lintel | ~1: Wall }
Sill --> Extrude(WallD + 0.08) Mat("Timber") I("Trim")
// The house door: a plank leaf up a step, under a glowing rune.
Entrance --> Split(X) { 0.3: Wall | ~1: EntranceDoor | 0.3: Wall }
EntranceDoor --> Split(Y) { StepH: Step | 2.5: DoorLeaf | 0.22: Lintel | 0.5: RuneBand | ~1: Wall }
RuneBand --> Split(X) { ~1: Wall | 0.5: Rune | ~1: Wall }
Rune --> Extrude(WallD + 0.05) Mat("Rune") I("Trim")
RearGroundInset --> Split(X) { WallD: NIL | ~1: RearGroundIn | WallD: NIL }
RearGroundIn --> Translate(0, 0, -WallD) RearGround
RearGround --> Repeat(X, 2.8) { RearBay }
RearBay --> Split(X) { ~1: Wall | 1.1: RearWindow | ~1: Wall }
RearWindow --> Split(Y) { 1.45: Wall | 1.9: Glazing | ~1: Wall }

// -- 3. The upper storeys: jettied, timbered, with turret oriels --
Uppers --> Comp(Faces) { Front: UpperFront | Back: RearUpperInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
UpperFront --> Repeat(Y, FloorH) { StoreyFace }
// Two turrets, one or none, the same at every storey and at the crown.
StoreyFace --> Pick("turrets") { 40% TwinStorey(split.i) | 30% OneStorey(split.i)
    | 30% PlainStorey }
TwinStorey(f) --> Split(X) { EdgeW: EdgeA | TurW: TurretStorey(f) | ~1: MidStorey
    | TurW: TurretStorey(f) | EdgeW: EdgeB }
OneStorey(f) --> Split(X) { EdgeW: EdgeA | TurW: TurretStorey(f) | ~1: MidStorey
    | EdgeW: EdgeB }
PlainStorey --> Split(X) { EdgeW: EdgeA | ~1: MidStorey | EdgeW: EdgeB }
// The ends of a storey, beside the party walls.
EdgeA --> Split(Y) { JettyH: Jetty | ~1: EdgeAIn }
EdgeAIn --> Split(X) { WallD: NIL | ~1: InWall }
EdgeB --> Split(Y) { JettyH: Jetty | ~1: EdgeBIn }
EdgeBIn --> Split(X) { ~1: InWall | WallD: NIL }
InWall --> Translate(0, 0, -WallD) Wall
MidStorey --> Split(Y) { JettyH: Jetty | ~1: MidIn }
MidIn --> Translate(0, 0, -WallD) Repeat(X, 2.3) { Bay }
// A bay between two posts: a leaded window under a pointed hood.
Bay --> Split(X) { 0.12: Post | ~1: Wall | 1.1: WinCol | ~1: Wall | 0.12: Post }
Post --> Extrude(WallD + 0.08) Mat("Timber") I("Beam")
WinCol --> Split(Y) { 0.65: Wall | 0.1: Sill | 1.75: Glazing | 0.34: Hood | ~1: Wall }
Hood --> Extrude(WallD + 0.16) Taper(0.8) Mat("Timber") I("Trim")
// A turret's drum, a storey at a time, in stone: the first on a corbel of
// three rings, each a lancet window on its front.
TurretStorey(f) --> when(f == 0): Split(Y) { CorbelH: CorbelSlot | ~1: TurretSlot }
    | else: TurretSlot
TurretSlot --> Translate(0, 0, -TurIn) Extrude(TurD) Mat("Stone") Comp(Faces)
    { Front: Drum | Back: DrumFace | _: NIL }
Drum --> Translate(0, 0, -TurD) Extrude(TurD) I("Turret")
DrumFace --> Split(Y) { 0.8: NIL | 1.75: LancetRow | ~1: NIL }
// Held 2 cm off the drum, whose front facet may lie in the box's face.
LancetRow --> Split(X) { ~1: NIL | 0.7: Lancet | ~1: NIL }
Lancet --> 50% Translate(0, 0, 0.02) Extrude(0.12) Comp(Faces) { Back: PaneCard | Front: LitRoom | _: LancetFrame }
    | 50% Translate(0, 0, 0.02) Extrude(0.12) Comp(Faces) { Back: PaneCard | Front: DarkRoom | _: LancetFrame }
LancetFrame --> Mat("Timber") I("Trim")
// Under the corbel's rings the wall stands at its face; the rings stand
// out of it from the drum's own box.
CorbelSlot --> Translate(0, 0, -WallD) Extrude(WallD + TurOut) Comp(Faces)
    { Front: CorbelWall | Back: CorbelRings | _: NIL }
// Held clear of the rings' top and bottom, which would share its planes.
CorbelWall --> Split(Y) { 0.02: NIL | ~1: CorbelWallIn | 0.02: NIL }
CorbelWallIn --> Translate(0, 0, -WallD) Extrude(WallD) I("Wall")
CorbelRings --> Translate(0, 0, -TurD) Extrude(TurD) Mat("Stone")
    Split(Y) { 0.25: Ring(0.45) | 0.25: Ring(0.7) | ~1: Ring(0.9) }
Ring(k) --> Size(scope.x * k, scope.y, scope.z * k) Center(XZ) I("Turret")
RearUpperInset --> Split(X) { WallD: NIL | ~1: RearUpperIn | WallD: NIL }
RearUpperIn --> Translate(0, 0, -WallD) RearUpper
RearUpper --> Repeat(Y, FloorH) { RearStorey }
RearStorey --> Repeat(X, 2.8) { RearUpperBay }
RearUpperBay --> Split(X) { ~1: Wall | 1.1: RearUpperWindow | ~1: Wall }
RearUpperWindow --> Split(Y) { 0.9: Wall | 1.75: Glazing | ~1: Wall }

// -- 4. The crown: an eaves beam, and the drums' last courses under
// their slate cones --
Crown --> Comp(Faces) { Front: CrownFace | Back: RearCrownInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
CrownFace --> Pick("turrets") { 40% TwinCrown | 30% OneCrown | 30% PlainCrown }
TwinCrown --> Split(X) { EdgeW: Eaves | TurW: CrownTurret | ~1: Eaves | TurW: CrownTurret
    | EdgeW: Eaves }
OneCrown --> Split(X) { EdgeW: Eaves | TurW: CrownTurret | ~1: Eaves | EdgeW: Eaves }
PlainCrown --> Eaves
Eaves --> Split(Y) { 0.3: EaveBeam | ~1: EaveWall }
EaveBeam --> Extrude(0.34) Mat("Timber") I("Beam")
EaveWall --> Extrude(0.12) I("Wall")
// A sliver at the crown's top carries the cone, so one slot draws both.
CrownTurret --> Split(Y) { ~1: TurretSlot2 | 0.01: CapSlot }
TurretSlot2 --> Translate(0, 0, -TurIn) Extrude(TurD) Mat("Stone") I("Turret")
CapSlot --> Translate(-0.15, -0.01, -TurIn - 0.15) Size(scope.x + 0.3, CapH, 0)
    Extrude(TurD + 0.3) Pick("roofslate") { 60% BlueCap | 40% GreenCap }
BlueCap --> Mat("Slate") Cap
GreenCap --> Mat("SlateGreen") Cap
Cap --> Split(Y) { ~1: Cone | 0.7: Finial }
Cone --> Taper(1) I("Cap")
Finial --> Size(0.14, scope.y, 0.14) Center(XZ) Mat("Gold") I("Finial")
RearCrownInset --> Split(X) { WallD: NIL | ~1: RearCrownIn | WallD: NIL }
RearCrownIn --> Translate(0, 0, -WallD) Wall

// -- 5. The roof: steep slate, a gable to the street or along it --
// The roof's slate is Picked once with the cones', on the slopes alone:
// its gable ends stay in the house's daub.
RoofZone --> Pick("roof") { 55% StreetGable | 45% LongGable }
// A gable's height= is taken over half the depth, whichever way its ridge
// runs: scaled so the street gable rises 6.8 m over half the frontage.
StreetGable --> Roof(Gable, 45, overhang=0, ridge=Z, height=6.8 * Depth / Frontage)
    { Slope: Slates | GableEnd: Gable }
LongGable --> Roof(Gable, 50, overhang=0, ridge=X) { Slope: Slates | GableEnd: Gable }
Slates --> Pick("roofslate") { 60% BlueSlates | 40% GreenSlates }
BlueSlates --> Mat("Slate") I("Roof")
GreenSlates --> Mat("SlateGreen") I("Roof")
Gable --> I("Wall")
