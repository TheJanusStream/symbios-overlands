// The frontier theme's long block (#1598): a brick bank-and-hotel block.
// See street_block.rs for the block, and catalogue::items::street for the
// conventions and for what is declared ahead of these rules and after them.

const WallD = 0.45
const PaneSet = 0.16
const PlinthH = 0.7
const StepH = 0.55
const CourseH = 0.26
// The cornice and the attic over it; the name boards stand over that.
const ParapetH = 1.7
const NameH = 1.2
// One stair to a section, as a block is let: a door at street level, a
// column of landing windows over it, a name board on the parapet. Under
// twelve metres so the frontages, less the party walls, hold two, three
// and four of them: a Repeat floors its count.
const SectionW = 11.5

// -- 1. The block: its brick rolled once, then storeys, cornice, boards --
Lot --> Extrude(GroundH + FloorH * (Storeys - 1) + ParapetH + NameH) Brick
Brick --> 45% Mat("BrickRed") Massing | 30% Mat("BrickBuff") Massing
    | 25% Mat("BrickBrown") Massing
Massing --> Split(Y) { GroundH: Ground | ~1: Uppers | ParapetH: Parapet | NameH: NameZone }
// Party walls: the sides, the full depth, turning the corners.
PartyIn --> Translate(0, 0, -WallD) Wall
Stone --> Mat("Stone") I("Trim")

// -- 2. The ground storey: cast-iron shopfronts or offices, a sandstone
// course over them, a door to each stair --
Ground --> Comp(Faces) { Front: GroundFace | Back: RearGroundInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
GroundFace --> Split(Y) { ~1: GroundFrontInset | CourseH: Course }
Course --> Extrude(0.14) Stone
GroundFrontInset --> Split(X) { WallD: NIL | ~1: GroundFrontIn | WallD: NIL }
GroundFrontIn --> Translate(0, 0, -WallD) GroundFront
GroundFront --> Repeat(X, SectionW) { GroundSection }
GroundSection --> Split(X) { ~1: GroundRun | 2.6: Doorway | ~1: GroundRun }
GroundRun --> when(Trade == 1): ShopRun | else: OfficeRun
ShopRun --> Repeat(X, 4.2) { ShopBay }
// A shopfront between two cast-iron pilasters: glass on a plinth, an
// awning where the block has them, a sign band over it.
ShopBay --> Split(X) { 0.4: IronPier | ~1: ShopUnit | 0.4: IronPier }
IronPier --> Extrude(WallD + 0.1) Mat("Iron") I("Trim")
ShopUnit --> Split(Y) { PlinthH: Wall | ~1: ShopGlazing | 0.2: AwningBand | 0.7: ShopSign }
ShopSign --> Extrude(WallD + 0.06) Mat("Sign") I("Fascia")
AwningBand --> Pick("awnings") { 35% AwningTan | 30% AwningRed | 35% Wall }
AwningTan --> Mat("Awning") Awning
AwningRed --> Mat("AwningRed") Awning
Awning --> Extrude(WallD + 1.4) Split(Z) { ~1: AwningTop | 0.06: Valance }
AwningTop --> I("Canopy")
Valance --> Translate(0, -0.32, 0) Size(scope.x, 0.52, scope.z) I("Canopy")
OfficeRun --> Repeat(X, 2.2) { OfficeBay }
OfficeBay --> Split(X) { ~1: Wall | 1.2: OfficeWin | ~1: Wall }
OfficeWin --> Split(Y) { 1.1: Wall | 0.12: Sill | 2.3: Glazing | 0.3: Lintel | ~1: Wall }
Sill --> Extrude(WallD + 0.07) Stone
Lintel --> Extrude(WallD + 0.1) Stone
// The stair door: a tall leaf up a stone step, a fanlight over it.
Doorway --> Split(X) { 0.35: Wall | ~1: DoorCol | 0.35: Wall }
DoorCol --> Split(Y) { StepH: Step | 2.8: DoorLeaf | ~1: Fanlight }
Step --> Extrude(WallD + 0.35) Stone
DoorLeaf --> Extrude(WallD - 0.2) Mat("Door") I("Door")
Fanlight --> Split(Y) { ~1: Glazing | 0.3: Lintel }
// The yard side: windows over high sills.
RearGroundInset --> Split(X) { WallD: NIL | ~1: RearGroundIn | WallD: NIL }
RearGroundIn --> Translate(0, 0, -WallD) RearGround
RearGround --> Repeat(X, 3.0) { RearBay }
RearBay --> Split(X) { ~1: Wall | 1.2: RearWindow | ~1: Wall }
RearWindow --> Split(Y) { 1.4: Wall | 1.8: Glazing | ~1: Wall }

// -- 3. The storeys: a sill course, tall windows under sandstone lintels,
// a landing window on each section's axis --
Uppers --> Comp(Faces) { Front: UpperFrontInset | Back: RearUpperInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
UpperFrontInset --> Split(X) { WallD: NIL | ~1: UpperFrontIn | WallD: NIL }
UpperFrontIn --> Translate(0, 0, -WallD) UpperFront
UpperFront --> Repeat(Y, FloorH) { Storey }
Storey --> Split(Y) { 0.8: Wall | 0.14: SillCourse | ~1: WinRow }
SillCourse --> Extrude(WallD + 0.08) Stone
WinRow --> Repeat(X, SectionW) { Section }
Section --> Split(X) { ~1: Run | 2.0: StairCol | ~1: Run }
Run --> Repeat(X, 2.2) { WinBay }
WinBay --> Split(X) { ~1: Wall | 1.15: WinCol | ~1: Wall }
WinCol --> Split(Y) { 2.1: Glazing | 0.3: Lintel | ~1: Wall }
StairCol --> Split(X) { ~1: Wall | 0.9: StairWin | ~1: Wall }
StairWin --> Split(Y) { 0.3: Wall | 1.5: Glazing | 0.3: Lintel | ~1: Wall }
RearUpperInset --> Split(X) { WallD: NIL | ~1: RearUpperIn | WallD: NIL }
RearUpperIn --> Translate(0, 0, -WallD) RearUpper
RearUpper --> Repeat(Y, FloorH) { RearStorey }
RearStorey --> Repeat(X, 3.8) { RearUpperBay }
RearUpperBay --> Split(X) { ~1: Wall | 1.1: RearUpperWindow | ~1: Wall }
RearUpperWindow --> Split(Y) { 0.9: Wall | 1.8: Glazing | ~1: Wall }

// -- 4. The cornice on its brackets, the attic over it, the deck inside --
Parapet --> Comp(Faces) { Front: CorniceFace | Back: ParapetFace | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: Deck }
// Cut from the full face, so a row of copies shows one unbroken cornice.
CorniceFace --> Split(Y) { 0.24: Frieze | 0.26: Brackets | 0.2: Corona | ~1: ParapetFace }
Frieze --> Extrude(0.12) Mat("Cornice") I("Cornice")
Brackets --> Repeat(X, 1.2) { BracketBay }
BracketBay --> Split(X) { ~1: Frieze | 0.22: Bracket | ~1: Frieze }
Bracket --> Extrude(0.5) Mat("Cornice") I("Cornice")
Corona --> Extrude(0.62) Mat("Cornice") I("Cornice")
ParapetFace --> Split(Y) { ~1: ParapetInset | 0.14: Coping }
ParapetInset --> Split(X) { WallD: NIL | ~1: ParapetIn | WallD: NIL }
ParapetIn --> Translate(0, 0, -WallD) Wall
Coping --> Extrude(0.06) Stone
// The deck fills the ring inside the parapet's walls, so no face of it
// lies in theirs: the bottom face's inward is up.
Deck --> Translate(WallD, WallD, -0.2) Size(scope.x - 2 * WallD, scope.y - 2 * WallD, 0)
    Extrude(0.2) Mat("Deck") I("Roof")

// -- 5. A name board over each section, under a little pediment --
NameZone --> Comp(Faces) { Front: NameRow | Back: NIL | Left: NIL | Right: NIL | Top: NIL
    | Bottom: NIL }
NameRow --> Repeat(X, SectionW) { NameSection }
NameSection --> Split(X) { ~1: NIL | 4.4: NameBoard | ~1: NIL }
NameBoard --> Split(Y) { ~1: NamePanel | 0.01: NamePed }
NamePanel --> Split(X) { 0.25: NameFrame | ~1: NameMiddle | 0.25: NameFrame }
NameFrame --> Extrude(0.3) Mat("Cornice") I("Cornice")
NameMiddle --> Split(Y) { 0.18: NameFrame | ~1: NameGilt | 0.18: NameFrame }
NameGilt --> Extrude(0.24) Mat("Gilt") I("Fascia")
NamePed --> Extrude(0.3) Roof(Gable, 18, overhang=0, ridge=Z)
    { Slope: PedSlope | GableEnd: PedFace }
PedSlope --> Mat("Cornice") I("Cornice")
PedFace --> Mat("Cornice") I("Cornice")
