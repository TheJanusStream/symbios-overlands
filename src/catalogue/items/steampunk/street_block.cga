// The steampunk theme's long block (#1598): a foundry block. See
// street_block.rs for the block, and catalogue::items::street for the
// conventions and for what is declared ahead of these rules and after them.

const WallD = 0.44
const PaneSet = 0.16
const PlinthH = 0.7
const StepH = 0.5
const BandH = 0.22
const ParapetH = 1.1
const RoofH = 1.0
const PierW = 0.5
// One door to a section, a stack over it: under twelve metres so the
// steps' frontages, less the party walls, hold two, three and four.
const SectionW = 11.5
// The sawtooth's teeth, front to back.
const ToothD = 3.4

// -- 1. The works: its brick rolled once, then base, storeys, parapet --
Lot --> Extrude(GroundH + FloorH * (Storeys - 1) + ParapetH + RoofH) Brick
Brick --> 38% Mat("BrickSoot") Massing | 34% Mat("BrickRed") Massing
    | 28% Mat("BrickBrown") Massing
Massing --> Split(Y) { GroundH: Ground | ~1: Uppers | ParapetH: Parapet | RoofH: RoofZone }
// Party walls: the sides, the full depth, turning the corners.
PartyIn --> Translate(0, 0, -WallD) Wall
// A copper downpipe before each party wall's end, a centimetre off it.
PipeStrip --> Size(0.26, scope.y, 0) Center(X) Translate(0, 0, 0.01) Extrude(0.32)
    Mat("Copper") I("Pipe")

// -- 2. The base: dark engineering brick, an iron door to each section --
Ground --> Mat("Plinth") Comp(Faces) { Front: GroundFace | Back: RearGroundInset
    | Left: PartyIn | Right: PartyIn | Top: NIL | Bottom: NIL }
GroundFace --> Split(X) { WallD: PipeStrip | ~1: GroundMid | WallD: PipeStrip }
GroundMid --> Split(Y) { ~1: GroundFrontIn | BandH: FullBand }
FullBand --> Extrude(0.14) Mat("Iron") I("Band")
GroundFrontIn --> Translate(0, 0, -WallD) Repeat(X, SectionW) { GroundSection }
GroundSection --> Split(X) { ~1: GroundRun | 2.8: Doorway | ~1: GroundRun }
GroundRun --> when(Trade == 1): Repeat(X, 3.8) { ShowBay } | else: Repeat(X, 3.4) { BaseBay }
// A showroom between iron pilasters, its fascia under a brass rail.
ShowBay --> Split(X) { 0.3: Pilaster | ~1: ShowUnit | 0.3: Pilaster }
Pilaster --> Extrude(WallD + 0.1) Mat("Iron") I("Trim")
ShowUnit --> Split(Y) { PlinthH: Wall | ~1: ShopGlazing | 0.6: Fascia | 0.08: Rail | 0.2: Wall }
Fascia --> Extrude(WallD + 0.08) Mat("Sign") I("Fascia")
Rail --> Extrude(WallD + 0.12) Mat("Brass") I("Trim")
BaseBay --> Split(X) { PierW: Pier | ~1: BaseWindow }
BaseWindow --> Split(Y) { 1.1: Wall | 0.12: Sill | 2.0: Glazing | 0.3: Lintel | ~1: Wall }
// The works door: two iron leaves up a step, under an iron canopy, a
// fanlight over it.
Doorway --> Split(X) { 0.3: Wall | ~1: DoorCol | 0.3: Wall }
DoorCol --> Split(Y) { StepH: Step | 2.6: DoorLeaves | 0.2: Canopy | ~1: Glazing | 0.2: Wall }
DoorLeaves --> Split(X) { ~1: DoorLeaf | 0.06: Wall | ~1: DoorLeaf }
DoorLeaf --> Extrude(WallD - 0.2) Mat("Door") I("Door")
Step --> Extrude(WallD + 0.35) Mat("Iron") I("Trim")
Canopy --> Extrude(WallD + 1.3) Mat("Iron") I("Canopy")
RearGroundInset --> Split(X) { WallD: NIL | ~1: RearGroundIn | WallD: NIL }
RearGroundIn --> Translate(0, 0, -WallD) Repeat(X, 3.4) { RearBay }
RearBay --> Split(X) { ~1: Wall | 2.0: RearWindow | ~1: Wall }
RearWindow --> Split(Y) { 1.2: Wall | 1.8: Glazing | ~1: Wall }

// -- 3. The floors: brick piers between works windows, a riveted band at
// each floor, a stair's lights on each section's axis --
Uppers --> Comp(Faces) { Front: UpperFace | Back: RearUpperInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
UpperFace --> Split(X) { WallD: PipeStrip | ~1: UpperFrontIn | WallD: PipeStrip }
UpperFrontIn --> Translate(0, 0, -WallD) Repeat(Y, FloorH) { Storey }
Storey --> Split(Y) { BandH: Band | ~1: Floor }
Band --> Extrude(WallD + 0.12) Mat("Iron") I("Band")
Floor --> Repeat(X, SectionW) { Section }
Section --> Split(X) { ~1: Run | 2.8: StairCol | ~1: Run }
Run --> Repeat(X, 3.4) { Bay }
Bay --> Split(X) { PierW: Pier | ~1: WorksWindow }
Pier --> Extrude(WallD + 0.2) I("Pier")
// A works window: wide, many-paned, on an iron sill under an iron lintel.
WorksWindow --> Split(Y) { 0.6: Wall | 0.12: Sill | ~1: Glazing | 0.3: Lintel | 0.2: Wall }
Sill --> Extrude(WallD + 0.08) Mat("Iron") I("Trim")
Lintel --> Split(X) { ~1: IronLintel | 0.3: Keystone | ~1: IronLintel }
IronLintel --> Extrude(WallD + 0.1) Mat("Iron") I("Trim")
Keystone --> Extrude(WallD + 0.16) Mat("Brass") I("Trim")
StairCol --> Split(X) { PierW: Pier | ~1: Wall | 1.0: StairWin | ~1: Wall | PierW: Pier }
StairWin --> Split(Y) { ~1: Wall | 1.4: Glazing | 0.3: Lintel | 0.25: Wall }
RearUpperInset --> Split(X) { WallD: NIL | ~1: RearUpperIn | WallD: NIL }
RearUpperIn --> Translate(0, 0, -WallD) Repeat(Y, FloorH) { RearStorey }
RearStorey --> Repeat(X, 3.4) { RearUpperBay }
RearUpperBay --> Split(X) { ~1: Wall | 2.0: RearUpperWindow | ~1: Wall }
RearUpperWindow --> Split(Y) { 0.8: Wall | 1.8: Glazing | ~1: Wall }

// -- 4. The parapet, its iron coping, and the deck inside it --
Parapet --> Comp(Faces) { Front: ParapetFront | Back: ParapetFace | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: Deck }
ParapetFront --> Split(X) { WallD: PipeStrip | ~1: ParapetFrontMid | WallD: PipeStrip }
ParapetFrontMid --> Split(Y) { ~1: ParapetIn | 0.16: Coping }
ParapetFace --> Split(Y) { ~1: ParapetInset | 0.16: Coping }
ParapetInset --> Split(X) { WallD: NIL | ~1: ParapetIn | WallD: NIL }
ParapetIn --> Translate(0, 0, -WallD) Wall
Coping --> Extrude(0.08) Mat("Iron") I("Trim")
// The deck fills the ring inside the parapet's walls, 2 cm clear of its
// foot: the bottom face's inward is up.
Deck --> Translate(WallD, WallD, -0.22) Size(scope.x - 2 * WallD, scope.y - 2 * WallD, 0)
    Extrude(0.2) Mat("Deck") I("Roof")

// -- 5. The roof: a sawtooth of sheds, their amber northlights to the
// back, and a sliver at the zone's top that stands a brick stack over
// each section's door --
RoofZone --> Split(Y) { ~1: Sawtooth | 0.01: StackLayer }
Sawtooth --> Repeat(Z, ToothD) { Tooth }
Tooth --> Roof(Shed, 26, overhang=0) { Slope: Sheeting | Back: NorthLight | GableEnd: Gable }
Sheeting --> Mat("Sheet") I("Roof")
NorthLight --> Mat("NorthLight") I("Roof")
Gable --> I("Wall")
StackLayer --> Translate(0, 0.01 - RoofH, 0) Size(scope.x, 7.6, scope.z)
    Split(X) { WallD: NIL | ~1: StackRow | WallD: NIL }
StackRow --> Repeat(X, SectionW) { StackSection }
StackSection --> Split(X) { ~1: NIL | 2.0: StackCol | ~1: NIL }
StackCol --> Split(Z) { ~1: NIL | 2.0: Stack | ~1: NIL }
// A round brick stack tapering as it rises, collared in iron at its head,
// its mouth aglow.
Stack --> Split(Y) { ~1: StackShaft | 0.45: StackCollar | 0.25: StackMouth }
StackShaft --> Taper(0.3) I("Stack")
StackCollar --> Size(scope.x * 0.7 + 0.2, scope.y, scope.z * 0.7 + 0.2) Center(XZ) Mat("Iron")
    I("Stack")
StackMouth --> Size(scope.x * 0.6, scope.y, scope.z * 0.6) Center(XZ) Mat("Furnace") I("Stack")
