// The monolith's long block (#1598): a long black slab of obsidian. See
// street_block.rs for the block, and catalogue::items::street for the
// conventions and for what is declared ahead of these rules and after them.

const WallD = 0.45
const PaneSet = 0.3
const PlinthH = 0.6
const StepH = 0.55
const GlyphH = 0.12
const ParapetH = 1.0
const CapH = 5.0
// One portal to a section, as a slab is built: a portal at street level,
// a glyph spine climbing over it, an obelisk on the roof. Under twelve
// metres so the steps' frontages, less the party walls, hold two, three
// and four of them: a Repeat floors its count.
const SectionW = 11.5

// -- 1. The slab: its stone rolled once, then plinth, storeys, parapet --
Lot --> Extrude(GroundH + FloorH * (Storeys - 1) + ParapetH + CapH) Stone
Stone --> 35% Mat("Obsidian") Massing | 25% Mat("ObsidianBlue") Massing
    | 25% Mat("ObsidianViolet") Massing | 15% Mat("Basalt") Massing
Massing --> Split(Y) { GroundH: Ground | ~1: Uppers | ParapetH: Parapet | CapH: RoofTop }
// Party walls: the sides, the full depth, turning the corners.
PartyIn --> Translate(0, 0, -WallD) Wall
// The slab's one glyph colour, for its lines and strokes.
GlyphLine --> Pick("glyph") { 65% LineCyan | 35% LineViolet }
LineCyan --> Extrude(WallD + 0.05) Mat("Glyph") I("Trim")
LineViolet --> Extrude(WallD + 0.05) Mat("GlyphViolet") I("Trim")
Fin --> Extrude(WallD + 0.4) Mat("Fin") I("Fin")
Slit --> Split(Y) { 0.45: Wall | 2.15: Glazing | ~1: Wall }

// -- 2. The plinth: basalt under a glyph line, a portal a section --
Ground --> Mat("Base") Comp(Faces) { Front: GroundFrontInset | Back: RearGroundInset
    | Left: PartyIn | Right: PartyIn | Top: NIL | Bottom: NIL }
GroundFrontInset --> Split(X) { WallD: NIL | ~1: GroundFrontIn | WallD: NIL }
GroundFrontIn --> Translate(0, 0, -WallD) Split(Y) { ~1: GroundFront | GlyphH: GlyphLine }
GroundFront --> Repeat(X, SectionW) { GroundSection }
GroundSection --> Split(X) { ~1: GroundRun | 2.8: Portal | ~1: GroundRun }
GroundRun --> when(Trade == 1): LightRun | else: SlitRun
LightRun --> Repeat(X, 4.2) { LightBay }
LightBay --> Split(X) { 0.45: Fin | ~1: LightWin }
LightWin --> Split(Y) { PlinthH: Wall | ~1: ShopGlazing | 0.5: GlyphSign }
GlyphSign --> Extrude(WallD + 0.04) Mat("Energy") I("Fascia")
SlitRun --> Repeat(X, 2.2) { SlitBay }
SlitBay --> Split(X) { ~1: Wall | 0.6: GroundSlit | ~1: Wall }
GroundSlit --> Split(Y) { 1.0: Wall | 2.2: Glazing | ~1: Wall }
// The portal: a dark leaf deep in its frame, up a step, under a glowing
// lintel and a stone canopy.
Portal --> Split(X) { 0.3: Wall | 0.3: Fin | ~1: PortalCol | 0.3: Fin | 0.3: Wall }
PortalCol --> Split(Y) { StepH: Step | 2.6: PortalLeaf | 0.16: Lintel | 0.3: Canopy | ~1: Wall }
Step --> Extrude(WallD + 0.4) Mat("Step") I("Trim")
PortalLeaf --> Extrude(WallD - 0.3) Mat("Portal") I("Door")
Lintel --> Extrude(WallD + 0.06) Mat("Energy") I("Trim")
Canopy --> Extrude(WallD + 1.2) Mat("Fin") I("Canopy")
// The back: slits over high sills.
RearGroundInset --> Split(X) { WallD: NIL | ~1: RearGroundIn | WallD: NIL }
RearGroundIn --> Translate(0, 0, -WallD) RearGround
RearGround --> Repeat(X, 3.6) { RearBay }
RearBay --> Split(X) { ~1: Wall | 0.6: RearSlit | ~1: Wall }
RearSlit --> Split(Y) { 1.2: Wall | 1.8: Glazing | ~1: Wall }

// -- 3. The storeys: a glyph line at each floor, pairs of slits, the glyph
// spine on each section's axis between two fins, and deep blades at the
// ends of its runs where the slab has them --
Uppers --> Comp(Faces) { Front: UpperFrontInset | Back: RearUpperInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
UpperFrontInset --> Split(X) { WallD: NIL | ~1: UpperFrontIn | WallD: NIL }
UpperFrontIn --> Translate(0, 0, -WallD) UpperFront
UpperFront --> Repeat(Y, FloorH) { Storey }
Storey --> Split(Y) { ~1: Band | GlyphH: GlyphLine }
Band --> Repeat(X, SectionW) { Section }
Section --> Split(X) { ~1: Run | 2.6: Spine | ~1: Run }
Run --> when(split.i == 0): Split(X) { 0.5: OuterFin | ~1: RunBody }
    | else: Split(X) { ~1: RunBody | 0.5: OuterFin }
OuterFin --> Pick("blades") { 50% Blade | 50% Wall }
Blade --> Extrude(WallD + 1.2) Mat("Fin") I("Fin")
RunBody --> Split(X) { ~1: Wall | 0.55: Slit | 0.5: Wall | 0.55: Slit | ~1: Wall }
// The spine: a glyph stroke the band's height between two slits, a fin
// either side; stacked, the strokes climb the slab.
Spine --> Split(X) { 0.4: Fin | ~1: Wall | 0.5: Slit | 0.16: SpineStroke | 0.5: Slit | ~1: Wall
    | 0.4: Fin }
SpineStroke --> Pick("glyph") { 65% StrokeCyan | 35% StrokeViolet }
StrokeCyan --> Extrude(WallD + 0.04) Mat("Glyph") I("Trim")
StrokeViolet --> Extrude(WallD + 0.04) Mat("GlyphViolet") I("Trim")
RearUpperInset --> Split(X) { WallD: NIL | ~1: RearUpperIn | WallD: NIL }
RearUpperIn --> Translate(0, 0, -WallD) RearUpper
RearUpper --> Repeat(Y, FloorH) { RearStorey }
RearStorey --> Split(Y) { ~1: RearBand | GlyphH: GlyphLine }
RearBand --> Repeat(X, 6.0) { RearUpperBay }
RearUpperBay --> Split(X) { ~1: Wall | 0.6: RearUpperSlit | ~1: Wall }
RearUpperSlit --> Split(Y) { 0.5: Wall | 2.0: Glazing | ~1: Wall }

// -- 4. The parapet, its glowing coping, and the deck inside it --
Parapet --> Comp(Faces) { Front: ParapetFace | Back: ParapetFace | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: Deck }
ParapetFace --> Split(Y) { ~1: ParapetInset | 0.16: Coping }
ParapetInset --> Split(X) { WallD: NIL | ~1: ParapetIn | WallD: NIL }
ParapetIn --> Translate(0, 0, -WallD) Wall
Coping --> Extrude(0.08) Mat("Fin") I("Cornice")
// The deck fills the ring inside the parapet's walls, so no face of it
// lies in theirs: the bottom face's inward is up.
Deck --> Translate(WallD, WallD, -0.2) Size(scope.x - 2 * WallD, scope.y - 2 * WallD, 0)
    Extrude(0.2) Mat("Deck") I("Roof")

// -- 5. Over each spine, set down to the deck: an obelisk or a capstone --
RoofTop --> Repeat(X, SectionW) { RoofSection }
RoofSection --> Split(X) { ~1: NIL | 2.4: CapSlot | ~1: NIL }
CapSlot --> Split(Z) { ~1: NIL | 2.4: Cap | ~1: NIL }
Cap --> Translate(0, 0.2 - ParapetH, 0) Size(scope.x, ParapetH - 0.2 + CapH, scope.z) CapKind
CapKind --> Pick("caps") { 60% Obelisk | 40% Capstone }
Obelisk --> Split(Y) { ~1: ObeliskShaft | 0.25: ObeliskBand | 1.2: ObeliskTip }
ObeliskShaft --> Taper(0.25) I("Cap")
ObeliskBand --> Split(X) { ~0.125: NIL | ~0.75: ObeliskBandX | ~0.125: NIL }
ObeliskBandX --> Split(Z) { ~0.125: NIL | ~0.75: ObeliskGlow | ~0.125: NIL }
ObeliskGlow --> Mat("Energy") I("Trim")
ObeliskTip --> Split(X) { ~0.125: NIL | ~0.75: ObeliskTipX | ~0.125: NIL }
ObeliskTipX --> Split(Z) { ~0.125: NIL | ~0.75: ObeliskPoint | ~0.125: NIL }
ObeliskPoint --> Taper(1) I("Cap")
Capstone --> Split(Y) { ParapetH - 0.2 + 1.4: CapBlock | 0.16: CapGlow | ~1: NIL }
CapBlock --> I("Cap")
CapGlow --> Mat("Energy") I("Trim")
