// The Edo theme's low building (#1598): a machiya of one or two storeys.
// See street_low.rs for the building, and catalogue::items::street for the
// conventions and for what is declared ahead of these rules and after them.

const WallD = 0.3
const PaneSet = 0.1
const PlinthH = 0.5
const StepH = 0.5
const RoofH = 1.0
const PostW = 0.2
const EaveOut = 1.2
const EaveDrop = 0.56
const EaveClear = 0.8
// A household's width along the street: a lot holds as many as fit, each
// its own door.
const HouseW = 6.0

// -- 1. The machiya: its plaster rolled once; a centimetre's layer at its
// front carries the pent eave, the body behind it the storeys and roof --
Lot --> Extrude(GroundH + FloorH * (Storeys - 1) + RoofH) Plaster
Plaster --> 46% Mat("Plaster") Massing | 30% Mat("Earth") Massing | 24% Mat("Ash") Massing
Massing --> Split(Z) { 0.01: FrontLayer | ~1: Body }
Body --> when(Storeys == 1): Split(Y) { GroundH: Ground | RoofH: RoofZone }
    | else: Split(Y) { GroundH: Ground | ~1: Loft | RoofH: RoofZone }
// Party walls: the sides, the full depth, turning the corners.
PartyIn --> Translate(0, 0, -WallD) Wall
Post --> Extrude(WallD + 0.06) Pick("lattice") { 60% DarkPost | 40% RedPost }
DarkPost --> Mat("TimberDark") I("Post")
RedPost --> Mat("Bengara") I("Post")
Rail --> Extrude(WallD + 0.03) Mat("TimberDark") I("Trim")

// -- 2. The ground storey: shops under noren, or lattice homes --
Ground --> Comp(Faces) { Front: GroundFrontInset | Back: RearGroundInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
GroundFrontInset --> Split(X) { WallD: NIL | ~1: GroundFrontIn | WallD: NIL }
GroundFrontIn --> Translate(0, 0, -WallD) Repeat(X, HouseW) { Household }
Household --> when(Trade == 1): Split(X) { PostW: Post | ~1: ShopRun | 1.9: Entry }
    | else: Split(X) { PostW: Post | ~1: LatticeRun | 1.9: Entry }
ShopRun --> Repeat(X, 2.6) { ShopBay }
ShopBay --> Split(X) { ~1: ShopUnit | 0.16: Post }
ShopUnit --> Split(Y) { PlinthH: Sill | ~1: ShopGlazing | 0.8: Noren | EaveClear: Wall }
Sill --> Extrude(WallD + 0.05) Mat("Stone") I("Trim")
Noren --> 40% Mat("Indigo") Cloth | 30% Mat("Madder") Cloth | 30% Mat("Undyed") Cloth
Cloth --> Extrude(WallD + 0.04) I("Noren")
LatticeRun --> Repeat(X, 2.0) { LatticeBay }
LatticeBay --> Split(X) { ~1: LatticeUnit | 0.16: Post }
LatticeUnit --> Split(Y) { PlinthH: Sill | 0.3: Wall | 0.08: Rail | ~1: Glazing | 0.08: Rail
    | EaveClear: Wall }
// The entry: a sliding plank door up a step, a paper lantern hung on a
// post beside it.
Entry --> Split(X) { ~1: EntryDoor | PostW: LanternPost }
EntryDoor --> Split(Y) { StepH: Step | 2.0: DoorLeaf | 0.08: Rail | ~1: Wall }
Step --> Extrude(WallD + 0.3) Mat("Stone") I("Trim")
DoorLeaf --> Extrude(WallD - 0.12) Mat("Timber") I("Door")
// A sliver at the post's top carries its lantern, so one post draws both.
LanternPost --> Split(Y) { ~1: Post | 0.01: LanternSliver }
LanternSliver --> Translate(-0.16, -1.55, WallD + 0.06) Size(0.52, 0.7, 0) Extrude(0.52)
    Mat("Lantern") I("Lantern")
RearGroundInset --> Split(X) { WallD: NIL | ~1: RearGroundIn | WallD: NIL }
RearGroundIn --> Translate(0, 0, -WallD) Repeat(X, 2.8) { RearBay }
RearBay --> Split(X) { ~1: Wall | 1.2: RearWindow | ~1: Wall }
RearWindow --> Split(Y) { 1.0: Wall | 1.3: Glazing | ~1: Wall }

// -- 3. The loft: the low mushiko storey, barred windows in plaster --
Loft --> Comp(Faces) { Front: LoftInset | Back: LoftRearInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
LoftInset --> Split(X) { WallD: NIL | ~1: LoftIn | WallD: NIL }
LoftIn --> Translate(0, 0, -WallD) Repeat(X, 2.0) { LoftBay }
LoftBay --> Split(X) { ~1: Wall | 1.2: Mushiko | ~1: Wall }
Mushiko --> Split(Y) { 0.55: Wall | 0.12: Jamb | ~1: Glazing | 0.12: Jamb | 0.5: Wall }
Jamb --> Extrude(WallD + 0.06) I("Trim")
LoftRearInset --> Split(X) { WallD: NIL | ~1: LoftRearIn | WallD: NIL }
LoftRearIn --> Translate(0, 0, -WallD) Repeat(X, 2.8) { LoftRearBay }
LoftRearBay --> Split(X) { ~1: Wall | 1.1: LoftRearWindow | ~1: Wall }
LoftRearWindow --> Split(Y) { 0.7: Wall | 1.0: Glazing | ~1: Wall }

// -- 4. The front layer: a tiled pent eave over the ground storey --
FrontLayer --> Split(Y) { GroundH: Eave | ~1: NIL }
// The eave: a shed of tiles from a sliver of the storey's top, its high
// edge at the wall, a timber fascia under its low one.
Eave --> Translate(0, scope.y - EaveDrop, -EaveOut) Size(scope.x, 0.2, EaveOut + 0.01)
    Roof(Shed, 25, overhang=0, fascia=0.14) { Slope: EaveTiles | Fascia: EaveFascia
    | GableEnd: EaveEnd | Back: NIL }
EaveTiles --> Mat("Tile") I("Eave")
EaveFascia --> Mat("TimberDark") I("Fascia")
EaveEnd --> Mat("TimberDark") I("Eave")

// -- 5. The roof: a tiled gable along the street, its ends the party walls --
RoofZone --> Roof(Gable, 27, overhang=0, ridge=X) { Slope: Tiles | GableEnd: Gable }
Tiles --> Mat("Tile") I("Roof")
Gable --> I("Wall")
