// The Edo theme's long block (#1598): a merchant-row block of shop-houses
// and storehouses stacked under a tiled eave at every storey. See
// street_block.rs for the block, and catalogue::items::street for the
// conventions and for what is declared ahead of these rules and after them.

const WallD = 0.34
const PaneSet = 0.1
const PlinthH = 0.5
const StepH = 0.5
const RoofH = 1.0
const PostW = 0.18
const SkirtH = 1.15
const EaveOut = 1.2
const EaveDrop = 0.56
const EaveClear = 0.8
// A shop-house to a section: under twelve metres so the steps' frontages,
// less the party walls, hold two, three and four of them.
const SectionW = 11.5
const PierW = 0.55

// -- 1. The range: its plaster rolled once; a centimetre's layer at its
// front carries the eaves, the body behind it the storeys and the roof --
Lot --> Extrude(GroundH + FloorH * (Storeys - 1) + RoofH) Plaster
Plaster --> 50% Mat("Plaster") Massing | 26% Mat("Earth") Massing | 24% Mat("Ash") Massing
Massing --> Split(Z) { 0.01: FrontLayer | ~1: Body }
Body --> Split(Y) { GroundH: Ground | ~1: Uppers | RoofH: RoofZone }
// Party walls: the sides, the full depth, turning the corners.
PartyIn --> Translate(0, 0, -WallD) Wall
Post --> Extrude(WallD + 0.05) Mat("TimberDark") I("Post")
// A fire-wall pier between two shop-houses: plaster standing out of the
// front, the eaves running on over it.
FirePier --> Extrude(WallD + 0.3) I("Firewall")
SkirtWall --> Split(Y) { SkirtH: Namako | ~1: Wall }
Namako --> Extrude(WallD + 0.03) Mat("Namako") I("Wall")

// -- 2. The ground storey: a namako skirt, and to each section a door
// with its lanterns and shops under noren or barred windows --
Ground --> Comp(Faces) { Front: GroundFrontInset | Back: RearGroundInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
GroundFrontInset --> Split(X) { WallD: NIL | ~1: GroundFrontIn | WallD: NIL }
GroundFrontIn --> Translate(0, 0, -WallD) Repeat(X, SectionW) { GroundSection }
GroundSection --> Split(X) { PierW: FirePier | ~1: GroundRun | 2.2: Entry | ~1: GroundRun }
GroundRun --> when(Trade == 1): Repeat(X, 2.8) { ShopBay } | else: Repeat(X, 2.4) { BarBay }
ShopBay --> Split(X) { PostW: Post | ~1: ShopUnit }
ShopUnit --> Split(Y) { PlinthH: Sill | ~1: ShopGlazing | 0.8: Noren | EaveClear: Wall }
Sill --> Extrude(WallD + 0.05) Mat("Stone") I("Trim")
Noren --> 40% Mat("Indigo") Cloth | 30% Mat("Madder") Cloth | 30% Mat("Undyed") Cloth
Cloth --> Extrude(WallD + 0.04) I("Noren")
BarBay --> Split(X) { ~1: SkirtWall | 1.2: BarCol | ~1: SkirtWall }
BarCol --> Split(Y) { SkirtH: Namako | ~1: KuraWindow | EaveClear: Wall }
// A storehouse window: barred lattice between thick plaster jambs.
KuraWindow --> Split(X) { 0.16: Jamb | ~1: Glazing | 0.16: Jamb }
Jamb --> Extrude(WallD + 0.1) I("Trim")
// The door: a sliding plank door up a step, a lantern hung each side.
Entry --> Split(X) { PostW: LanternPost | ~1: EntryDoor | PostW: LanternPost }
EntryDoor --> Split(Y) { StepH: Step | 2.2: DoorLeaf | ~1: Wall }
Step --> Extrude(WallD + 0.3) Mat("Stone") I("Trim")
DoorLeaf --> Extrude(WallD - 0.12) Mat("Timber") I("Door")
// A sliver at the post's top carries its lantern, so one post draws both.
LanternPost --> Split(Y) { ~1: Post | 0.01: LanternSliver }
LanternSliver --> Translate(-0.17, -1.6, WallD + 0.05) Size(0.52, 0.72, 0) Extrude(0.52)
    Mat("Lantern") I("Lantern")
RearGroundInset --> Split(X) { WallD: NIL | ~1: RearGroundIn | WallD: NIL }
RearGroundIn --> Translate(0, 0, -WallD) Repeat(X, 4.0) { RearBay }
RearBay --> Split(X) { ~1: SkirtWall | 1.2: RearCol | ~1: SkirtWall }
RearCol --> Split(Y) { SkirtH: Namako | ~1: Glazing | 0.8: Wall }

// -- 3. The storehouse storeys: framed barred windows between the fire
// piers --
Uppers --> Comp(Faces) { Front: UpperFrontInset | Back: RearUpperInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
UpperFrontInset --> Split(X) { WallD: NIL | ~1: UpperFrontIn | WallD: NIL }
UpperFrontIn --> Translate(0, 0, -WallD) Repeat(Y, FloorH) { Storey }
Storey --> Repeat(X, SectionW) { Section }
Section --> Split(X) { PierW: FirePier | ~1: Run }
// Each storey on a wainscot of dark boards, the plaster over it.
Run --> Split(Y) { 0.7: Wainscot | ~1: RunMain }
Wainscot --> Extrude(WallD + 0.03) Mat("TimberDark") I("Wall")
RunMain --> Repeat(X, 3.4) { Bay }
Bay --> Split(X) { ~1: Wall | 1.6: WinCol | ~1: Wall }
WinCol --> Split(Y) { ~1: KuraWindow | EaveClear: Wall }
RearUpperInset --> Split(X) { WallD: NIL | ~1: RearUpperIn | WallD: NIL }
RearUpperIn --> Translate(0, 0, -WallD) Repeat(Y, FloorH) { RearStorey }
RearStorey --> Repeat(X, 4.0) { RearUpperBay }
RearUpperBay --> Split(X) { ~1: Wall | 1.1: RearUpperWindow | ~1: Wall }
RearUpperWindow --> Split(Y) { 0.8: Wall | 1.3: Glazing | ~1: Wall }

// -- 4. The front layer: a tiled pent eave over every storey --
FrontLayer --> Split(Y) { GroundH: Eave | ~1: UpperEaves | RoofH: NIL }
UpperEaves --> Repeat(Y, FloorH) { Eave }
// The eave: a shed of tiles from a sliver of the storey's top, its high
// edge at the wall, a timber fascia under its low one.
Eave --> Translate(0, scope.y - EaveDrop, -EaveOut) Size(scope.x, 0.2, EaveOut + 0.01)
    Roof(Shed, 25, overhang=0, fascia=0.14) { Slope: EaveTiles | Fascia: EaveFascia
    | GableEnd: EaveEnd | Back: NIL }
EaveTiles --> Mat("Tile") I("Eave")
EaveFascia --> Mat("TimberDark") I("Fascia")
EaveEnd --> Mat("TimberDark") I("Eave")

// -- 5. The roof: a long tiled gable along the street, its ends the party
// walls --
RoofZone --> Roof(Gable, 28, overhang=0, ridge=X) { Slope: Tiles | GableEnd: Gable }
Tiles --> Mat("Tile") I("Roof")
Gable --> I("Wall")
