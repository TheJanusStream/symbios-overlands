// The civic campus's long block (#1598): a modernist lecture block behind a
// screen of concrete fins. See street_block.rs for the block, and
// catalogue::items::street for the conventions and for what is declared ahead
// of these rules and after them.

const WallD = 0.4
const PaneSet = 0.16
const StepH = 0.5
const CanopyH = 0.35
const AtticH = 2.0
const PlantH = 4.0
// The fins: how far apart, how wide, how far they stand out.
const FinBay = 1.8
const FinW = 0.25
const FinOut = 0.7
// One entrance to a section: under twelve metres so the frontages, less
// the party walls, hold two, three and four of them.
const SectionW = 11.5

// -- 1. The block: its panels rolled once, then storeys, attic, plant --
Lot --> Extrude(GroundH + FloorH * (Storeys - 1) + AtticH + PlantH) Panels
Panels --> 40% Mat("PanelBrick") Massing | 30% Mat("PanelStone") Massing
    | 30% Mat("PanelConcrete") Massing
Massing --> Split(Y) { GroundH: Ground | ~1: Uppers | AtticH: Attic | PlantH: RoofTop }
// Party walls: the sides, the full depth, turning the corners.
PartyIn --> Translate(0, 0, -WallD) Wall
// A white concrete fin, standing out of the front.
Fin --> Mat("White") Extrude(WallD + FinOut) I("Fin")

// -- 2. The lobby storey: glazed, an entrance to each section, under a
// long canopy on round columns --
Ground --> Comp(Faces) { Front: GroundFrontInset | Back: RearGroundInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
GroundFrontInset --> Split(X) { WallD: NIL | ~1: GroundFrontIn | WallD: NIL }
GroundFrontIn --> Translate(0, 0, -WallD) Mat("Base") GroundFront
GroundFront --> Split(Y) { ~1: GroundLevel | CanopyH: Canopy }
Canopy --> Extrude(WallD + 1.9) Mat("White") I("Canopy")
GroundLevel --> Extrude(WallD + 1.9) Split(Z) { WallD: GroundSlab | ~1: Colonnade }
GroundSlab --> Comp(Faces) { Back: GroundFace | Front: NIL | Left: NIL | Right: NIL | Top: NIL
    | Bottom: NIL }
GroundFace --> Translate(0, 0, -WallD) Lobby
// The canopy's columns, near its edge.
Colonnade --> Split(Z) { ~1: NIL | 0.45: ColumnLine | 0.15: NIL }
ColumnLine --> Repeat(X, 3.8) { ColumnBay }
ColumnBay --> Split(X) { ~1: NIL | 0.45: Column | ~1: NIL }
Column --> Mat("White") I("Column")
Lobby --> Repeat(X, SectionW) { Section }
Section --> Split(X) { ~1: GroundRun | 3.0: Entrance | ~1: GroundRun }
Entrance --> Split(Y) { StepH: Step | 2.6: Doors | ~1: Glazing }
Step --> Extrude(WallD + 0.35) Mat("Base") I("Trim")
Doors --> Split(X) { 0.25: Wall | ~1: DoorLeaf | 0.1: Wall | ~1: DoorLeaf | 0.25: Wall }
DoorLeaf --> Extrude(WallD - 0.16) Mat("Door") I("Door")
GroundRun --> when(Trade == 1): ShopRun | else: LobbyRun
LobbyRun --> Split(X) { ~1: LobbyBays | 0.12: Mullion }
LobbyBays --> Repeat(X, 1.6) { LobbyBay }
LobbyBay --> Split(X) { 0.12: Mullion | ~1: LobbyGlass }
LobbyGlass --> Split(Y) { 0.5: Wall | ~1: Glazing }
Mullion --> Extrude(WallD - 0.1) Mat("Steel") I("Trim")
// A campus bookshop or cafe: windows on a plinth, a door, a sign band.
ShopRun --> Split(Y) { ~1: ShopLevel | 0.6: SignBand | 0.2: Wall }
ShopLevel --> Repeat(X, 3.2) { ShopBay }
ShopBay --> Split(X) { 0.2: Wall | ~1: ShopUnit | 0.2: Wall }
ShopUnit --> when(scope.x > 2.4): Split(X) { ~1: ShopWindow | 1.0: ShopDoor } | else: ShopWindow
ShopWindow --> Split(Y) { 0.55: Wall | ~1: ShopGlazing }
ShopDoor --> Split(Y) { StepH: Step | 2.3: DoorLeaf | ~1: Wall }
SignBand --> Extrude(WallD + 0.08) Mat("Fascia") I("Fascia")
RearGroundInset --> Split(X) { WallD: NIL | ~1: RearGroundIn | WallD: NIL }
RearGroundIn --> Translate(0, 0, -WallD) RearGround
RearGround --> Repeat(X, 3.6) { RearBay }
RearBay --> Split(X) { ~1: Wall | 2.0: RearWindow | ~1: Wall }
RearWindow --> Split(Y) { 1.0: Wall | 2.2: Glazing | ~1: Wall }

// -- 3. The storeys: a screen of fins the full height, and between each
// pair a window over a panel in every storey --
Uppers --> Comp(Faces) { Front: UpperFrontInset | Back: RearUpperInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
UpperFrontInset --> Split(X) { WallD: NIL | ~1: UpperFrontIn | WallD: NIL }
UpperFrontIn --> Translate(0, 0, -WallD) UpperFront
UpperFront --> Split(X) { 0.9: EndFin | ~1: FinRun | 0.9: EndFin }
EndFin --> Mat("White") Extrude(WallD + 0.2) I("Fin")
FinRun --> Repeat(X, FinBay) { FinBayCol }
FinBayCol --> when(split.i == split.n - 1): WinStack | else: Split(X) { ~1: WinStack | FinW: Fin }
WinStack --> Repeat(Y, FloorH) { FinWindow }
FinWindow --> Split(Y) { 1.0: Wall | ~1: Glazing | 0.3: Wall }
RearUpperInset --> Split(X) { WallD: NIL | ~1: RearUpperIn | WallD: NIL }
RearUpperIn --> Translate(0, 0, -WallD) RearUpper
RearUpper --> Repeat(Y, FloorH) { RearStorey }
RearStorey --> Repeat(X, 3.6) { RearUpperBay }
RearUpperBay --> Split(X) { ~1: Wall | 2.0: RearUpperWindow | ~1: Wall }
RearUpperWindow --> Split(Y) { 1.0: Wall | 2.0: Glazing | ~1: Wall }

// -- 4. The attic: a deep white band standing out as far as the fins, a
// steel coping, the deck behind it --
Attic --> Comp(Faces) { Front: AtticFront | Back: AtticBack | Left: PartyIn | Right: PartyIn
    | Top: NIL | Bottom: Deck }
AtticFront --> Split(X) { WallD: NIL | ~1: AtticFrontIn | WallD: NIL }
AtticFrontIn --> Translate(0, 0, -WallD) Split(Y) { ~1: AtticBand | 0.1: AtticCoping }
AtticBand --> Extrude(WallD + FinOut) Mat("White") I("Trim")
AtticCoping --> Extrude(WallD + FinOut + 0.05) Mat("Steel") I("Trim")
AtticBack --> Split(X) { WallD: NIL | ~1: AtticBackIn | WallD: NIL }
AtticBackIn --> Translate(0, 0, -WallD) Wall
Deck --> Translate(WallD, WallD, -0.2) Size(scope.x - 2 * WallD, scope.y - 2 * WallD, 0)
    Extrude(0.2) Mat("Deck") I("Roof")

// -- 5. The plant house: a copper-clad box on the deck --
RoofTop --> Split(X) { ~1: NIL | min(Frontage * 0.5, 18): PlantSlot | ~1: NIL }
PlantSlot --> Split(Z) { 2.0: NIL | ~1: Plant | 2.0: NIL }
Plant --> Translate(0, 0.2 - AtticH, 0) Size(scope.x, AtticH - 0.2 + 3.4, scope.z)
    Split(Y) { ~1: PlantWall | 0.25: PlantCap }
PlantWall --> Mat("Copper") I("Wall")
PlantCap --> Mat("White") I("Trim")
