// The medieval theme's street house (#1598): a Hanseatic burgher house,
// jettied and gabled to the street. See street_house.rs for the house, and
// catalogue::items::street for the conventions and for what is declared
// ahead of these rules (Storeys, Trade, Frontage, Depth, GroundH, FloorH)
// and after them (Glazing, ShopGlazing, Wall).

const WallD = 0.3
const PaneSet = 0.12
const StepH = 0.55
const CourseH = 0.3
const CrownH = 0.4
const RoofH = 0.5
// How far each storey stands out past the one below: six of them, and the
// gable's own step, stay inside the two metres a front may reach.
const Jetty = 0.3
// One gable to every seven and a half metres of frontage, floored.
const GableW = 7.5

// -- 1. The house: its daub rolled once, then storeys, crown, gables --
Lot --> Extrude(GroundH + FloorH * (Storeys - 1) + CrownH + RoofH) Daub
Daub --> 30% Mat("DaubCream") Massing | 25% Mat("DaubWhite") Massing
    | 25% Mat("DaubOchre") Massing | 20% Mat("DaubRose") Massing
Massing --> Split(Y) { GroundH: Ground | ~1: Uppers | CrownH: Crown | RoofH: RoofZone }
// Party walls: the sides, the full depth, turning the corners.
PartyIn --> Translate(0, 0, -WallD) Wall
// The frame's timber is Picked once per house, whatever member it is.
Beam --> Pick("frame") { 50% OakBeam | 30% DarkBeam | 20% RedBeam }
OakBeam --> Mat("Oak") I("Timber")
DarkBeam --> Mat("DarkOak") I("Timber")
RedBeam --> Mat("Oxblood") I("Timber")

// -- 2. The stone ground storey: a shop or the hall --
Ground --> Mat("Stone") Comp(Faces) { Front: GroundFace | Back: RearGroundInset
    | Left: PartyIn | Right: PartyIn | Top: NIL | Bottom: NIL }
GroundFace --> Split(Y) { ~1: GroundFrontInset | CourseH: GroundCourse }
GroundFrontInset --> Split(X) { WallD: NIL | ~1: GroundFrontIn | WallD: NIL }
GroundFrontIn --> Translate(0, 0, -WallD) GroundFront
GroundFront --> when(Trade == 1): ShopFront | else: HallFront
// A shop: bays of windows over shutters let down as counters.
ShopFront --> Split(X) { ~1: ShopRun | 1.7: HouseDoor | ~1: ShopRun }
ShopRun --> Repeat(X, 3.2) { ShopBay }
ShopBay --> Split(X) { 0.45: Wall | ~1: ShopUnit | 0.45: Wall }
ShopUnit --> Split(Y) { 0.8: Wall | 0.1: Counter | 1.7: ShopGlazing | 0.3: Lintel | ~1: Wall }
Counter --> Extrude(WallD + 0.6) Mat("Shutter") I("Shutter")
HouseDoor --> Split(X) { 0.22: Jamb | ~1: DoorCol | 0.22: Jamb }
DoorCol --> Split(Y) { StepH: Step | 2.3: DoorLeaf | 0.3: Lintel | ~1: Wall }
// The hall: its great door, and small windows set high in the stone.
HallFront --> Split(X) { ~1: HallRun | 2.4: HallDoor | ~1: HallRun }
HallRun --> Repeat(X, 2.6) { HallBay }
HallBay --> Split(X) { ~1: Wall | 0.9: HallWin | ~1: Wall }
HallWin --> Split(Y) { 1.7: Wall | 1.1: Glazing | 0.22: Lintel | ~1: Wall }
HallDoor --> Split(X) { 0.25: Jamb | ~1: HallDoorCol | 0.25: Jamb }
HallDoorCol --> Split(Y) { StepH: Step | 2.6: DoorLeaf | 0.3: Lintel | ~1: Wall }
Jamb --> Extrude(WallD + 0.08) Mat("Dressing") I("Trim")
Lintel --> Extrude(WallD + 0.06) Mat("Dressing") I("Trim")
Step --> Extrude(WallD + 0.3) Mat("Dressing") I("Trim")
DoorLeaf --> Extrude(WallD - 0.15) Mat("Door") I("Door")
// The course over the ground storey; a shop hangs its sign from it.
GroundCourse --> when(Trade == 1): Split(X) { ~1: Course | 0.08: SignArm | ~2: Course }
    | else: Course
Course --> Extrude(0.1) Mat("Dressing") I("Trim")
SignArm --> Translate(0, -0.75, 0) Size(scope.x, 1.05, 0) Extrude(1.2)
    Split(Y) { 0.75: SignSlot | ~1: SignBracket }
SignBracket --> Mat("Iron") I("Trim")
SignSlot --> Split(Z) { 0.25: NIL | ~1: SignBoard }
SignBoard --> Mat("Sign") I("Sign")
// The yard side: small windows.
RearGroundInset --> Split(X) { WallD: NIL | ~1: RearGroundIn | WallD: NIL }
RearGroundIn --> Translate(0, 0, -WallD) RearGround
RearGround --> Repeat(X, 3.0) { RearBay }
RearBay --> Split(X) { ~1: Wall | 0.9: RearWindow | ~1: Wall }
RearWindow --> Split(Y) { 1.4: Wall | 1.1: Glazing | ~1: Wall }

// -- 3. The framed storeys, each jettied a step past the one below. A
// storey stands on a bressumer beam from the house's face out to its own
// plane, which closes the jetty's underside; it spans the whole frontage,
// standing clear of the party walls --
Uppers --> Comp(Faces) { Front: UpperFace | Back: RearUpperInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
UpperFace --> Repeat(Y, FloorH) { Storey }
Storey --> Jettied(Jetty * (split.i + 1))
Jettied(j) --> Split(Y) { 0.25: Bressumer(j) | ~1: StoreyBody(j) }
Bressumer(j) --> Extrude(j) Beam
StoreyBody(j) --> Translate(0, 0, j - WallD) Frame
// The frame: corner posts, then bays of a window between daub panels,
// a rail at the sill and the head, a post closing each bay.
Frame --> Split(X) { 0.22: Post | ~1: FrameBays | 0.22: Post }
FrameBays --> Repeat(X, 2.2) { FrameBay }
FrameBay --> Split(X) { ~1: Panel | 0.9: WinCol | ~1: Panel | 0.2: Post }
Panel --> Split(Y) { 0.8: Wall | 0.14: Rail | ~1: Wall }
WinCol --> Split(Y) { 0.8: Wall | 0.14: Rail | 1.3: Glazing | 0.14: Rail | ~1: Wall }
Post --> Extrude(WallD + 0.05) Beam
Rail --> Extrude(WallD + 0.04) Beam
RearUpperInset --> Split(X) { WallD: NIL | ~1: RearUpperIn | WallD: NIL }
RearUpperIn --> Translate(0, 0, -WallD) RearUpper
RearUpper --> Repeat(Y, FloorH) { RearStorey }
RearStorey --> Repeat(X, 3.0) { RearUpperBay }
RearUpperBay --> Split(X) { ~1: Wall | 0.9: RearUpperWindow | ~1: Wall }
RearUpperWindow --> Split(Y) { 0.9: Wall | 1.2: Glazing | ~1: Wall }

// -- 4. The crown: a wall plate the whole frontage, out past the top
// storey, a loft hatch in each gable over it --
Crown --> Comp(Faces) { Front: CrownFront | Back: RearCrownInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
CrownFront --> Repeat(X, GableW) { CrownSeg }
CrownSeg --> Split(X) { ~1: Plate | 1.0: HatchCol | ~1: Plate }
Plate --> Extrude(Jetty * (Storeys - 1) + 0.12) Beam
HatchCol --> Size(scope.x, CrownH + 2.2, 0) Extrude(Jetty * (Storeys - 1) + 0.17)
    Split(Y) { CrownH: HatchPlate | 0.7: NIL | 1.3: HatchSlot | ~1: NIL }
HatchPlate --> Split(Z) { ~1: Beam | 0.05: NIL }
// The hatch stands through the gable's face, so it shares no plane with it.
HatchSlot --> Split(Z) { ~1: NIL | 0.1: Hatch }
Hatch --> Mat("Shutter") I("Shutter")
RearCrownInset --> Split(X) { WallD: NIL | ~1: RearCrownIn | WallD: NIL }
RearCrownIn --> Translate(0, 0, -WallD) Wall

// -- 5. The gables, turned to the street and jettied out with the top
// storey and the plate: one on a narrow house, two on a wide one --
RoofZone --> Translate(0, 0, -(Jetty * (Storeys - 1) + 0.12))
    Size(scope.x, scope.y, scope.z + Jetty * (Storeys - 1) + 0.12) Gables
Gables --> Repeat(X, GableW) { GableRoof }
GableRoof --> Roof(Gable, 55, overhang=0, ridge=Z) { Slope: RoofSlope | GableEnd: GableFace }
RoofSlope --> Pick("roof") { 55% TileSlope | 45% SlateSlope }
TileSlope --> Mat("Tile") I("Roof")
SlateSlope --> Mat("Slate") I("Roof")
GableFace --> I("Wall")
