// The coastal resort's detached house (#1600): a clapboard seaside house in
// its garden. See street_detached.rs for the house, and
// catalogue::items::street for the conventions and for what is declared ahead
// of these rules (Storeys, Trade, Frontage, Depth, GroundH, FloorH) and after
// them (Glazing, ShopGlazing, Wall).

const WallD = 0.25
const PaneSet = 0.1
const StepH = 0.5
const RoofH = 1.0
// How far the roof reaches past the walls: the walls stand this far in
// from the lot's sides, so the eaves and verges keep inside it.
const Eave = 0.45
// How far the veranda stands out of the front.
const PorchD = 1.9

// -- 1. The house: its walls stand in from the lot, its paint rolled once --
Lot --> Split(X) { Eave: NIL | ~1: LotRow | Eave: NIL }
LotRow --> Split(Z) { Eave: NIL | ~1: Plot | Eave: NIL }
Plot --> Extrude(GroundH + FloorH * (Storeys - 1) + RoofH) Paint
Paint --> 22% Mat("PlankMint") Massing | 20% Mat("PlankPink") Massing
    | 18% Mat("PlankLemon") Massing | 20% Mat("PlankSky") Massing
    | 20% Mat("PlankWhite") Massing
Massing --> when(Storeys == 1): Split(Y) { GroundH: Ground | RoofH: RoofZone }
    | else: Split(Y) { GroundH: Ground | ~1: Uppers | RoofH: RoofZone }
Trim --> Mat("Trim") I("Trim")
Sill --> Extrude(WallD + 0.06) Trim
Head --> Extrude(WallD + 0.1) Trim
Step --> Extrude(WallD + 0.35) Trim
Wall0 --> I("Wall")

// -- 2. Windows: each between a pair of shutters, their colour Picked once;
// f is the sill's height over the scope's foot --
WinBay(f) --> Split(X) { ~1: Wall | 0.4: ShutCol(f) | 1.0: WinCol(f) | 0.4: ShutCol(f)
    | ~1: Wall }
WinCol(f) --> Split(Y) { f: Wall | 0.08: Sill | 1.4: Glazing | 0.12: Head | ~1: Wall }
ShutCol(f) --> Split(Y) { f + 0.08: Wall | 1.4: Shutter | ~1: Wall }
Shutter --> Pick("shutters") { 40% ShutterTeal | 35% ShutterNavy | 25% ShutterWhite }
ShutterTeal --> Mat("Door") ShutterLeaf
ShutterNavy --> Mat("DoorNavy") ShutterLeaf
ShutterWhite --> Mat("Trim") ShutterLeaf
ShutterLeaf --> Extrude(WallD + 0.04) I("Trim")
// A run of them; a Repeat floors its count, so a short run is one window.
Run(f) --> when(scope.x < 2.2): PlainBay(f) | else: Repeat(X, 2.2) { WinBay(f) }
PlainBay(f) --> Split(X) { ~1: Wall | 1.0: WinCol(f) | ~1: Wall }
// The sides and the back: plain windows, wider apart.
PlainRun(f) --> when(scope.x < 2.4): PlainBay(f) | else: Repeat(X, 2.4) { PlainBay(f) }
DoorLeaf --> 40% Mat("Door") Leaf | 30% Mat("DoorRed") Leaf | 30% Mat("DoorNavy") Leaf
Leaf --> Extrude(WallD - 0.1) I("Door")

// -- 3. The ground storey: a veranda or a stoop on the front, windows all
// round --
Ground --> Comp(Faces) { Front: FrontInset | Back: BackInset | Left: SideIn
    | Right: SideIn | Top: NIL | Bottom: NIL }
FrontInset --> Split(X) { WallD: NIL | ~1: FrontIn | WallD: NIL }
FrontIn --> Translate(0, 0, -WallD) GroundFront
GroundFront --> Pick("porch") { 55% Veranda | 45% Stoop }
// The stoop: the door up a white step under a hood.
Stoop --> Split(X) { ~1: Run(0.82) | 1.6: Entrance | ~1: Run(0.82) }
Entrance --> Split(X) { ~1: Wall | 1.0: DoorCol | ~1: Wall }
DoorCol --> Split(Y) { StepH: Step | 2.15: DoorLeaf | 0.12: Hood | ~1: Wall }
Hood --> Extrude(WallD + 0.8) Trim
// The veranda: a plank deck a step high, the door and windows on it, and a
// white roof on white posts - deck and roof reach the corners.
Veranda --> Split(Y) { StepH: DeckRow | 2.2: PorchRow | 0.18: PorchRoofRow | ~1: Wall }
DeckRow --> Extrude(WallD + PorchD) Split(Z) { WallD: Wall0 | ~1: Deck }
Deck --> Translate(-WallD, 0, 0) Size(scope.x + 2 * WallD, scope.y, scope.z)
    Mat("Post") I("Trim")
PorchRow --> Split(X) { ~1: Run(0.32) | 1.6: PorchEntrance | ~1: Run(0.32) }
PorchEntrance --> Split(X) { ~1: Wall | 1.0: PorchDoor | ~1: Wall }
PorchDoor --> Split(Y) { 2.15: DoorLeaf | ~1: Wall }
PorchRoofRow --> Extrude(WallD + PorchD) Split(Z) { WallD: Wall0 | ~1: PorchRoof }
PorchRoof --> Translate(-WallD, 0, 0) Size(scope.x + 2 * WallD, scope.y, scope.z) Mat("Trim")
    Split(Z) { ~1: Canopy | 0.14: PostLine }
Canopy --> I("Canopy")
// Posts at the ends and either side of the door, and one between where a
// run is long; each hangs from the roof's edge beam down to the deck.
PostLine --> Split(X) { 0.14: Post | ~1: BeamRun | 0.14: Post | 1.8: Canopy | 0.14: Post
    | ~1: BeamRun | 0.14: Post }
BeamRun --> when(scope.x > 4.0): Split(X) { ~1: Canopy | 0.14: Post | ~1: Canopy }
    | else: Canopy
Post --> Translate(0, -2.2, 0) Size(scope.x, scope.y + 2.2, scope.z) I("Trim")
// The garden side: a wide window to the garden in one bay of two.
BackInset --> Split(X) { WallD: NIL | ~1: BackIn | WallD: NIL }
BackIn --> Translate(0, 0, -WallD) BackRun
BackRun --> when(scope.x < 2.4): PlainBay(0.82) | else: Repeat(X, 2.4) { BackBay }
BackBay --> 50% PlainBay(0.82) | 50% Split(X) { ~1: Wall | 1.6: GardenCol | ~1: Wall }
GardenCol --> Split(Y) { 0.5: Wall | 2.0: Glazing | 0.12: Head | ~1: Wall }
// The sides: their walls run the full depth, turning the corners.
SideIn --> Translate(0, 0, -WallD) SideFace
SideFace --> Split(X) { 0.6: Wall | ~1: PlainRun(0.82) | 0.6: Wall }

// -- 4. The upper storeys: shuttered windows on the front, plain ones
// round the rest --
Uppers --> Comp(Faces) { Front: UpFrontInset | Back: UpBackInset | Left: UpSideIn
    | Right: UpSideIn | Top: NIL | Bottom: NIL }
UpFrontInset --> Split(X) { WallD: NIL | ~1: UpFrontIn | WallD: NIL }
UpFrontIn --> Translate(0, 0, -WallD) UpFront
UpFront --> Repeat(Y, FloorH) { UpStorey }
UpStorey --> Run(0.62)
UpBackInset --> Split(X) { WallD: NIL | ~1: UpBackIn | WallD: NIL }
UpBackIn --> Translate(0, 0, -WallD) UpBack
UpBack --> Repeat(Y, FloorH) { UpBackStorey }
UpBackStorey --> PlainRun(0.62)
UpSideIn --> Translate(0, 0, -WallD) UpSide
UpSide --> Repeat(Y, FloorH) { UpSideStorey }
UpSideStorey --> Split(X) { 0.6: Wall | ~1: PlainRun(0.62) | 0.6: Wall }

// -- 5. The roof: a gable along the street or to it, or a hip, in grey or
// cedar shingle, its eaves out to the lot's edges --
RoofZone --> Pick("roof") { 40% GableRoof | 30% FrontGable | 30% HipRoof }
GableRoof --> Roof(Gable, 38, overhang=Eave, ridge=X) { Slope: Shingles | GableEnd: Gable }
FrontGable --> Roof(Gable, 40, overhang=Eave, ridge=Z) { Slope: Shingles | GableEnd: Gable }
HipRoof --> Roof(Hip, 30, overhang=Eave) { Slope: Shingles }
Shingles --> Pick("shingle") { 55% GreyShingle | 45% CedarShingle }
GreyShingle --> Mat("Shingle") I("Roof")
CedarShingle --> Mat("ShingleCedar") I("Roof")
Gable --> I("Wall")
