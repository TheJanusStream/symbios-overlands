// The coastal resort's hall (#1600): a boatyard's boat shed, or - where it
// trades - a seafront amusement arcade. See street_hall.rs for the hall, and
// catalogue::items::street for the conventions and for what is declared ahead
// of these rules (Storeys, Trade, Frontage, Depth, GroundH, FloorH) and after
// them (Glazing, ShopGlazing, Wall).

const WallD = 0.3
const PaneSet = 0.1
const StepH = 0.5
// The roof zone: a boat shed's gables.
const RoofH = 1.0
// An arcade's parapet, and its step up round the fin over the entrance.
const ParapetH = 1.2
const TowerH = 1.6
// The sign fin: its width along the front, and how far it stands out.
const FinW = 0.6
const FinOut = 1.5

Lot --> when(Trade == 1): Arcade | else: Shed
// Party walls: the sides, the full depth, turning the corners. A hall's
// gable ends are its cladding, blank.
PartyIn --> Translate(0, 0, -WallD) Wall
Wall0 --> I("Wall")
Trim --> Mat("Trim") I("Trim")
Step --> Extrude(WallD + 0.35) Trim
DoorLeaf --> Extrude(WallD - 0.1) Mat("Door") I("Door")
// A ribbon of high windows, along any front.
Ribbon --> Repeat(X, 2.4) { RibbonBay }
RibbonBay --> Split(X) { 0.3: Wall | ~1: Glazing | 0.3: Wall }
// The back: a yard's windows, or a boat shed's doors to the water.
BackInset --> Split(X) { WallD: NIL | ~1: BackIn | WallD: NIL }
BackIn --> Translate(0, 0, -WallD) BackFace
BackFace --> when(Trade == 1): Split(Y) { ~1: Wall | 1.1: Ribbon | 0.5: Wall }
    | else: Split(Y) { ~1: BackDoors | 1.1: Ribbon | 0.4: Wall }
BackDoors --> Split(X) { 1.2: Wall | ~1: BackRun | 1.2: Wall }
BackRun --> Repeat(X, 12.0) { BackBay }
BackBay --> 50% Split(X) { ~1: Wall | 4.4: BoatCol | ~1: Wall } | 50% Wall
// An upper storey: a net loft, or the arcade's cafe - a ribbon front and
// back, the fin through an arcade's.
Upper --> Comp(Faces) { Front: UpInset | Back: UpBackInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
UpInset --> Split(X) { WallD: NIL | ~1: UpIn | WallD: NIL }
UpIn --> Translate(0, 0, -WallD) UpFace
UpFace --> when(Trade == 1): Split(X) { ~1: UpPlain | FinW: FinCol | ~1: UpPlain }
    | else: UpPlain
UpBackInset --> Split(X) { WallD: NIL | ~1: UpBackIn | WallD: NIL }
UpBackIn --> Translate(0, 0, -WallD) UpPlain
UpPlain --> Split(Y) { ~1: Wall | 1.3: Ribbon | 0.9: Wall }

// -- 1. The boat shed: weathered planks rolled once, tall sliding doors
// over a slipway, a row of shingle gables or one long one --
Shed --> Extrude(GroundH + FloorH * (Storeys - 1) + RoofH) Boards
Boards --> 45% Mat("PlankDrift") ShedMass | 30% Mat("PlankWhite") ShedMass
    | 25% Mat("PlankSky") ShedMass
ShedMass --> when(Storeys == 1): Split(Y) { GroundH: ShedGround | RoofH: ShedRoof }
    | else: Split(Y) { GroundH: ShedGround | ~1: Upper | RoofH: ShedRoof }
ShedGround --> Comp(Faces) { Front: ShedFrontInset | Back: BackInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
ShedFrontInset --> Split(X) { WallD: NIL | ~1: ShedFrontIn | WallD: NIL }
ShedFrontIn --> Translate(0, 0, -WallD) ShedFront
ShedFront --> Split(Y) { ~1: ShedDoors | 1.1: Ribbon | 0.4: Wall }
// A door for people at one end, the boat doors along the rest.
ShedDoors --> Split(X) { 1.2: Wall | 1.1: ManDoor | 1.0: Wall | ~1: BoatRun | 1.2: Wall }
ManDoor --> Split(Y) { StepH: Step | 2.2: DoorLeaf | ~1: Wall }
BoatRun --> Repeat(X, 6.0) { BoatBay }
// A lone bay always has its doors; along a longer run, some are blank.
BoatBay --> when(split.n == 1): BoatDoorBay | else: MaybeBoat
MaybeBoat --> 70% BoatDoorBay | 30% Wall
BoatDoorBay --> Split(X) { ~1: Wall | 4.4: BoatCol | ~1: Wall }
// Two sliding leaves over a plank slipway, their rail over them; the sink
// buries all but the slipway's top.
BoatCol --> Split(Y) { 0.45: Slip | 3.9: BoatDoors | 0.14: DoorRail | ~1: Wall }
Slip --> Extrude(WallD + 1.6) Mat("Post") I("Trim")
BoatDoors --> Split(X) { ~1: BoatLeaf | 0.12: DoorStrip | ~1: BoatLeaf }
BoatLeaf --> Extrude(WallD - 0.08) Mat("BoatDoor") I("Door")
DoorStrip --> Extrude(WallD - 0.04) Trim
DoorRail --> Extrude(WallD + 0.1) Trim
// A row of gables to the street, one a bay, or one long gable along it.
ShedRoof --> Pick("roof") { 55% RowGables | 45% LongGable }
RowGables --> Repeat(X, 12.0) { BayGable }
BayGable --> Roof(Gable, 26, overhang=0, ridge=Z) { Slope: Shingles | GableEnd: Gable }
LongGable --> Roof(Gable, 18, overhang=0, ridge=X) { Slope: Shingles | GableEnd: Gable }
Shingles --> Mat("Shingle") I("Roof")
Gable --> I("Wall")

// -- 2. The arcade: a pastel rolled once, shop windows under striped
// awnings either side of its entrance, a neon fin and a stepped parapet --
Arcade --> Extrude(GroundH + FloorH * (Storeys - 1) + ParapetH + TowerH) Pastel
Pastel --> 24% Mat("Pink") ArcadeMass | 22% Mat("Mint") ArcadeMass
    | 18% Mat("Lemon") ArcadeMass | 20% Mat("Sky") ArcadeMass | 16% Mat("Lilac") ArcadeMass
ArcadeMass --> when(Storeys == 1):
    Split(Y) { GroundH: ArcadeGround | ParapetH: Parapet | TowerH: Tower }
    | else: Split(Y) { GroundH: ArcadeGround | ~1: Upper | ParapetH: Parapet
    | TowerH: Tower }
ArcadeGround --> Comp(Faces) { Front: ArcadeFrontInset | Back: BackInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
ArcadeFrontInset --> Split(X) { WallD: NIL | ~1: ArcadeFrontIn | WallD: NIL }
ArcadeFrontIn --> Translate(0, 0, -WallD) ArcadeFront
ArcadeFront --> Split(X) { ~1: ShopRun | 6.4: Entrance | ~1: ShopRun }
// A Repeat floors its count: a run narrower than one shop is one shop.
ShopRun --> when(scope.x < 4.8): ShopBay | else: Repeat(X, 4.8) { ShopBay }
ShopBay --> Split(X) { 0.35: Wall | ~1: ShopUnit | 0.35: Wall }
ShopUnit --> Split(Y) { 0.6: Plinth | 2.6: ShopGlazing | 0.2: Awning | 0.6: Wall
    | 0.7: ShopSign | ~1: Wall }
Plinth --> Extrude(WallD + 0.05) Trim
ShopSign --> Split(X) { 0.3: Wall | ~1: SignBoard | 0.3: Wall }
SignBoard --> Extrude(WallD + 0.08) Mat("Sign") I("Fascia")
// A striped awning, one stripe an arcade, its valance hanging at the edge.
Awning --> Pick("awning") { 50% AwningRed | 50% AwningTeal }
AwningRed --> Mat("AwningRed") AwningBody
AwningTeal --> Mat("AwningTeal") AwningBody
AwningBody --> Extrude(WallD + 1.6) Split(Z) { ~1: AwningTop | 0.06: Valance }
AwningTop --> I("Canopy")
Valance --> Translate(0, -0.34, 0) Size(scope.x, 0.54, scope.z) I("Canopy")
// The entrance: glazed doors up a step between shop windows, a white
// marquee over them, and the fin rising from it between two windows.
Entrance --> Split(X) { 0.4: Wall | ~1: EntryCol | 0.4: Wall }
EntryCol --> Split(Y) { StepH: Step | 2.8: EntryDoors | 0.25: Marquee | ~1: EntryUpper }
EntryDoors --> Split(X) { ~1: ShopGlazing | 1.2: DoorLeaf | 0.1: Wall | 1.2: DoorLeaf
    | ~1: ShopGlazing }
Marquee --> Extrude(WallD + 1.8) Trim
EntryUpper --> Split(X) { ~1: EntryWindow | FinW: FinCol | ~1: EntryWindow }
EntryWindow --> Split(X) { 0.4: Wall | ~1: EntryPane | 0.4: Wall }
EntryPane --> Split(Y) { 0.5: Wall | ~1: Glazing | 0.4: Wall }

// -- 3. The fin: a white blade banded in neon, standing over the entrance
// and up through the parapet --
FinCol --> Extrude(WallD + FinOut) Split(Z) { WallD: Wall0 | ~1: Fin }
FinUp --> Translate(0, 0, -WallD) FinCol
Fin --> Repeat(Y, 1.6) { FinSegment }
FinSegment --> Split(Y) { ~1: FinBlade | 0.28: FinNeon }
FinBlade --> Mat("Fin") I("Fin")
FinNeon --> Pick("neon") { 60% NeonPink | 40% NeonBlue }
NeonPink --> Mat("Neon") I("Fin")
NeonBlue --> Mat("NeonBlue") I("Fin")

// -- 4. The parapet, the deck inside it, and its step over the entrance --
Parapet --> Comp(Faces) { Front: ParapetFront | Back: ParapetFace | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: Deck }
ParapetFront --> Split(X) { ~1: ParapetLeft | FinW: FinUp | ~1: ParapetRight }
ParapetLeft --> Split(Y) { ~1: ParapetLeftInset | 0.16: Coping }
ParapetLeftInset --> Split(X) { WallD: NIL | ~1: ParapetIn }
ParapetRight --> Split(Y) { ~1: ParapetRightInset | 0.16: Coping }
ParapetRightInset --> Split(X) { ~1: ParapetIn | WallD: NIL }
ParapetFace --> Split(Y) { ~1: ParapetInset | 0.16: Coping }
ParapetInset --> Split(X) { WallD: NIL | ~1: ParapetIn | WallD: NIL }
ParapetIn --> Translate(0, 0, -WallD) Wall
Coping --> Extrude(0.08) Trim
// The deck fills the ring inside the parapet's walls.
Deck --> Translate(WallD, WallD, -0.2) Size(scope.x - 2 * WallD, scope.y - 2 * WallD, 0)
    Extrude(0.2) Mat("Deck") I("Roof")
Tower --> Comp(Faces) { Front: TowerFront | Back: NIL | Left: NIL | Right: NIL | Top: NIL
    | Bottom: NIL }
TowerFront --> Split(X) { ~1: NIL | 4.0: StepBlock | FinW: FinUp | 4.0: StepBlock | ~1: NIL }
StepBlock --> Split(Y) { ~1: StepWall | 0.16: Coping }
StepWall --> Translate(0, 0, -WallD) Wall
