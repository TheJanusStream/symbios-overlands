// The modern city's street house (#1598): a Berlin Altbau. See
// street_house.rs for the house, and catalogue::items::street for the
// conventions and for what is declared ahead of these rules (Storeys, Trade,
// Frontage, Depth, GroundH, FloorH) and after them (Glazing, ShopGlazing,
// Wall).

const WallD = 0.42
const PaneSet = 0.16
const PlinthH = 0.65
const CourseH = 0.3
const StepH = 0.55
const CrownH = 1.1
const RoofH = 1.0

// -- 1. The house: its cladding rolled once, then storeys, crown, roof --
Lot --> Extrude(GroundH + FloorH * (Storeys - 1) + CrownH + RoofH) Cladding
Cladding --> 24% Mat("Ochre") Massing | 20% Mat("Grey") Massing
    | 20% Mat("Cream") Massing | 14% Mat("Rose") Massing
    | 22% Mat("YellowBrick") Massing
Massing --> Split(Y) { GroundH: Ground | ~1: Uppers | CrownH: Crown | RoofH: RoofZone }
// Party walls: the sides, the full depth, turning the corners.
PartyIn --> Translate(0, 0, -WallD) Wall

// -- 2. The ground storey: shops or homes, under the string course --
Ground --> Comp(Faces) { Front: GroundFace | Back: RearGroundInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
GroundFace --> Split(Y) { ~1: GroundFrontInset | CourseH: Course }
Course --> Extrude(0.12) Mat("Trim") I("Trim")
GroundFrontInset --> Split(X) { WallD: NIL | ~1: GroundFrontIn | WallD: NIL }
GroundFrontIn --> Translate(0, 0, -WallD) GroundFront
GroundFront --> when(Trade == 1): ShopFront | else: HomeFront
ShopFront --> Split(X) { ~1: ShopRun | 2.1: Entrance | ~1: ShopRun }
ShopRun --> Repeat(X, 3.6) { ShopBay }
ShopBay --> Split(X) { 0.4: Wall | ~1: ShopUnit | 0.4: Wall }
ShopUnit --> when(scope.x > 2.4): Split(X) { ~1: ShopWindow | 1.1: ShopDoor }
    | else: ShopWindow
ShopWindow --> Split(Y) { PlinthH: Wall | ~1: ShopGlazing | 0.75: Fascia }
ShopDoor --> Split(Y) { StepH: Step | 2.3: DoorLeaf | ~1: ShopGlazing | 0.75: Fascia }
Fascia --> Extrude(WallD + 0.08) Mat("Fascia") I("Fascia")
DoorLeaf --> Extrude(WallD - 0.2) Mat("Door") I("Door")
// A stone step, standing out of the wall: the sink buries all but the top
// of it, so a door starts above the pavement.
Step --> Extrude(WallD + 0.3) Mat("Trim") I("Trim")
HomeFront --> Split(X) { ~1: HomeRun | 2.1: Entrance | ~1: HomeRun }
HomeRun --> Repeat(X, 2.6) { HomeBay }
HomeBay --> Split(X) { ~1: Wall | 1.25: HomeWindow | ~1: Wall }
HomeWindow --> Split(Y) { 1.45: Wall | 2.15: Glazing | ~1: Wall }
// The house door: a tall leaf under a fanlight, up a step.
Entrance --> Split(X) { 0.3: Wall | ~1: EntranceDoor | 0.3: Wall }
EntranceDoor --> Split(Y) { StepH: Step | 2.75: DoorLeaf | ~1: Fanlight }
Fanlight --> Split(Y) { ~1: Glazing | 0.3: Wall }
// The courtyard side: windows over high sills.
RearGroundInset --> Split(X) { WallD: NIL | ~1: RearGroundIn | WallD: NIL }
RearGroundIn --> Translate(0, 0, -WallD) RearGround
RearGround --> Repeat(X, 2.8) { RearBay }
RearBay --> Split(X) { ~1: Wall | 1.1: RearWindow | ~1: Wall }
RearWindow --> Split(Y) { 1.45: Wall | 2.0: Glazing | ~1: Wall }

// -- 3. The upper storeys: banded, then bayed --
Uppers --> Comp(Faces) { Front: UpperFrontInset | Back: RearUpperInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
UpperFrontInset --> Split(X) { WallD: NIL | ~1: UpperFrontIn | WallD: NIL }
UpperFrontIn --> Translate(0, 0, -WallD) UpperFront
UpperFront --> Repeat(Y, FloorH) { Storey }
Storey --> Split(X) { 0.9: Wall | ~1: Bays | 0.9: Wall }
Bays --> Repeat(X, 2.4) { Bay }
// The end bays carry the balconies, where the house has them. A guard
// holds no nested parentheses: one guard per end bay.
Bay --> when(split.n >= 3 && split.i == 0): SideBay
    | when(split.n >= 3 && split.i == split.n - 1): SideBay | else: WinBay
SideBay --> Pick("balconies") { 45% BalconyBay | 55% WinBay }
WinBay --> Split(X) { ~1: Wall | 1.3: WinCol | ~1: Wall }
WinCol --> Split(Y) { 0.72: Wall | 0.12: Sill | 2.25: Glazing | 0.2: Hood | ~1: Wall }
Sill --> Extrude(WallD + 0.07) Mat("Trim") I("Trim")
Hood --> Extrude(WallD + 0.11) Mat("Trim") I("Trim")
BalconyBay --> Split(X) { 0.35: Wall | ~1: BalconyCol | 0.35: Wall }
BalconyCol --> Split(Y) { 1.1: Balcony | 1.95: Glazing | 0.2: Hood | ~1: Wall }
Balcony --> Extrude(WallD + 1.15) Mat("Trim") I("Balcony")
RearUpperInset --> Split(X) { WallD: NIL | ~1: RearUpperIn | WallD: NIL }
RearUpperIn --> Translate(0, 0, -WallD) RearUpper
RearUpper --> Repeat(Y, FloorH) { RearStorey }
RearStorey --> Repeat(X, 2.8) { RearUpperBay }
RearUpperBay --> Split(X) { ~1: Wall | 1.1: RearUpperWindow | ~1: Wall }
RearUpperWindow --> Split(Y) { 0.9: Wall | 2.0: Glazing | ~1: Wall }

// -- 4. The crown: a cornice the whole frontage, an attic over it --
Crown --> Comp(Faces) { Front: Cornice | Back: RearCrownInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
Cornice --> Split(Y) { 0.3: CorniceBed | 0.22: CorniceCorona | ~1: Attic }
CorniceBed --> Extrude(0.16) Mat("Trim") I("Cornice")
CorniceCorona --> Extrude(0.48) Mat("Trim") I("Cornice")
Attic --> Extrude(0.1) I("Wall")
RearCrownInset --> Split(X) { WallD: NIL | ~1: RearCrownIn | WallD: NIL }
RearCrownIn --> Translate(0, 0, -WallD) Wall

// -- 5. The roof: a mansard along the street, or a deck --
RoofZone --> Pick("roof") { 58% Mansard | 42% FlatTop }
// The break is a storey up whatever the depth: Gambrel breaks at `tier` of
// the half-depth, half by default - an 11 m roof on a 14 m house. A 1.2 m
// run at 70 degrees rises 3.3 m, the attic storey.
Mansard --> Roof(Gambrel, 70, 22, overhang=0, ridge=X, tier=2.4 / Depth)
    { LowerSlope: Slate | UpperSlope: Slate | GableEnd: Gable }
Slate --> Mat("Slate") I("Roof")
Gable --> I("Wall")
FlatTop --> Size(scope.x, 0.22, scope.z) Mat("Deck") I("Roof")
