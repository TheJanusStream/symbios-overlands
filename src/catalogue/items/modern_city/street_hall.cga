// The modern city's hall (#1600): a works hall, or - where it trades - a
// retail box. See street_hall.rs for the hall, and catalogue::items::street
// for the conventions and for what is declared ahead of these rules
// (Storeys, Trade, Frontage, Depth, GroundH, FloorH) and after them
// (Glazing, ShopGlazing, Wall).

const WallD = 0.3
const PaneSet = 0.12
const StepH = 0.5
// The roof zone: a store's parapet, a works' eaves.
const RoofH = 1.0

// -- 1. The hall: its cladding rolled once, then storeys and a roof --
Lot --> Extrude(GroundH + FloorH * (Storeys - 1) + RoofH) Cladding
Cladding --> 35% Mat("SheetGrey") Massing | 25% Mat("SheetWhite") Massing
    | 20% Mat("SheetBlue") Massing | 20% Mat("Panel") Massing
Massing --> when(Storeys == 1): Split(Y) { GroundH: Ground | RoofH: RoofZone }
    | else: Split(Y) { GroundH: Ground | ~1: Upper | RoofH: RoofZone }
// Party walls: the sides, the full depth, turning the corners. A hall's
// gable ends are its cladding, blank.
PartyIn --> Translate(0, 0, -WallD) Wall

// -- 2. The ground storey: a works' doors, or a store's front --
Ground --> Comp(Faces) { Front: FrontInset | Back: BackInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
FrontInset --> Split(X) { WallD: NIL | ~1: FrontIn | WallD: NIL }
FrontIn --> Translate(0, 0, -WallD) GroundFront
GroundFront --> when(Trade == 1): StoreFront | else: WorksFront
// The works: a door for people at one end, bays of roller doors along the
// rest, and a ribbon of high windows over them all.
WorksFront --> Split(Y) { ~1: WorksDoors | 1.1: Ribbon | 0.5: Wall }
WorksDoors --> Split(X) { 1.4: Wall | 1.1: ManDoor | 1.2: Wall | ~1: DoorRun | 1.4: Wall }
ManDoor --> Split(Y) { StepH: Step | 2.2: ManLeaf | ~1: Wall }
ManLeaf --> Extrude(WallD - 0.12) Mat("DoorMetal") I("Door")
Step --> Extrude(WallD + 0.4) Mat("Concrete") I("Trim")
DoorRun --> Repeat(X, 7.5) { DoorBay }
DoorBay --> 60% Split(X) { ~1: Wall | 4.2: RollerCol | ~1: Wall } | 40% Wall
// A roller door over its concrete apron: the sink buries all but its top.
RollerCol --> Split(Y) { 0.45: Apron | 4.0: Roller | ~1: Lintel }
Apron --> Extrude(WallD + 1.4) Mat("Concrete") I("Trim")
Roller --> Extrude(WallD - 0.1) Mat("Roller") I("Door")
Lintel --> Extrude(WallD + 0.08) Mat("Trim") I("Trim")
Ribbon --> Repeat(X, 2.4) { RibbonBay }
RibbonBay --> Split(X) { 0.2: Wall | ~1: Glazing | 0.2: Wall }
// The store: blank cladding either side of a glazed entrance under a
// canopy and the store's sign - a quarter of a long front, never narrower
// than a pair of shop windows and the doors between them.
StoreFront --> when(scope.x < 30): Split(X) { ~1: StoreSide | 6.4: StoreEntrance | ~1: StoreSide }
    | else: Split(X) { ~3: StoreSide | ~2: StoreEntrance | ~3: StoreSide }
StoreSide --> Split(Y) { ~1: Wall | 1.1: Ribbon | 0.5: Wall }
StoreEntrance --> Split(Y) { 0.45: Plinth | 2.75: Entry | 0.25: Canopy | 1.6: Sign | ~1: Wall }
Plinth --> Extrude(WallD + 0.05) Mat("Concrete") I("Trim")
// Sliding doors in the middle, shop windows either side of them.
Entry --> Split(X) { ~1: ShopRun | 2.2: GlassDoor | ~1: ShopRun }
ShopRun --> when(scope.x > 2.4): Repeat(X, 2.4) { ShopBay } | else: ShopBay
ShopBay --> Split(X) { 0.15: Wall | ~1: ShopGlazing | 0.15: Wall }
GlassDoor --> Extrude(WallD - 0.1) Mat("DoorMetal") I("Door")
Canopy --> Extrude(WallD + 1.8) Mat("Metal") I("Canopy")
Sign --> Extrude(WallD + 0.12) Mat("Sign") I("Fascia")
// The yard side: a loading door here and there, the ribbon over it.
BackInset --> Split(X) { WallD: NIL | ~1: BackIn | WallD: NIL }
BackIn --> Translate(0, 0, -WallD) BackFace
BackFace --> Split(Y) { ~1: BackDoors | 1.1: Ribbon | 0.5: Wall }
BackDoors --> Split(X) { 1.4: Wall | ~1: BackRun | 1.4: Wall }
BackRun --> Repeat(X, 12.0) { DoorBay }

// -- 3. An upper storey: offices, one ribbon of windows front and back --
Upper --> Comp(Faces) { Front: UpInset | Back: UpInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
UpInset --> Split(X) { WallD: NIL | ~1: UpIn | WallD: NIL }
UpIn --> Translate(0, 0, -WallD) UpFace
UpFace --> Split(Y) { ~1: Wall | 1.3: Ribbon | 0.9: Wall }

// -- 4. The roof: a works' low gable or sawtooth, a store's flat deck --
RoofZone --> when(Trade == 1): Parapet | else: WorksRoof
WorksRoof --> Pick("roof") { 55% LowGable | 45% Sawtooth }
LowGable --> Roof(Gable, 9, overhang=0, ridge=X) { Slope: Sheet | GableEnd: Gable }
Sheet --> Mat("Roofing") I("Roof")
Gable --> I("Wall")
// Teeth along the street, each its slope and its glazed north light.
Sawtooth --> Repeat(Z, 8.0) { Tooth }
Tooth --> Roof(Shed, 22, overhang=0) { Slope: Sheet | Back: NorthLight | GableEnd: Gable }
NorthLight --> Repeat(X, 2.4) { NorthPane }
NorthPane --> Mat("Glass") I("Pane")
Parapet --> Comp(Faces) { Front: ParapetFace | Back: ParapetFace | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: Deck }
ParapetFace --> Split(Y) { ~1: ParapetInset | 0.12: Coping }
ParapetInset --> Split(X) { WallD: NIL | ~1: ParapetIn | WallD: NIL }
ParapetIn --> Translate(0, 0, -WallD) Wall
Coping --> Extrude(0.05) Mat("Metal") I("Trim")
Deck --> Translate(WallD, WallD, -0.2) Size(scope.x - 2 * WallD, scope.y - 2 * WallD, 0)
    Extrude(0.2) Mat("Deck") I("Roof")
