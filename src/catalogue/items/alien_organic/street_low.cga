// The hive's low building (#1598): a row of brood pods, or - where it
// trades - a spore market. See street_low.rs for the building, and
// catalogue::items::street for the conventions and for what is declared
// ahead of these rules and after them.

const WallD = 0.4
const PaneSet = 0.26
const PlinthH = 0.55
const StepH = 0.5
const RollH = 0.6
const DomeH = 2.6
const VaultH = 3.4
// A pod's width along the street: a lot holds as many as fit.
const PodW = 5.5

Lot --> when(Trade == 1): Market | else: PodRow
// Party walls: the sides, the full depth, turning the corners.
PartyIn --> Translate(0, 0, -WallD) Wall
Rib --> Extrude(WallD + 0.26) Mat("Rib") I("Rib")
Lip --> Extrude(WallD + 0.12) Mat("Lip") I("Lip")
Brow --> Extrude(WallD + 0.22) Mat("Lip") I("Lip")
Step --> Extrude(WallD + 0.3) Mat("Carapace") I("Trim")
// A fleshy roll at each floor: a tube laid along the street, half sunk in
// the shell, a wall behind it.
Roll --> Extrude(WallD + 0.34) Split(Z) { WallD - 0.14: RollBack | ~1: RollTube }
RollBack --> I("Wall")
RollTube --> Translate(scope.x, 0, 0) Rotate(0.70710678, 0, 0, 0.70710678)
    Size(scope.y, scope.x, scope.z) Mat("Sinew") I("Tube")

// -- 1. The pod row: pods under domed carapaces, the shell rolled once --
PodRow --> Extrude(GroundH + FloorH * (Storeys - 1) + DomeH) Shell
Shell --> 35% Mat("ChitinViolet") Pods | 35% Mat("ChitinGreen") Pods
    | 30% Mat("ChitinAmber") Pods
Pods --> when(Storeys == 1): Split(Y) { GroundH: PodGround | DomeH: Domes }
    | else: Split(Y) { GroundH: PodGround | ~1: PodUpper | DomeH: Domes }
PodGround --> Comp(Faces) { Front: PodFrontInset | Back: PodRearInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
PodFrontInset --> Split(X) { WallD: NIL | ~1: PodFrontIn | WallD: NIL }
PodFrontIn --> Translate(0, 0, -WallD) Split(Y) { ~1: PodFront | RollH: Roll }
PodFront --> Repeat(X, PodW) { Pod }
// Each pod: a pod window and a maw between ribs.
Pod --> Split(X) { 0.3: Rib | ~1: Wall | 1.3: PodWindow | 0.6: Wall | 1.2: PodMaw | ~1: Wall
    | 0.3: Rib }
PodWindow --> Split(Y) { 0.85: Wall | 0.14: Lip | 1.4: Glazing | 0.18: Brow | ~1: Wall }
PodMaw --> Split(Y) { StepH: Step | 2.1: MawLeaf | 0.2: Brow | ~1: Wall }
// Each pod its own flesh at the maw.
MawLeaf --> 50% Mat("Flesh") Leaf | 50% Mat("FleshDark") Leaf
Leaf --> Extrude(WallD - 0.18) I("Door")
PodRearInset --> Split(X) { WallD: NIL | ~1: PodRearIn | WallD: NIL }
PodRearIn --> Translate(0, 0, -WallD) PodRear
PodRear --> Repeat(X, 2.75) { PodRearBay }
PodRearBay --> Split(X) { ~1: Wall | 1.2: PodRearWindow | ~1: Wall }
PodRearWindow --> Split(Y) { 0.95: Wall | 1.3: Glazing | ~1: Wall }
PodUpper --> Comp(Faces) { Front: PodUpFrontInset | Back: PodUpRearInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
PodUpFrontInset --> Split(X) { WallD: NIL | ~1: PodUpFrontIn | WallD: NIL }
PodUpFrontIn --> Translate(0, 0, -WallD) Split(Y) { ~1: PodUpFront | RollH: Roll }
PodUpFront --> Repeat(X, PodW) { PodUp }
PodUp --> Split(X) { 0.3: Rib | ~1: Wall | 1.2: PodUpWindow | ~1: Wall | 1.2: PodUpWindow
    | ~1: Wall | 0.3: Rib }
PodUpWindow --> Split(Y) { 0.5: Wall | 0.14: Lip | 1.2: Glazing | 0.18: Brow | ~1: Wall }
PodUpRearInset --> Split(X) { WallD: NIL | ~1: PodUpRearIn | WallD: NIL }
PodUpRearIn --> Translate(0, 0, -WallD) PodUpRear
PodUpRear --> Repeat(X, 2.75) { PodUpRearBay }
PodUpRearBay --> Split(X) { ~1: Wall | 1.2: PodUpRearWindow | ~1: Wall }
PodUpRearWindow --> Split(Y) { 0.6: Wall | 1.2: Glazing | ~1: Wall }
// A domed carapace over every pod, over a fleshy deck that closes the
// row's top: two turned, tapered shells, one on the other.
Domes --> Split(Y) { 0.2: DomeDeck | ~1: DomeRow }
DomeDeck --> Mat("FleshDark") I("Roof")
DomeRow --> Split(X) { WallD: NIL | ~1: DomeRun | WallD: NIL }
DomeRun --> Repeat(X, PodW) { Dome }
Dome --> Split(Z) { 0.2: NIL | ~1: DomeBody | 0.2: NIL }
DomeBody --> Split(Y) { ~1.1: DomeLow | ~0.8: DomeMidZone | ~0.5: DomeTopZone }
DomeLow --> Taper(0.18) Mat("Carapace") I("Carapace")
DomeMidZone --> Split(X) { ~0.09: NIL | ~0.82: DomeMidX | ~0.09: NIL }
DomeMidX --> Split(Z) { ~0.09: NIL | ~0.82: DomeMid | ~0.09: NIL }
DomeMid --> Taper(0.4) Mat("Carapace") I("Carapace")
DomeTopZone --> Split(X) { ~0.254: NIL | ~0.492: DomeTopX | ~0.254: NIL }
DomeTopX --> Split(Z) { ~0.254: NIL | ~0.492: DomeTop | ~0.254: NIL }
// Its crown a spore vent, glowing in some pods.
DomeTop --> 60% Taper(0.9) Mat("Carapace") I("Carapace") | 40% Taper(0.9) Mat("Spore") I("Pod")

// -- 2. The spore market: stalls under a fleshy bolster and a spore band --
Market --> Extrude(GroundH + FloorH * (Storeys - 1) + 0.6 + VaultH) Shell2
Shell2 --> 40% Mat("ChitinViolet") MarketMass | 30% Mat("ChitinGreen") MarketMass
    | 30% Mat("ChitinAmber") MarketMass
MarketMass --> when(Storeys == 1): Split(Y) { GroundH: MkGround | 0.6: MkCrown | VaultH: MkVault }
    | else: Split(Y) { GroundH: MkGround | ~1: MkUpper | 0.6: MkCrown | VaultH: MkVault }
MkGround --> Comp(Faces) { Front: MkFrontInset | Back: MkRearInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
MkFrontInset --> Split(X) { WallD: NIL | ~1: MkFrontIn | WallD: NIL }
MkFrontIn --> Translate(0, 0, -WallD) MkFront
MkFront --> Split(Y) { ~1: MkStalls | 0.7: Bolster | 0.55: SporeBand }
MkStalls --> Repeat(X, 4.0) { MkBay }
MkBay --> Split(X) { 0.34: Rib | ~1: MkUnit | 0.34: Rib }
MkUnit --> when(scope.x > 2.6): Split(X) { ~1: MkWindow | 1.2: MkMaw }
    | else: MkWindow
MkWindow --> Split(Y) { PlinthH: Wall | ~1: ShopGlazing }
MkMaw --> Split(Y) { StepH: Step | ~1: MkLeaf }
MkLeaf --> Extrude(WallD - 0.18) Mat("Flesh") I("Door")
// The bolster: a deep fleshy roll along the whole front, a canopy grown.
Bolster --> Extrude(WallD + 1.4) Split(Z) { WallD - 0.1: RollBack | ~1: BolsterTube }
BolsterTube --> Translate(scope.x, 0, 0) Rotate(0.70710678, 0, 0, 0.70710678)
    Size(scope.y, scope.x, scope.z) Mat("Flesh") I("Tube")
SporeBand --> Extrude(WallD + 0.08) Mat("Spore") I("Fascia")
MkRearInset --> Split(X) { WallD: NIL | ~1: MkRearIn | WallD: NIL }
MkRearIn --> Translate(0, 0, -WallD) MkRear
MkRear --> Repeat(X, 3.0) { MkRearBay }
MkRearBay --> Split(X) { ~1: Wall | 1.2: MkRearWindow | ~1: Wall }
MkRearWindow --> Split(Y) { 1.6: Wall | 0.8: Glazing | ~1: Wall }
// A brood storey over the stalls: one ribbon of pods between ribs.
MkUpper --> Comp(Faces) { Front: MkUpFrontInset | Back: MkUpFrontInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
MkUpFrontInset --> Split(X) { WallD: NIL | ~1: MkUpFrontIn | WallD: NIL }
MkUpFrontIn --> Translate(0, 0, -WallD) Split(Y) { ~1: MkUpFront | RollH: Roll }
MkUpFront --> Repeat(X, 2.0) { MkUpBay }
MkUpBay --> Split(X) { 0.3: Rib | ~1: MkUpCol }
MkUpCol --> Split(Y) { 0.55: Wall | 1.3: Glazing | 0.18: Brow | ~1: Wall }
// A crown of chitin, then a ribbed carapace along the street.
MkCrown --> Comp(Faces) { Front: MkCrownFace | Back: MkCrownFace | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
MkCrownFace --> Split(X) { WallD: NIL | ~1: MkCrownIn | WallD: NIL }
MkCrownIn --> Translate(0, 0, -WallD) Wall
MkVault --> Split(Y) { 0.2: MkDeck | ~1: MkVaultZone }
MkDeck --> Mat("FleshDark") I("Roof")
MkVaultZone --> Split(X) { 0.2: NIL | ~1: CarapaceBody | 0.2: NIL }
CarapaceBody --> Repeat(X, 2.6) { CarapaceSeg }
CarapaceSeg --> Split(X) { ~1: CarapacePlate | 0.3: CarapaceHoop }
// A carapace plate and its hoop, each laid on its side along the street.
CarapacePlate --> Mat("Carapace") Translate(scope.x, -0.1 - Depth * 0.16 - 0.5, WallD)
    Rotate(0.70710678, 0, 0, 0.70710678) Size(Depth * 0.32 + 1.0, scope.x, Depth - 2 * WallD)
    I("Carapace")
CarapaceHoop --> Mat("Rib") Translate(scope.x, -0.1 - Depth * 0.16 - 0.7, WallD - 0.2)
    Rotate(0.70710678, 0, 0, 0.70710678)
    Size(Depth * 0.32 + 1.4, scope.x, Depth - 2 * WallD + 0.4) I("Hoop")
