// The Mesoamerican theme's detached house (#1600): a painted stucco house
// alone in its garden on a stepped talud. See street_detached.rs for the
// house, and catalogue::items::street for the conventions and for what is
// declared ahead of these rules (Storeys, Trade, Frontage, Depth, GroundH,
// FloorH) and after them (Glazing, ShopGlazing, Wall).

const WallD = 0.45
const PaneSet = 0.16
const StepH = 0.72
const MouldH = 0.16
const RoofH = 1.0
const MerlonH = 0.8
const FriezeH = 0.5
// How far the thatch reaches past the walls: the walls stand this far in
// from the lot's sides, so its eaves keep inside it.
const Eave = 0.6

// -- 1. The house: its walls stand in from the lot, the stucco rolled once --
Lot --> Split(X) { Eave: NIL | ~1: LotRow | Eave: NIL }
LotRow --> Split(Z) { Eave: NIL | ~1: Plot | Eave: NIL }
Plot --> Extrude(GroundH + FloorH * (Storeys - 1) + RoofH) Stucco
Stucco --> 26% Mat("Cream") Massing | 22% Mat("Red") Massing | 20% Mat("Ochre") Massing
    | 16% Mat("Turquoise") Massing | 16% Mat("White") Massing
Massing --> when(Storeys == 1): Split(Y) { GroundH: Ground | RoofH: RoofZone }
    | else: Split(Y) { GroundH: Ground | ~1: Uppers | RoofH: RoofZone }
// A stone moulding tops every storey, the wall's full thickness and proud
// of it: the front's and back's between the sides', which run past the
// corners to meet them.
Mould --> Split(X) { WallD: NIL | ~1: MouldIn | WallD: NIL }
MouldIn --> Translate(0, 0, -WallD) Extrude(WallD + 0.2) Mat("Stone") I("Wall")
SideMould --> Translate(-0.2, 0, -WallD) Size(scope.x + 0.4, scope.y, 0) Extrude(WallD + 0.2)
    Mat("Stone") I("Wall")
Lintel --> Extrude(WallD + 0.08) Mat("Lintel") I("Lintel")

// -- 2. The ground storey: the door on the front, openings all round, and
// the stepped talud round the house's foot --
Ground --> Comp(Faces) { Front: GroundFace | Back: BackFace | Left: SideFace
    | Right: SideFace | Top: NIL | Bottom: Talud }
GroundFace --> Split(Y) { ~1: GroundFrontInset | MouldH: Mould }
GroundFrontInset --> Split(X) { WallD: NIL | ~1: GroundFrontIn | WallD: NIL }
GroundFrontIn --> Translate(0, 0, -WallD) GroundFront
GroundFront --> Split(X) { ~1: Run | 2.2: Entrance | ~1: Run }
// A Repeat floors its count: a run narrower than one bay is one bay.
Run --> when(scope.x > 2.6): Repeat(X, 2.6) { Bay } | else: Bay
Bay --> Split(X) { ~1: Wall | 1.0: WinCol | ~1: Wall }
WinCol --> Split(Y) { 1.15: Wall | 1.3: Glazing | 0.24: Lintel | ~1: Wall }
// The door: up a stone step over the talud, under a timber lintel studded
// with jade.
Entrance --> Split(X) { 0.3: Wall | ~1: EntranceDoor | 0.3: Wall }
EntranceDoor --> Split(Y) { StepH: Step | 1.95: DoorLeaf | 0.26: DoorLintel | ~1: Wall }
Step --> Extrude(WallD + 0.7) Mat("Stone") I("Trim")
DoorLeaf --> Extrude(WallD - 0.2) Mat("Door") I("Door")
DoorLintel --> Split(X) { ~1: Lintel | 0.2: Stud | 0.3: Lintel | 0.2: Stud | ~1: Lintel }
Stud --> Extrude(WallD + 0.14) Mat("Jade") I("Trim")
BackFace --> Split(Y) { ~1: BackInset | MouldH: Mould }
BackInset --> Split(X) { WallD: NIL | ~1: BackIn | WallD: NIL }
BackIn --> Translate(0, 0, -WallD) Split(X) { 0.5: Wall | ~1: Run | 0.5: Wall }
// The sides: their walls run the full depth, turning the corners.
SideFace --> Split(Y) { ~1: SideIn | MouldH: SideMould }
SideIn --> Translate(0, 0, -WallD) Split(X) { 0.6: Wall | ~1: Run | 0.6: Wall }
// The talud: three stone courses round the foot, each set in from the one
// under it, drawn from the house's floor - the bottom face's inward is up,
// so each third of it is moved up and grown out round the house.
Talud --> Split(X) { ~1: Course1 | ~1: Course2 | ~1: Course3 }
Course1 --> Translate(-0.45, -0.45, -0.25) Size(3 * scope.x + 0.9, scope.y + 0.9, 0)
    Extrude(0.23) Mat("Stone") I("Talud")
Course2 --> Translate(-scope.x - 0.3, -0.3, -0.48) Size(3 * scope.x + 0.6, scope.y + 0.6, 0)
    Extrude(0.23) Mat("Stone") I("Talud")
Course3 --> Translate(-2 * scope.x - 0.15, -0.15, -0.7) Size(3 * scope.x + 0.3, scope.y + 0.3, 0)
    Extrude(0.22) Mat("Stone") I("Talud")

// -- 3. The upper storeys: openings over the ground floor's, all round --
Uppers --> Comp(Faces) { Front: UpFace | Back: UpFace | Left: UpSideFace
    | Right: UpSideFace | Top: NIL | Bottom: NIL }
UpFace --> Repeat(Y, FloorH) { UpStorey }
UpStorey --> Split(Y) { ~1: UpInset | MouldH: Mould }
UpInset --> Split(X) { WallD: NIL | ~1: UpIn | WallD: NIL }
UpIn --> Translate(0, 0, -WallD) Split(X) { 0.5: Wall | ~1: UpRun | 0.5: Wall }
UpRun --> when(scope.x > 2.4): Repeat(X, 2.4) { UpBay } | else: UpBay
UpBay --> Split(X) { ~1: Wall | 1.0: UpWinCol | ~1: Wall }
UpWinCol --> Split(Y) { 0.85: Wall | 1.3: Glazing | 0.24: Lintel | ~1: Wall }
UpSideFace --> Repeat(Y, FloorH) { UpSideStorey }
UpSideStorey --> Split(Y) { ~1: UpSideIn | MouldH: SideMould }
UpSideIn --> Translate(0, 0, -WallD) Split(X) { 0.6: Wall | ~1: UpRun | 0.6: Wall }

// -- 4. The roof: a merloned parapet over a painted frieze, or a steep
// palm-thatch hip, its eaves out to the lot's edges --
RoofZone --> Pick("roof") { 60% Crown | 40% Thatch }
Thatch --> Roof(Hip, 40, overhang=Eave) { Slope: Palm }
Palm --> Mat("Thatch") I("Roof")
// The parapet: a frieze band proud of every face, the roof beams' ends
// standing out under it, stepped merlons on its top and the deck inside.
Crown --> Comp(Faces) { Front: CrownFace | Back: CrownFace | Left: CrownSide
    | Right: CrownSide | Top: NIL | Bottom: Deck }
CrownFace --> Split(Y) { 0.01: VigaSliver | 0.01: FriezeBand | ~1: CrownBand
    | 0.01: MerlonSliver }
CrownBand --> Split(X) { WallD: NIL | ~1: ParapetIn | WallD: NIL }
ParapetIn --> Translate(0, 0, -WallD) Wall
CrownSide --> Split(Y) { 0.01: VigaSliver | 0.01: FriezeBand | ~1: SideParapet
    | 0.01: MerlonSliver }
SideParapet --> Translate(0, 0, -WallD) Wall
// The frieze: painted step-frets, red or jade, a band proud of the
// parapet from a sliver at its foot.
FriezeBand --> Size(scope.x, FriezeH, 0) Extrude(0.08) Pick("frieze") { 60% RedFrieze | 40% JadeFrieze }
RedFrieze --> Mat("Frieze") I("Frieze")
JadeFrieze --> Mat("FriezeJade") I("Frieze")
// The vigas: squared roof beams a hand apart, out of the wall under the
// moulding that tops the storey under the parapet.
VigaSliver --> Translate(0, -0.42, -0.25) Size(scope.x, 0.2, 0) Extrude(0.7)
    Split(X) { 0.6: NIL | ~1: VigaRow | 0.6: NIL }
VigaRow --> Repeat(X, 0.95) { VigaSlot }
VigaSlot --> Split(X) { ~1: NIL | 0.2: Viga | ~1: NIL }
Viga --> Mat("Lintel") I("Beam")
// The merlons stand on the parapet's top, from a sliver of its face.
MerlonSliver --> Translate(0, 0.01, -WallD) Size(scope.x, MerlonH, 0) Extrude(WallD)
    Split(X) { WallD: NIL | ~1: MerlonRow | WallD: NIL }
MerlonRow --> Repeat(X, 1.3) { MerlonSlot }
MerlonSlot --> Split(X) { 0.18: NIL | ~1: Merlon | 0.18: NIL }
Merlon --> Mat("Stone") Split(Y) { 0.4: MerlonBase | ~1: MerlonTop }
MerlonBase --> I("Merlon")
MerlonTop --> Size(scope.x * 0.5, scope.y, scope.z) Center(X) I("Merlon")
// The deck fills the ring inside the parapet's walls, 2 cm clear of its
// foot: the bottom face's inward is up.
Deck --> Translate(WallD, WallD, -0.22) Size(scope.x - 2 * WallD, scope.y - 2 * WallD, 0)
    Extrude(0.2) Mat("Deck") I("Roof")
