// The cyberpunk theme's hall (#1600): a drone depot, or - where it trades -
// a neon-lit megastore. See street_hall.rs for the hall, and
// catalogue::items::street for the conventions and for what is declared
// ahead of these rules (Storeys, Trade, Frontage, Depth, GroundH, FloorH)
// and after them (Glazing, ShopGlazing, Wall).

const WallD = 0.3
const PaneSet = 0.12
const StepH = 0.5
const NeonH = 0.12
const ParapetH = 1.2
// The rooftop's zone over the parapet: a store's billboard, a depot's
// landing pads.
const TopH = 5.0

// -- 1. The hall: its skin rolled once, then storeys, parapet, rooftop --
Lot --> Extrude(GroundH + FloorH * (Storeys - 1) + ParapetH + TopH) Skin
Skin --> when(Trade == 1): StoreSkin | else: DepotSkin
StoreSkin --> 60% Mat("Metal") Massing | 40% Mat("Gunmetal") Massing
DepotSkin --> 35% Mat("BoxGrey") Massing | 25% Mat("BoxBlue") Massing
    | 20% Mat("Metal") Massing | 20% Mat("BoxRust") Massing
Massing --> when(Storeys == 1): Split(Y) { GroundH: Ground | ParapetH: Crown | TopH: RoofTop }
    | else: Split(Y) { GroundH: Ground | ~1: Upper | ParapetH: Crown | TopH: RoofTop }
// Party walls: the sides, the full depth, turning the corners. A hall's
// ends are its skin, blank.
PartyIn --> Translate(0, 0, -WallD) Wall
// A band of the skin, the facade's full width.
CapBand --> Split(X) { WallD: NIL | ~1: CapIn | WallD: NIL }
CapIn --> Translate(0, 0, -WallD) Wall
Nothing --> NIL

// -- The hall's neon, Picked once: a part names its kind --
Neon(k) --> Pick("neon") { 30% NeonCyan(k) | 30% NeonMagenta(k) | 20% NeonLime(k)
    | 20% NeonAmber(k) }
NeonCyan(k) --> Mat("NeonCyan") NeonPart(k)
NeonMagenta(k) --> Mat("NeonMagenta") NeonPart(k)
NeonLime(k) --> Mat("NeonLime") NeonPart(k)
NeonAmber(k) --> Mat("NeonAmber") NeonPart(k)
NeonPart(k) --> when(k == 1): Tube | when(k == 2): PadRing | else: Bare
// A tube along a floor line, cut from the full face: a row's tubes meet.
Tube --> Extrude(0.1) I("Neon")
Bare --> I("Neon")
PadRing --> Size(scope.x, 0.5, scope.z) I("Neon")
// A holo panel: each its own colour.
Holo --> 35% Mat("HoloCyan") HoloSign | 35% Mat("HoloMagenta") HoloSign
    | 30% Mat("HoloAmber") HoloSign
HoloSign --> Extrude(WallD + 0.1) I("Sign")
Step --> Extrude(WallD + 0.35) Mat("Steel") I("Trim")
DoorLeaf --> Extrude(WallD - 0.12) Mat("Door") I("Door")
Ribbon --> Repeat(X, 3.0) { RibbonBay }
RibbonBay --> Split(X) { 0.3: Wall | ~1: Glazing | 0.3: Wall }

// -- 2. The ground storey: a depot's roller doors, or a store's front --
Ground --> Comp(Faces) { Front: GroundFace | Back: BackInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
GroundFace --> when(Trade == 1): StoreFace | else: DepotFace
// The depot: a door for people at one end, bays of roller doors in hazard
// frames along the rest, a ribbon of slot windows over them, and a tube.
DepotFace --> Split(Y) { ~1: DepotInset | NeonH: Neon(1) | 0.3: CapBand }
DepotInset --> Split(X) { WallD: NIL | ~1: DepotIn | WallD: NIL }
DepotIn --> Translate(0, 0, -WallD) DepotFront
DepotFront --> Split(Y) { ~1: DepotDoors | 0.9: Ribbon | 0.3: Wall }
DepotDoors --> Split(X) { 1.4: Wall | 1.1: ManDoor | 1.2: Wall | ~1: DoorRun | 1.4: Wall }
ManDoor --> Split(Y) { StepH: Step | 2.2: DoorLeaf | ~1: Wall }
DoorRun --> Repeat(X, 7.5) { DoorBay }
DoorBay --> 65% Split(X) { ~1: Wall | 0.3: Jamb | 4.2: RollerCol | 0.3: Jamb | ~1: Wall }
    | 35% Wall
Jamb --> Split(Y) { 0.45: Wall | 4.0: Hazard | ~1: Wall }
Hazard --> Extrude(WallD + 0.1) Mat("Hazard") I("Trim")
// A roller door over its concrete apron, steel or grille, under a hazard
// lintel: the sink buries all of the apron but its top.
RollerCol --> Split(Y) { 0.45: Apron | 4.0: Roller | 0.25: Hazard | ~1: Wall }
Apron --> Extrude(WallD + 1.4) Mat("Concrete") I("Trim")
Roller --> 55% Extrude(WallD - 0.1) Mat("Roller") I("Door")
    | 45% Extrude(WallD - 0.1) Mat("Grille") I("Grille")
// The store: a glazed entrance under a lit canopy between slot windows,
// a tube over them, and a holo band the length of the front.
StoreFace --> Split(Y) { 4.0: StoreInset | NeonH: Neon(1) | ~1: HoloBand }
StoreInset --> Split(X) { WallD: NIL | ~1: StoreIn | WallD: NIL }
StoreIn --> Translate(0, 0, -WallD) StoreFront
StoreFront --> when(scope.x < 30): Split(X) { ~1: StoreSide | 6.4: Entrance | ~1: StoreSide }
    | else: Split(X) { ~3: StoreSide | ~2: Entrance | ~3: StoreSide }
StoreSide --> Split(Y) { ~1: Wall | 1.0: Ribbon | 0.5: Wall }
Entrance --> Split(Y) { 0.5: Plinth | 2.8: Entry | 0.25: Canopy | ~1: Wall }
Plinth --> Extrude(WallD + 0.05) Mat("Concrete") I("Trim")
Entry --> Split(X) { ~1: ShopRun | 2.4: GlassDoor | ~1: ShopRun }
ShopRun --> when(scope.x > 2.4): Repeat(X, 2.4) { ShopBay } | else: ShopBay
ShopBay --> Split(X) { 0.12: Wall | ~1: ShopGlazing | 0.12: Wall }
GlassDoor --> Extrude(WallD - 0.1) Mat("Door") I("Door")
Canopy --> Extrude(WallD + 1.8) Mat("Steel") Split(Z) { ~1: CanopyDeck | 0.1: Neon(3) }
CanopyDeck --> I("Canopy")
HoloBand --> Split(X) { WallD: NIL | ~1: HoloIn | WallD: NIL }
HoloIn --> Translate(0, 0, -WallD) Repeat(X, 4.0) { HoloPanel }
HoloPanel --> Split(X) { 0.2: Wall | ~1: HoloRow | 0.2: Wall }
HoloRow --> Split(Y) { 0.3: Wall | ~1: Holo | 0.3: Wall }
// The yard side: loading doors, the ribbon over them.
BackInset --> Split(X) { WallD: NIL | ~1: BackIn | WallD: NIL }
BackIn --> Translate(0, 0, -WallD) BackFace
BackFace --> Split(Y) { ~1: BackDoors | 0.9: Ribbon | 0.3: Wall }
BackDoors --> Split(X) { 1.4: Wall | ~1: BackRun | 1.4: Wall }
BackRun --> Repeat(X, 12.0) { DoorBay }

// -- 3. An upper storey: a control floor, a ribbon front and back --
Upper --> Comp(Faces) { Front: UpFace | Back: UpFace | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
UpFace --> Split(Y) { ~1: UpInset | NeonH: Neon(1) | 0.3: CapBand }
UpInset --> Split(X) { WallD: NIL | ~1: UpIn | WallD: NIL }
UpIn --> Translate(0, 0, -WallD) UpRow
UpRow --> Split(Y) { ~1: Wall | 1.3: Ribbon | 0.8: Wall }

// -- 4. The roof: a deck behind a parapet, or a depot's sawtooth --
Crown --> when(Trade == 1): Parapet | else: DepotRoof
DepotRoof --> Pick("roof") { 55% Parapet | 45% Sawtooth }
Parapet --> Comp(Faces) { Front: ParapetFront | Back: ParapetFace | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: Deck }
ParapetFront --> when(Trade == 1): Split(Y) { ~1: ParapetInset | NeonH: Neon(1) | 0.14: Coping }
    | else: ParapetFace
ParapetFace --> Split(Y) { ~1: ParapetInset | 0.14: Coping }
ParapetInset --> Split(X) { WallD: NIL | ~1: ParapetIn | WallD: NIL }
ParapetIn --> Translate(0, 0, -WallD) Wall
Coping --> Extrude(0.06) Mat("Steel") I("Trim")
// The deck fills the ring inside the parapet's walls: the bottom face's
// inward is up.
Deck --> Translate(WallD, WallD, -0.2) Size(scope.x - 2 * WallD, scope.y - 2 * WallD, 0)
    Extrude(0.2) Mat("Deck") I("Roof")
// Teeth along the street, each its slope and its glazed north light.
Sawtooth --> Repeat(Z, 8.0) { Tooth }
Tooth --> Roof(Shed, 22, overhang=0) { Slope: Sheet | Back: NorthLight | GableEnd: ToothEnd }
Sheet --> Mat("Gunmetal") I("Roof")
ToothEnd --> I("Wall")
NorthLight --> Repeat(X, 2.4) { NorthPane }
NorthPane --> Mat("Glass") I("Pane")

// -- 5. The rooftop, standing on the deck: a store's billboard toward the
// street, a depot's landing pads ringed in neon --
RoofTop --> Translate(0, 0.2 - ParapetH, 0) Size(scope.x, scope.y + ParapetH - 0.2, scope.z)
    RoofGear
RoofGear --> when(Trade == 1): StoreTop | else: DepotTop
DepotTop --> Pick("roof") { 55% PadDeck | 45% Nothing }
PadDeck --> Split(Z) { WallD + 0.6: NIL | ~1: PadRow | WallD + 0.6: NIL }
PadRow --> Repeat(X, 14.0) { PadBay }
PadBay --> Split(X) { ~1: NIL | 9.0: PadCol | ~1: NIL }
PadCol --> Split(Z) { ~1: NIL | 9.0: Pad | ~1: NIL }
Pad --> Split(X) { 0.25: PadEdge | ~1: PadMid | 0.25: PadEdge }
PadMid --> Split(Z) { 0.25: PadEdge | ~1: PadCore | 0.25: PadEdge }
PadEdge --> Neon(2)
PadCore --> Size(scope.x, 0.45, scope.z) Mat("Pad") I("Pad")
StoreTop --> Split(Z) { WallD + 0.3: NIL | 0.5: BoardRow | ~1: NIL }
BoardRow --> when(scope.x > 40): Split(X) { ~1: NIL | 24.0: Billboard | ~1: NIL }
    | else: Split(X) { ~1: NIL | ~4: Billboard | ~1: NIL }
Billboard --> Split(Y) { 1.2: Legs | 3.4: Board | ~1: NIL }
Legs --> Repeat(X, 4.0) { LegBay }
LegBay --> Split(X) { ~1: NIL | 0.2: Leg | ~1: NIL }
Leg --> Mat("Steel") I("Trim")
Board --> Split(Z) { 0.06: Screen | ~1: BoardBack }
// The screen: two lit panels, each its own colour, in a dark frame.
Screen --> Split(Y) { 0.2: BoardBack | ~1: ScreenArt | 0.2: BoardBack }
ScreenArt --> Split(X) { 0.2: BoardBack | ~2: ScreenLit | 0.15: BoardBack | ~1: ScreenLit
    | 0.2: BoardBack }
ScreenLit --> 35% Mat("HoloMagenta") I("Billboard") | 35% Mat("HoloCyan") I("Billboard")
    | 30% Mat("HoloAmber") I("Billboard")
BoardBack --> Mat("Metal") I("Billboard")
