// The cyberpunk theme's long block (#1598): a neon megablock slab. See
// street_block.rs for the block, and catalogue::items::street for the
// conventions and for what is declared ahead of these rules and after them.

const WallD = 0.36
const PaneSet = 0.14
const PlinthH = 0.6
const StepH = 0.5
const NeonH = 0.12
const JointH = 0.08
const ParapetH = 1.0
const RoofH = 7.0
// One stair to a section, as a slab is built. Under twelve metres so the
// frontages, less the party walls, hold two, three and four of them: a
// Repeat floors its count.
const SectionW = 11.5

// -- 1. The block: its skin rolled once, then arcade, storeys, parapet --
Lot --> Extrude(GroundH + FloorH * (Storeys - 1) + ParapetH + RoofH) Skin
Skin --> 35% Mat("Concrete") Massing | 25% Mat("Stained") Massing
    | 25% Mat("Metal") Massing | 15% Mat("Gunmetal") Massing
Massing --> Split(Y) { GroundH: Ground | ~1: Uppers | ParapetH: Parapet | RoofH: RoofTop }
// Party walls: the sides, the full depth, turning the corners.
PartyIn --> Translate(0, 0, -WallD) Wall

// -- The block's neon, Picked once: a part names its kind --
Neon(k) --> Pick("neon") { 30% NeonCyan(k) | 30% NeonMagenta(k) | 20% NeonLime(k)
    | 20% NeonAmber(k) }
NeonCyan(k) --> Mat("NeonCyan") NeonPart(k)
NeonMagenta(k) --> Mat("NeonMagenta") NeonPart(k)
NeonLime(k) --> Mat("NeonLime") NeonPart(k)
NeonAmber(k) --> Mat("NeonAmber") NeonPart(k)
NeonPart(k) --> when(k == 1): Tube | when(k == 2): RailTube | else: DoorTube
// A band along a floor line, cut from the full face: a row's bands meet.
Tube --> Extrude(0.1) I("Neon")
RailTube --> I("Neon")
DoorTube --> Extrude(WallD + 0.08) I("Neon")
Holo --> 35% Mat("HoloCyan") HoloSign | 35% Mat("HoloMagenta") HoloSign
    | 30% Mat("HoloAmber") HoloSign
HoloSign --> Extrude(WallD + 0.12) I("Sign")
GrilleShut --> Extrude(WallD + 0.04) Mat("Grille") I("Grille")

// -- 2. The arcade: shops under holo signs, or grilled flats, and a lit
// doorway to each stair --
Ground --> Mat("Stained") Comp(Faces) { Front: GroundFace | Back: RearGroundInset
    | Left: PartyIn | Right: PartyIn | Top: NIL | Bottom: NIL }
GroundFace --> Split(Y) { ~1: GroundFrontInset | NeonH: Neon(1) }
GroundFrontInset --> Split(X) { WallD: NIL | ~1: GroundFrontIn | WallD: NIL }
GroundFrontIn --> Translate(0, 0, -WallD) GroundFront
GroundFront --> Repeat(X, SectionW) { GroundSection }
GroundSection --> Split(X) { ~1: GroundRun | 2.4: Doorway | ~1: GroundRun }
GroundRun --> when(Trade == 1): ShopRun | else: FlatRun
ShopRun --> Repeat(X, 3.4) { ShopBay }
ShopBay --> Split(X) { 0.3: Wall | ~1: ShopWindow | 0.3: Wall }
ShopWindow --> Split(Y) { PlinthH: Wall | ~1: ShopGlazing | 0.12: Wall | 0.8: Holo
    | 0.2: Wall }
FlatRun --> Repeat(X, 2.9) { FlatBay }
FlatBay --> Split(X) { ~1: Wall | 1.5: FlatWindow | ~1: Wall }
FlatWindow --> Split(Y) { 1.3: Wall | 1.0: Glazing | 0.8: GrilleShut | ~1: Wall }
Doorway --> Split(X) { 0.25: Wall | ~1: DoorCol | 0.25: Wall }
DoorCol --> Split(Y) { StepH: Step | 2.3: DoorLeaf | NeonH: Neon(3) | 0.2: Canopy
    | ~1: Glazing }
Step --> Extrude(WallD + 0.35) Mat("Steel") I("Trim")
DoorLeaf --> Extrude(WallD - 0.18) Mat("Door") I("Door")
Canopy --> Extrude(WallD + 1.2) Mat("Steel") I("Canopy")
RearGroundInset --> Split(X) { WallD: NIL | ~1: RearGroundIn | WallD: NIL }
RearGroundIn --> Translate(0, 0, -WallD) RearGround
RearGround --> Repeat(X, 4.2) { RearBay }
RearBay --> Split(X) { ~1: Wall | 1.4: RearWindow | ~1: Wall }
RearWindow --> Split(Y) { 1.3: Wall | 1.4: Glazing | ~1: Wall }

// -- 3. The storeys: a neon band at every other floor line, panel joints
// at the rest, AC boxes, slit windows up each stair and capsule balconies
// at the ends of each section's runs where the block has them --
Uppers --> Comp(Faces) { Front: UpperFace | Back: RearUpperInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
UpperFace --> Repeat(Y, FloorH) { StoreyFace }
StoreyFace --> when(split.i % 2 == 1): Split(Y) { ~1: StoreyInset | NeonH: Neon(1) }
    | else: StoreyInset
StoreyInset --> Split(X) { WallD: NIL | ~1: StoreyIn | WallD: NIL }
StoreyIn --> Translate(0, 0, -WallD) Split(Y) { ~1: Band | JointH: Joint }
Joint --> Extrude(WallD - 0.03) Mat("Gunmetal") I("Wall")
Band --> Repeat(X, SectionW) { Section }
Section --> Split(X) { ~1: Run | 2.4: StairCol | ~1: Run }
Run --> when(split.i == 0): Split(X) { ~1: OuterBay | ~1: WinBay }
    | else: Split(X) { ~1: WinBay | ~1: OuterBay }
OuterBay --> Pick("capsules") { 55% CapsuleBay | 45% WinBay }
WinBay --> Split(X) { ~1: Wall | 1.6: WinCol | ~1: Wall }
WinCol --> Split(Y) { 0.9: Below | 1.4: Glazing | ~1: Wall }
// Under some windows an AC box hangs.
Below --> 25% Split(X) { 0.15: Wall | ~1: ACCol | 0.15: Wall } | 75% Wall
ACCol --> Split(Y) { 0.4: Wall | 0.4: ACBox | ~1: Wall }
ACBox --> Extrude(WallD + 0.5) Mat("AC") I("AC")
// A stair: a slit window high in the band.
StairCol --> Split(X) { ~1: Wall | 0.5: StairWin | ~1: Wall }
StairWin --> Split(Y) { ~1: Wall | 1.6: Glazing | 0.3: Wall }
// A capsule balcony: a pod's floor and hood in light metal, a lit rail.
CapsuleBay --> Split(X) { 0.2: Wall | ~1: CapsuleCol | 0.2: Wall }
CapsuleCol --> Split(Y) { 0.18: PodShell | 0.9: PodRail | 1.4: Glazing | 0.18: PodShell
    | ~1: Wall }
PodShell --> Extrude(WallD + 1.2) Mat("Capsule") I("Balcony")
PodRail --> Extrude(WallD + 1.2) Split(Z) { WallD: PodWall | ~1: NIL | 0.08: PodFront }
PodFront --> Split(Y) { ~1: PodPanel | 0.1: Neon(2) }
PodPanel --> Mat("Capsule") I("Balcony")
PodWall --> I("Wall")
RearUpperInset --> Split(X) { WallD: NIL | ~1: RearUpperIn | WallD: NIL }
RearUpperIn --> Translate(0, 0, -WallD) RearUpper
RearUpper --> Repeat(Y, FloorH) { RearStorey }
RearStorey --> Split(Y) { 0.8: Wall | 1.4: RearRow | ~1: Wall }
RearRow --> Repeat(X, 4.2) { RearUpperBay }
RearUpperBay --> Split(X) { ~1: Wall | 1.6: Glazing | ~1: Wall }

// -- 4. The parapet: a neon line under its coping, the deck inside --
Parapet --> Comp(Faces) { Front: ParapetFace | Back: ParapetBack | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: Deck }
ParapetFace --> Split(Y) { ~1: ParapetInset | NeonH: Neon(1) | 0.14: Coping }
ParapetBack --> Split(Y) { ~1: ParapetInset | 0.14: Coping }
ParapetInset --> Split(X) { WallD: NIL | ~1: ParapetIn | WallD: NIL }
ParapetIn --> Translate(0, 0, -WallD) Wall
Coping --> Extrude(0.06) Mat("Steel") I("Trim")
// The deck fills the ring inside the parapet's walls: the bottom face's
// inward is up.
Deck --> Translate(WallD, WallD, -0.2) Size(scope.x - 2 * WallD, scope.y - 2 * WallD, 0)
    Extrude(0.2) Mat("Deck") I("Roof")

// -- 5. The roof: a billboard toward the street, a mast over each stair --
RoofTop --> Translate(0, 0.2 - ParapetH, 0) Size(scope.x, scope.y + ParapetH - 0.2, scope.z)
    Split(Z) { WallD + 0.3: NIL | 0.4: BoardRow | ~1: NIL | 0.25: MastRow | 0.9: NIL }
BoardRow --> Split(X) { ~1: NIL | ~1.6: Billboard | ~1: NIL }
Billboard --> Split(Y) { 1.4: Legs | 4.0: Board | ~1: NIL }
Legs --> Repeat(X, 3.0) { LegBay }
LegBay --> Split(X) { ~1: NIL | 0.2: Leg | ~1: NIL }
Leg --> Mat("Steel") I("Trim")
Board --> Split(Z) { 0.06: Screen | ~1: BoardBack }
// The screen: lit panels, each its own colour, in a dark frame.
Screen --> Split(Y) { 0.25: BoardBack | ~1: ScreenArt | 0.25: BoardBack }
ScreenArt --> Split(X) { 0.25: BoardBack | ~2: ScreenLit | 0.2: BoardBack | ~1: ScreenLit
    | 0.2: BoardBack | ~1.4: ScreenLit | 0.25: BoardBack }
ScreenLit --> 35% Mat("HoloMagenta") I("Billboard") | 35% Mat("HoloCyan") I("Billboard")
    | 30% Mat("HoloAmber") I("Billboard")
BoardBack --> Mat("Metal") I("Billboard")
MastRow --> Repeat(X, SectionW) { MastSeg }
MastSeg --> Split(X) { ~1: NIL | 0.25: Mast | ~1: NIL }
Mast --> Split(Y) { 6.4: MastStem | ~1: NIL }
MastStem --> Mat("Steel") I("Mast")
