// The cyberpunk theme's low building (#1598): a row of container homes,
// or - where it trades - a noodle bar's stalls. See street_low.rs for the
// building, and catalogue::items::street for the conventions and for what
// is declared ahead of these rules and after them.

const WallD = 0.3
const PaneSet = 0.1
const StepH = 0.5
const NeonH = 0.1
const WalkH = 0.12
const WalkD = 1.1
const TopH = 0.3
const ParapetH = 0.8
// A container's width along the street: a lot holds as many as fit.
const BoxW = 3.0

Lot --> when(Trade == 1): Stalls | else: Boxes
// Party walls: the sides, the full depth, turning the corners.
PartyIn --> Translate(0, 0, -WallD) Wall
Step --> Extrude(WallD + 0.3) Mat("Steel") I("Trim")
DoorLeaf --> Extrude(WallD - 0.12) Mat("Door") I("Door")
// A neon in a box's or a stall's own colour.
Neon --> 30% Mat("NeonCyan") Tube | 30% Mat("NeonMagenta") Tube | 20% Mat("NeonLime") Tube
    | 20% Mat("NeonAmber") Tube
Tube --> Extrude(WallD + 0.06) I("Neon")
Holo --> 35% Mat("HoloCyan") HoloSign | 35% Mat("HoloMagenta") HoloSign
    | 30% Mat("HoloAmber") HoloSign
HoloSign --> Extrude(WallD + 0.12) I("Sign")

// -- 1. The containers: box after box, each its own colour --
Boxes --> Extrude(GroundH + FloorH * (Storeys - 1) + TopH) Mat("Metal") BoxMass
BoxMass --> when(Storeys == 1): Split(Y) { GroundH: BoxGround | TopH: BoxTop }
    | else: Split(Y) { GroundH: BoxGround | ~1: BoxUpper | TopH: BoxTop }
BoxGround --> Comp(Faces) { Front: BoxFrontInset | Back: RearInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
BoxFrontInset --> Split(X) { WallD: NIL | ~1: BoxFrontIn | WallD: NIL }
BoxFrontIn --> Translate(0, 0, -WallD) Repeat(X, BoxW) { Box }
Box --> 30% Mat("BoxBlue") BoxFace | 30% Mat("BoxRust") BoxFace
    | 20% Mat("BoxTeal") BoxFace | 20% Mat("BoxGrey") BoxFace
// Each box: its corner posts, a door under a neon strip, a lit window.
BoxFace --> Split(X) { 0.15: BoxRib | ~1: Wall | 1.0: BoxDoor | 0.25: Wall | 1.0: BoxWin
    | ~1: Wall | 0.15: BoxRib }
BoxRib --> Extrude(WallD + 0.08) Mat("Steel") I("Trim")
BoxDoor --> Split(Y) { StepH: Step | 2.1: DoorLeaf | 0.1: Wall | NeonH: Neon | ~1: Wall }
BoxWin --> Split(Y) { 1.0: Wall | 1.1: Glazing | ~1: Wall }
RearInset --> Split(X) { WallD: NIL | ~1: RearIn | WallD: NIL }
RearIn --> Translate(0, 0, -WallD) Repeat(X, BoxW) { RearBay }
RearBay --> Split(X) { ~1: Wall | 1.0: RearWindow | ~1: Wall }
RearWindow --> Split(Y) { 1.2: Wall | 0.9: Glazing | ~1: Wall }
// A second row of boxes over the first, a catwalk along their fronts: a
// walk and a rail before the windows, the walk alone before the doors.
BoxUpper --> Comp(Faces) { Front: UpFrontInset | Back: UpRearInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
UpFrontInset --> Split(X) { WallD: NIL | ~1: UpFrontIn | WallD: NIL }
UpFrontIn --> Translate(0, 0, -WallD) Repeat(X, BoxW) { UpBox }
UpBox --> 30% Mat("BoxBlue") UpFace | 30% Mat("BoxRust") UpFace
    | 20% Mat("BoxTeal") UpFace | 20% Mat("BoxGrey") UpFace
UpFace --> Split(X) { 0.15: UpRib | ~1: UpWallCol | 1.0: UpDoorCol | 0.25: UpWallCol
    | 1.0: UpWinCol | ~1: UpWallCol | 0.15: UpRib }
UpRib --> Split(Y) { WalkH: Walk | ~1: BoxRib }
UpWallCol --> Split(Y) { WalkH: Walk | 1.0: RailZone | ~1: Wall }
UpDoorCol --> Split(Y) { WalkH: Walk | 2.1: DoorLeaf | 0.1: Wall | NeonH: Neon | ~1: Wall }
UpWinCol --> Split(Y) { WalkH: Walk | 1.0: RailZone | 1.1: Glazing | ~1: Wall }
Walk --> Extrude(WallD + WalkD) Mat("Steel") I("Walk")
RailZone --> Extrude(WallD + WalkD) Split(Z) { WallD: RailWall | ~1: NIL | 0.05: Rail }
RailWall --> I("Wall")
Rail --> Mat("Grille") I("Rail")
UpRearInset --> Split(X) { WallD: NIL | ~1: UpRearIn | WallD: NIL }
UpRearIn --> Translate(0, 0, -WallD) Repeat(X, BoxW) { UpRearBay }
UpRearBay --> Split(X) { ~1: Wall | 1.0: UpRearWindow | ~1: Wall }
UpRearWindow --> Split(Y) { 0.9: Wall | 0.9: Glazing | ~1: Wall }
// The boxes' lids: one steel slab over the row.
BoxTop --> Size(scope.x, 0.2, scope.z) Mat("Steel") I("Roof")

// -- 2. The noodle bar: counters under a lit awning, lanterns, holo signs --
Stalls --> Extrude(GroundH + FloorH * (Storeys - 1) + ParapetH) Mat("Metal") StallMass
StallMass --> when(Storeys == 1): Split(Y) { GroundH: StallGround | ParapetH: Parapet }
    | else: Split(Y) { GroundH: StallGround | ~1: BoxUpper | ParapetH: Parapet }
StallGround --> Comp(Faces) { Front: StallFace | Back: RearInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
StallFace --> Split(Y) { ~1: StallInset | 0.15: Awning | 0.75: SignInset }
// The awning: a tarp with a neon tube along its edge.
Awning --> Extrude(1.6) Split(Z) { ~1: AwningTarp | 0.08: AwningEdge }
AwningTarp --> Mat("Tarp") I("Awning")
AwningEdge --> 30% Mat("NeonCyan") I("Neon") | 30% Mat("NeonMagenta") I("Neon")
    | 20% Mat("NeonLime") I("Neon") | 20% Mat("NeonAmber") I("Neon")
StallInset --> Split(X) { WallD: NIL | ~1: StallIn | WallD: NIL }
StallIn --> Translate(0, 0, -WallD) Split(X) { ~1: StallRun | 1.2: StallDoor | ~1: StallRun }
StallRun --> Repeat(X, 2.4) { Stall }
// A stall: a lantern hung from the awning at each edge, a counter under its
// window, its grille shutter rolled up.
Stall --> Split(X) { 0.25: LanternStrip | ~1: StallUnit | 0.25: LanternStrip }
LanternStrip --> Extrude(WallD + 1.5) Split(Z) { WallD: RailWall | ~1: NIL | 0.25: LanternCol }
LanternCol --> Split(Y) { ~1: NIL | 0.4: Lantern }
Lantern --> Mat("Lantern") I("Lantern")
StallUnit --> Split(Y) { 0.95: Wall | 0.1: Counter | ~1: ShopGlazing | 0.45: Shutter }
Counter --> Extrude(WallD + 0.5) Mat("Counter") I("Counter")
Shutter --> Extrude(WallD + 0.12) Mat("Grille") I("Shutter")
StallDoor --> Split(Y) { StepH: Step | 2.1: DoorLeaf | ~1: Wall }
// The signs: one over each stall, each its own colour.
SignInset --> Split(X) { WallD: NIL | ~1: SignIn | WallD: NIL }
SignIn --> Translate(0, 0, -WallD) Repeat(X, 3.0) { SignBay }
SignBay --> Split(X) { 0.2: Wall | ~1: SignBand | 0.2: Wall }
SignBand --> Split(Y) { 0.1: Wall | ~1: Holo | 0.1: Wall }
// The parapet, a neon line along its coping, and the deck inside it.
Parapet --> Comp(Faces) { Front: ParapetFace | Back: ParapetInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: Deck }
ParapetFace --> Split(Y) { ~1: ParapetInset | 0.12: Coping }
ParapetInset --> Split(X) { WallD: NIL | ~1: ParapetIn | WallD: NIL }
ParapetIn --> Translate(0, 0, -WallD) Wall
Coping --> Extrude(0.06) Mat("Steel") I("Trim")
Deck --> Translate(WallD, WallD, -0.2) Size(scope.x - 2 * WallD, scope.y - 2 * WallD, 0)
    Extrude(0.2) Mat("Deck") I("Roof")
