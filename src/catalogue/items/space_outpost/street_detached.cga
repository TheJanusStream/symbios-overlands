// The outpost's detached house (#1600): a crew's hab pod on its own plot.
// See street_detached.rs for the pod, and catalogue::items::street for the
// conventions and for what is declared ahead of these rules (Storeys,
// Trade, Frontage, Depth, GroundH, FloorH) and after them (Glazing,
// ShopGlazing, Wall).

const WallD = 0.4
const PaneSet = 0.14
const StepH = 0.5
const RingH = 0.3
const RoofH = 1.0
// How far the pod stands in from the lot's sides.
const Eave = 0.5

// -- 1. The pod: it stands in from the lot, its livery rolled once --
Lot --> Split(X) { Eave: NIL | ~1: LotRow | Eave: NIL }
LotRow --> Split(Z) { Eave: NIL | ~1: Plot | Eave: NIL }
Plot --> Extrude(GroundH + FloorH * (Storeys - 1) + RoofH) Livery
Livery --> 30% Mat("HullWhite") Massing | 25% Mat("HullGrey") Massing
    | 25% Mat("HullSand") Massing | 20% Mat("HullBlue") Massing
Massing --> when(Storeys == 1): Split(Y) { GroundH: Ground | RoofH: RoofZone }
    | else: Split(Y) { GroundH: Ground | ~1: Uppers | RoofH: RoofZone }
// A steel ring frame round the pod at the top of every storey, on every
// face, the wall's own top course behind it; and a steel corner frame up
// every corner, cut from the strips each face's inset leaves.
Ring --> Extrude(WallD + 0.14) Split(Z) { WallD: RingWall | ~1: RingSteel }
RingWall --> I("Wall")
RingSteel --> Mat("Steel") I("Ring")
Corner --> Extrude(0.14) Mat("Frame") I("Frame")
// A viewport in its frame: steel jambs, sill and hood round the port.
PortBay --> Split(X) { ~1: Wall | 1.4: PortCol | ~1: Wall }
PortCol --> Split(Y) { 0.9: Wall | 0.14: Sill | 1.5: Port | 0.14: Hood | ~1: Wall }
UpPortBay --> Split(X) { ~1: Wall | 1.4: UpPortCol | ~1: Wall }
UpPortCol --> Split(Y) { 0.3: Wall | 0.14: Sill | 1.4: Port | 0.14: Hood | ~1: Wall }
Port --> Split(X) { 0.14: Jamb | ~1: Glazing | 0.14: Jamb }
Jamb --> Extrude(WallD + 0.08) Mat("Frame") I("Frame")
Sill --> Extrude(WallD + 0.12) Mat("Frame") I("Frame")
Hood --> Extrude(WallD + 0.16) Mat("Frame") I("Frame")

// -- 2. The entry deck: the airlock on the front, ports all round --
Ground --> Comp(Faces) { Front: GroundFace | Back: GroundRound | Left: GroundRound
    | Right: GroundRound | Top: NIL | Bottom: NIL }
GroundFace --> Split(X) { WallD: Corner | ~1: GroundMid | WallD: Corner }
GroundMid --> Translate(0, 0, -WallD) Split(Y) { ~1: GroundFront | RingH: Ring }
GroundFront --> Split(X) { ~1: PortRun | 2.6: Airlock | ~1.3: PortRun }
PortRun --> when(scope.x > 2.6): Repeat(X, 2.6) { PortBay } | else: PortBay
// The airlock: a hatch in hazard-striped jambs, a status lamp over it.
Airlock --> Split(X) { 0.2: Wall | 0.22: HazJamb | ~1: AirCol | 0.22: HazJamb | 0.2: Wall }
HazJamb --> Split(Y) { StepH: Wall | ~1: Stripes | 0.4: Wall }
Stripes --> Repeat(Y, 0.5) { Stripe }
Stripe --> Split(Y) { ~1: StripeY | ~1: StripeD }
StripeY --> Extrude(WallD + 0.08) Mat("Hazard") I("Trim")
StripeD --> Extrude(WallD + 0.08) Mat("HazardDark") I("Trim")
AirCol --> Split(Y) { StepH: Step | 2.1: Hatch | 0.12: Lintel | 0.26: LampRow | ~1: Wall }
// A grated step, standing out of the plating: the sink buries all but
// the top of it, so the hatch starts above the ground.
Step --> Extrude(WallD + 0.4) Mat("Steel") I("Trim")
Hatch --> 40% Mat("HatchGrey") Leaves | 30% Mat("HatchOrange") Leaves
    | 30% Mat("HatchBlue") Leaves
Leaves --> Split(X) { ~1: HatchLeaf | 0.06: HatchSeam | ~1: HatchLeaf }
HatchLeaf --> Extrude(WallD - 0.18) I("Door")
HatchSeam --> Extrude(WallD - 0.24) Mat("HazardDark") I("Door")
Lintel --> Extrude(WallD + 0.1) Mat("Frame") I("Frame")
LampRow --> Split(X) { ~1: Wall | 0.5: Lamp | ~1: Wall }
Lamp --> Extrude(WallD + 0.08) Mat("Status") I("Trim")
// The back and the sides: a port a bay, the sides' plating the full
// depth between their corner frames.
GroundRound --> Split(X) { WallD: Corner | ~1: RoundMid | WallD: Corner }
RoundMid --> Translate(0, 0, -WallD) Split(Y) { ~1: RoundIn | RingH: Ring }
RoundIn --> Split(X) { 0.3: Wall | ~1: PortRun | 0.3: Wall }

// -- 3. The crew decks: a ring at each floor, a livery stripe under the
// ports, all round --
Uppers --> Comp(Faces) { Front: UpFace | Back: UpFace | Left: UpFace
    | Right: UpFace | Top: NIL | Bottom: NIL }
UpFace --> Split(X) { WallD: Corner | ~1: UpMid | WallD: Corner }
UpMid --> Translate(0, 0, -WallD) Repeat(Y, FloorH) { DeckFace }
DeckFace --> Split(Y) { ~1: DeckIn | RingH: Ring }
DeckIn --> Split(Y) { 0.3: LiveryBand | ~1: DeckBody }
DeckBody --> Split(X) { 0.3: Wall | ~1: UpPortRun | 0.3: Wall }
UpPortRun --> when(scope.x > 2.6): Repeat(X, 2.6) { UpPortBay } | else: UpPortBay
// A livery stripe along every deck, its colour picked once a pod.
LiveryBand --> Pick("livery") { 30% StripeOrange | 25% StripeBlue | 20% StripeRed
    | 25% StripeSteel }
StripeOrange --> Mat("LiveryOrange") LiveryStrip
StripeBlue --> Mat("LiveryBlue") LiveryStrip
StripeRed --> Mat("LiveryRed") LiveryStrip
StripeSteel --> Mat("Steel") LiveryStrip
LiveryStrip --> Extrude(WallD + 0.03) I("Trim")

// -- 4. The roof: a deck over the walls, and on it a pressure vault along
// the street or a solar rack and a comms mast --
RoofZone --> Split(Y) { 0.22: DeckSlab | ~1: RoofKit }
DeckSlab --> Mat("Deck") I("Roof")
RoofKit --> Pick("roof") { 55% VaultZone | 45% DeckKit }
// A pressure vault: a hull laid on its side, short of the pod's ends,
// steel hoops along it.
VaultZone --> Split(X) { 0.2: NIL | 0.3: VaultHoop | ~1: VaultRun | 0.2: NIL }
VaultRun --> Repeat(X, 2.4) { VaultSeg }
VaultSeg --> Split(X) { ~1: VaultPlate | 0.3: VaultHoop }
// A plate and a hoop, each laid on its side: its length along the street,
// its centre on the deck, the depth less the walls at each end.
VaultPlate --> Translate(scope.x, -scope.z * 0.18 - 0.4, WallD)
    Rotate(0.70710678, 0, 0, 0.70710678)
    Size(scope.z * 0.36 + 0.8, scope.x, scope.z - 2 * WallD) I("Vault")
VaultHoop --> Translate(scope.x, -scope.z * 0.18 - 0.55, WallD - 0.15)
    Rotate(0.70710678, 0, 0, 0.70710678)
    Size(scope.z * 0.36 + 1.1, scope.x, scope.z - 2 * WallD + 0.3) Mat("Steel") I("Hoop")
// A solar rack and a mast with its beacon, set on the deck.
DeckKit --> Split(Z) { ~1: NIL | ~3: KitRow | ~1: NIL }
KitRow --> Split(X) { ~1: NIL | ~4: SolarRack | ~1: NIL | 0.32: MastFoot | ~1: NIL }
SolarRack --> Split(Y) { 0.3: RackBase | ~1: RackTilt }
RackBase --> Mat("Steel") I("Housing")
RackTilt --> Roof(Shed, 14, overhang=0) { Slope: SolarFace | _: RackSide }
SolarFace --> Mat("Solar") I("Panel")
RackSide --> Mat("Steel") I("Housing")
MastFoot --> Split(Z) { ~1: NIL | 0.32: Mast | ~1: NIL }
Mast --> Size(scope.x, 5.0, scope.z) Split(Y) { ~1: MastPole | 0.4: BeaconLamp }
MastPole --> Mat("Steel") I("Mast")
BeaconLamp --> Mat("Beacon") I("Mast")
