// The outpost's hall (#1600): a hangar off the landing pad, or - where it
// trades - a supply commissary. See street_hall.rs for the hall, and
// catalogue::items::street for the conventions and for what is declared
// ahead of these rules (Storeys, Trade, Frontage, Depth, GroundH, FloorH)
// and after them (Glazing, ShopGlazing, Wall).

const WallD = 0.4
const PaneSet = 0.14
const StepH = 0.5
const RingH = 0.3
// The roof zone: a deck's parapet, or the deck under a vault.
const RoofH = 1.0

// -- 1. The hangar: its livery rolled once, then storeys and a roof --
Lot --> Extrude(GroundH + FloorH * (Storeys - 1) + RoofH) Livery
Livery --> 40% Mat("HullWhite") Massing | 30% Mat("HullGrey") Massing
    | 30% Mat("HullSand") Massing
Massing --> when(Storeys == 1): Split(Y) { GroundH: Ground | RoofH: RoofZone }
    | else: Split(Y) { GroundH: Ground | ~1: Upper | RoofH: RoofZone }
// Party walls: the sides, the full depth, turning the corners. A hall's
// ends are its plating, blank.
PartyIn --> Translate(0, 0, -WallD) Wall
// A steel ring frame along the front at the top of every storey.
Ring --> Extrude(0.14) Mat("Steel") I("Ring")
Step --> Extrude(WallD + 0.35) Mat("Steel") I("Trim")
Lintel --> Extrude(WallD + 0.1) Mat("Frame") I("Frame")
Jamb --> Extrude(WallD + 0.08) Mat("Frame") I("Frame")
Lamp --> Extrude(WallD + 0.08) Mat("Status") I("Trim")
// A hatch's leaves, a dark seam between them.
Leaves --> Split(X) { ~1: HatchLeaf | 0.06: HatchSeam | ~1: HatchLeaf }
HatchLeaf --> Extrude(WallD - 0.18) I("Door")
HatchSeam --> Extrude(WallD - 0.24) Mat("HazardDark") I("Door")
// Hazard-striped jambs.
HazJamb --> Split(Y) { 0.45: Wall | ~1: Stripes | 0.3: Wall }
Stripes --> Repeat(Y, 0.6) { Stripe }
Stripe --> Split(Y) { ~1: StripeY | ~1: StripeD }
StripeY --> Extrude(WallD + 0.08) Mat("Hazard") I("Trim")
StripeD --> Extrude(WallD + 0.08) Mat("HazardDark") I("Trim")
// A ribbon of framed viewports on the street side, of plain ports on the
// pad side.
PortRibbon --> Repeat(X, 4.8) { PortBay }
PortBay --> Split(X) { 0.6: Wall | 0.12: Jamb | ~1: Glazing | 0.12: Jamb | 0.6: Wall }
PlainRibbon --> Repeat(X, 4.8) { PlainBay }
PlainBay --> Split(X) { 0.6: Wall | ~1: Glazing | 0.6: Wall }

// -- 2. The ground storey: a hangar's bay doors, or a commissary's
// counters --
Ground --> Comp(Faces) { Front: GroundFace | Back: BackInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
GroundFace --> Split(Y) { ~1: FrontInset | RingH: Ring }
FrontInset --> Split(X) { WallD: NIL | ~1: FrontIn | WallD: NIL }
FrontIn --> Translate(0, 0, -WallD) GroundFront
GroundFront --> when(Trade == 1): CommFront | else: HangarFront
// The hangar: a crew hatch at one end, bays of tall doors in hazard
// jambs along the rest, the ribbon over them all.
HangarFront --> Split(Y) { 5.0: BayDoors | 1.0: PortRibbon | ~1: Wall }
BayDoors --> Split(X) { 1.2: Wall | 1.3: CrewHatch | 1.0: Wall | ~1: BayRun | 1.2: Wall }
CrewHatch --> Split(Y) { StepH: Step | 2.2: CrewLeaves | 0.12: Lintel | 0.26: LampRow | ~1: Wall }
CrewLeaves --> Mat("HatchOrange") Leaves
LampRow --> Split(X) { ~1: Wall | 0.5: Lamp | ~1: Wall }
// The first bay always has its door; the rest, seven in ten.
BayRun --> when(scope.x > 7.5): Repeat(X, 7.5) { Bay } | else: OpenBay
Bay --> when(split.i == 0): OpenBay | else: AnyBay
AnyBay --> 70% OpenBay | 30% Wall
OpenBay --> Split(X) { ~1: Wall | 0.25: HazJamb | 5.4: BayDoor | 0.25: HazJamb | ~1: Wall }
// A bay door over a grated apron: the sink buries all but its top.
BayDoor --> Split(Y) { 0.45: Apron | 4.3: BayLeaves | ~1: Lintel }
Apron --> Extrude(WallD + 1.4) Mat("Steel") I("Trim")
BayLeaves --> Mat("Hatch") Leaves
// The commissary: counters either side of a double hatch - two along a
// long front - under a deep canopy and a lit sign band, ports over them.
CommFront --> Split(Y) { 3.6: Counters | 0.2: Canopy | 0.8: SignBand | 0.3: Wall
    | 1.0: PortRibbon | ~1: Wall }
Counters --> when(scope.x < 30): Split(X) { ~1: CounterRun | 2.8: MainHatch | ~1: CounterRun }
    | else: Split(X) { ~1: CounterRun | 2.8: MainHatch | ~1: CounterRun | 2.8: MainHatch
    | ~1: CounterRun }
CounterRun --> when(scope.x > 3.6): Repeat(X, 3.6) { CounterBay } | else: CounterBay
CounterBay --> Split(X) { 0.35: Wall | ~1: CounterWin | 0.35: Wall }
CounterWin --> Split(Y) { 0.6: Wall | ~1: ShopGlazing }
MainHatch --> Split(X) { 0.22: HazJamb | ~1: MainCol | 0.22: HazJamb }
MainCol --> Split(Y) { StepH: Step | 2.4: MainLeaves | ~1: Wall }
MainLeaves --> Mat("HatchGrey") Leaves
Canopy --> Extrude(WallD + 1.8) Mat("Steel") I("Canopy")
SignBand --> Split(X) { 0.4: Wall | ~1: Sign | 0.4: Wall }
Sign --> Extrude(WallD + 0.1) Mat("Sign") I("Fascia")
// The pad side: a bay door here and there, the plain ribbon over them.
BackInset --> Split(X) { WallD: NIL | ~1: BackIn | WallD: NIL }
BackIn --> Translate(0, 0, -WallD) Split(Y) { 5.0: BackBays | 1.0: PlainRibbon | ~1: Wall }
BackBays --> Split(X) { 1.2: Wall | ~1: BackRun | 1.2: Wall }
BackRun --> when(scope.x > 14): Repeat(X, 14.0) { Bay } | else: OpenBay

// -- 3. An upper storey: a control deck, its livery stripe and a ribbon
// of ports --
Upper --> Comp(Faces) { Front: UpFace | Back: UpBackInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
UpFace --> Split(Y) { ~1: UpInset | RingH: Ring }
UpInset --> Split(X) { WallD: NIL | ~1: UpIn | WallD: NIL }
UpIn --> Translate(0, 0, -WallD) Split(Y) { 0.3: LiveryBand | 0.5: Wall | 1.4: PortRibbon
    | ~1: Wall }
UpBackInset --> Split(X) { WallD: NIL | ~1: UpBackIn | WallD: NIL }
UpBackIn --> Translate(0, 0, -WallD) Split(Y) { 0.8: Wall | 1.4: PlainRibbon | ~1: Wall }
// A livery stripe along the deck, its colour picked once a hangar.
LiveryBand --> Pick("livery") { 35% StripeOrange | 30% StripeBlue | 35% StripeSteel }
StripeOrange --> Mat("LiveryOrange") LiveryStrip
StripeBlue --> Mat("LiveryBlue") LiveryStrip
StripeSteel --> Mat("Steel") LiveryStrip
LiveryStrip --> Extrude(WallD + 0.03) I("Trim")

// -- 4. The roof: a hangar's pressure vault or a deck of kit; a
// commissary's deck --
RoofZone --> when(Trade == 1): DeckRoof | else: HangarRoof
HangarRoof --> Pick("roof") { 55% Vault | 45% DeckRoof }
// A deck over the walls, and on it a hull laid on its side along the
// street, short of the party walls, a steel hoop every six metres.
Vault --> Split(Y) { 0.22: DeckSlab | ~1: VaultZone }
DeckSlab --> Mat("Deck") I("Roof")
VaultZone --> Split(X) { 0.2: NIL | 0.4: VaultHoop | ~1: VaultRun | 0.2: NIL }
VaultRun --> Repeat(X, 6.0) { VaultSeg }
VaultSeg --> Split(X) { ~1: VaultPlate | 0.4: VaultHoop }
// A plate and a hoop, each laid on its side: its length along the street,
// its centre on the deck, the depth less the walls at each end; its rise
// held to 5.5 m however deep the hangar, so its belly stays inside the
// walls.
VaultPlate --> Translate(scope.x, -min(scope.z * 0.15 + 0.4, 5.5), WallD)
    Rotate(0.70710678, 0, 0, 0.70710678)
    Size(2 * min(scope.z * 0.15 + 0.4, 5.5), scope.x, scope.z - 2 * WallD) I("Vault")
VaultHoop --> Translate(scope.x, -min(scope.z * 0.15 + 0.4, 5.5) - 0.15, WallD - 0.15)
    Rotate(0.70710678, 0, 0, 0.70710678)
    Size(2 * min(scope.z * 0.15 + 0.4, 5.5) + 0.3, scope.x, scope.z - 2 * WallD + 0.3)
    Mat("Steel") I("Hoop")
// A hazard-striped parapet round a deck, and a sliver at its top that
// sets rows of solar racks and a comms mast down on the deck.
DeckRoof --> Split(Y) { ~1: Parapet | 0.01: KitLayer }
Parapet --> Comp(Faces) { Front: ParapetFace | Back: ParapetFace | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: Deck }
ParapetFace --> Split(Y) { ~1: ParapetInset | 0.14: Coping }
ParapetInset --> Split(X) { WallD: NIL | ~1: ParapetIn | WallD: NIL }
ParapetIn --> Translate(0, 0, -WallD) Wall
Coping --> Extrude(0.05) Mat("Hazard") I("Trim")
Deck --> Translate(WallD, WallD, -0.2) Size(scope.x - 2 * WallD, scope.y - 2 * WallD, 0)
    Extrude(0.2) Mat("Deck") I("Roof")
KitLayer --> Translate(0, 0.2 - RoofH + 0.01, 0) Size(scope.x, 5.0, scope.z)
    Split(X) { ~1: RackZone | 2.0: MastZone }
RackZone --> Split(Z) { WallD + 0.6: NIL | ~1: RackField | WallD + 0.6: NIL }
RackField --> Repeat(Z, 8.0) { RackRow }
RackRow --> Split(Z) { ~1: NIL | 2.0: RackStrip | ~1: NIL }
RackStrip --> Repeat(X, 16.0) { RackSlot }
RackSlot --> Split(X) { 2.0: NIL | ~1: SolarRack | 2.0: NIL }
SolarRack --> Split(Y) { 0.3: RackBase | ~1: RackTilt }
RackBase --> Mat("Steel") I("Housing")
RackTilt --> Roof(Shed, 14, overhang=0) { Slope: SolarFace | _: RackSide }
SolarFace --> Mat("Solar") I("Panel")
RackSide --> Mat("Steel") I("Housing")
MastZone --> Split(X) { ~1: NIL | 0.4: MastCol | 1.0: NIL }
MastCol --> Split(Z) { ~1: NIL | 0.4: Mast | ~3: NIL }
Mast --> Split(Y) { ~1: MastPole | 0.4: BeaconLamp }
MastPole --> Mat("Steel") I("Mast")
BeaconLamp --> Mat("Beacon") I("Mast")
