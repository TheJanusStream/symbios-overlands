// The outpost's street house (#1598): a hab stack. See street_house.rs for
// the house, and catalogue::items::street for the conventions and for what
// is declared ahead of these rules (Storeys, Trade, Frontage, Depth,
// GroundH, FloorH) and after them (Glazing, ShopGlazing, Wall).

const WallD = 0.4
const PaneSet = 0.14
const PlinthH = 0.6
const StepH = 0.55
const RingH = 0.3
const CrownH = 0.9
const RoofH = 1.0

// -- 1. The stack: its hull livery rolled once, then modules, crown, roof --
Lot --> Extrude(GroundH + FloorH * (Storeys - 1) + CrownH + RoofH) Livery
Livery --> 30% Mat("HullWhite") Massing | 25% Mat("HullGrey") Massing
    | 25% Mat("HullSand") Massing | 20% Mat("HullBlue") Massing
Massing --> Split(Y) { GroundH: Ground | ~1: Uppers | CrownH: Crown | RoofH: RoofZone }
// Party walls: the sides, the full depth, turning the corners.
PartyIn --> Translate(0, 0, -WallD) Wall
// A steel ring frame the whole frontage at a floor, proud of the plating.
Ring --> Extrude(0.14) Mat("Steel") I("Ring")

// -- 2. The ground module: counters or quarters, an airlock --
Ground --> Comp(Faces) { Front: GroundFace | Back: RearGroundInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
GroundFace --> Split(Y) { ~1: GroundFrontInset | RingH: Ring }
GroundFrontInset --> Split(X) { WallD: NIL | ~1: GroundFrontIn | WallD: NIL }
GroundFrontIn --> Translate(0, 0, -WallD) GroundFront
GroundFront --> when(Trade == 1): Split(X) { ~1: CounterRun | 2.6: Airlock | ~1: CounterRun }
    | else: Split(X) { ~1: QuarterRun | 2.6: Airlock | ~1: QuarterRun }
// Supply counters: wide ports over a plinth under a lit sign band.
CounterRun --> Repeat(X, 3.6) { CounterBay }
CounterBay --> Split(X) { 0.4: Wall | ~1: Counter | 0.4: Wall }
Counter --> when(scope.x > 2.4): Split(X) { ~1: CounterWin | 1.1: CounterHatch }
    | else: CounterWin
CounterWin --> Split(Y) { PlinthH: Wall | ~1: ShopGlazing | 0.6: Sign }
CounterHatch --> Split(Y) { StepH: Step | 2.3: Hatch | ~1: ShopGlazing | 0.6: Sign }
Sign --> Extrude(WallD + 0.06) Mat("Sign") I("Fascia")
QuarterRun --> Repeat(X, 2.6) { QuarterBay }
QuarterBay --> Split(X) { ~1: Wall | 1.5: QuarterPort | ~1: Wall }
QuarterPort --> Split(Y) { 1.3: Wall | 0.14: Sill | 1.7: Port | 0.14: Hood | ~1: Wall }
// The airlock: a hatch in hazard-striped jambs, a status lamp over it.
Airlock --> Split(X) { 0.3: Wall | 0.22: HazJamb | ~1: AirCol | 0.22: HazJamb | 0.3: Wall }
HazJamb --> Split(Y) { StepH: Wall | ~1: Stripes | 0.5: Wall }
Stripes --> Repeat(Y, 0.5) { Stripe }
Stripe --> Split(Y) { ~1: StripeY | ~1: StripeD }
StripeY --> Extrude(WallD + 0.08) Mat("Hazard") I("Trim")
StripeD --> Extrude(WallD + 0.08) Mat("HazardDark") I("Trim")
AirCol --> Split(Y) { StepH: Step | 2.5: Hatch | 0.14: Lintel | 0.3: LampRow | ~1: Wall }
Hatch --> Split(X) { ~1: HatchLeaf | 0.06: HatchSeam | ~1: HatchLeaf }
HatchLeaf --> Extrude(WallD - 0.18) Mat("Hatch") I("Door")
HatchSeam --> Extrude(WallD - 0.24) Mat("HazardDark") I("Door")
Lintel --> Extrude(WallD + 0.1) Mat("Frame") I("Frame")
LampRow --> Split(X) { ~1: Wall | 0.5: Lamp | ~1: Wall }
Lamp --> Extrude(WallD + 0.08) Mat("Status") I("Trim")
// A grated step, standing out of the plating: the sink buries all but
// the top of it, so a hatch starts above the pavement.
Step --> Extrude(WallD + 0.4) Mat("Steel") I("Trim")
// The service side: ports over high sills.
RearGroundInset --> Split(X) { WallD: NIL | ~1: RearGroundIn | WallD: NIL }
RearGroundIn --> Translate(0, 0, -WallD) RearGround
RearGround --> Repeat(X, 2.8) { RearBay }
RearBay --> Split(X) { ~1: Wall | 1.2: RearPort | ~1: Wall }
RearPort --> Split(Y) { 1.4: Wall | 1.5: Glazing | ~1: Wall }

// -- 3. The crew modules: a ring at each floor, framed viewports --
Uppers --> Comp(Faces) { Front: UpperFace | Back: RearUpperInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
UpperFace --> Repeat(Y, FloorH) { ModuleFace }
ModuleFace --> Split(Y) { ~1: ModuleInset | RingH: Ring }
ModuleInset --> Split(X) { WallD: NIL | ~1: ModuleIn | WallD: NIL }
ModuleIn --> Translate(0, 0, -WallD) Module
Module --> Split(Y) { 0.3: LiveryBand | ~1: ModuleBody }
ModuleBody --> Split(X) { 0.8: EndPier | ~1: Bays | 0.8: EndPier }
// A livery stripe along every module, its colour picked once a stack.
LiveryBand --> Pick("livery") { 30% StripeOrange | 25% StripeBlue | 20% StripeRed
    | 25% StripeSteel }
StripeOrange --> Mat("LiveryOrange") LiveryStrip
StripeBlue --> Mat("LiveryBlue") LiveryStrip
StripeRed --> Mat("LiveryRed") LiveryStrip
StripeSteel --> Mat("Steel") LiveryStrip
LiveryStrip --> Extrude(WallD + 0.03) I("Trim")
// A conduit up each end pier, a length a module, broken by the rings.
EndPier --> Split(X) { ~1: Wall | 0.24: Conduit | ~1: Wall }
Conduit --> Extrude(WallD + 0.2) Mat("Steel") I("Mast")
Bays --> Repeat(X, 2.6) { Bay }
// The end bays carry the gantry, where the stack has one. A guard holds no
// nested parentheses: one guard per end bay.
Bay --> when(split.n >= 3 && split.i == 0): SideBay
    | when(split.n >= 3 && split.i == split.n - 1): SideBay | else: WinBay
SideBay --> Pick("gantry") { 45% GantryBay | 55% WinBay }
WinBay --> Split(X) { ~1: Wall | 1.6: WinCol | ~1: Wall }
WinCol --> Split(Y) { 0.3: Wall | 0.16: Sill | 1.5: Port | 0.16: Hood | ~1: Wall }
// A viewport in its frame: steel jambs, sill and hood round the port.
Port --> Split(X) { 0.16: Jamb | ~1: Glazing | 0.16: Jamb }
Jamb --> Extrude(WallD + 0.08) Mat("Frame") I("Frame")
Sill --> Extrude(WallD + 0.12) Mat("Frame") I("Frame")
Hood --> Extrude(WallD + 0.16) Mat("Frame") I("Frame")
GantryBay --> Split(X) { 0.3: Wall | ~1: GantryCol | 0.3: Wall }
GantryCol --> Split(Y) { 1.0: Gantry | 1.5: Glazing | 0.16: Hood | ~1: Wall }
Gantry --> Split(Y) { ~1: GantryBody | 0.1: GantryRail }
GantryBody --> Extrude(WallD + 1.1) Mat("Frame") I("Balcony")
GantryRail --> Extrude(WallD + 1.1) Mat("Hazard") I("Balcony")
RearUpperInset --> Split(X) { WallD: NIL | ~1: RearUpperIn | WallD: NIL }
RearUpperIn --> Translate(0, 0, -WallD) RearUpper
RearUpper --> Repeat(Y, FloorH) { RearStorey }
RearStorey --> Repeat(X, 2.8) { RearUpperBay }
RearUpperBay --> Split(X) { ~1: Wall | 1.2: RearUpperPort | ~1: Wall }
RearUpperPort --> Split(Y) { 0.9: Wall | 1.5: Glazing | ~1: Wall }

// -- 4. The crown: a heavy ring, a plate, a capping ring --
Crown --> Comp(Faces) { Front: CrownFace | Back: RearCrownInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
CrownFace --> Split(Y) { 0.28: CrownRing | ~1: CrownPlate | 0.14: CrownCap }
CrownRing --> Extrude(0.3) Mat("Steel") I("Ring")
CrownPlate --> Extrude(0.1) I("Wall")
CrownCap --> Extrude(0.2) Mat("Steel") I("Ring")
RearCrownInset --> Split(X) { WallD: NIL | ~1: RearCrownIn | WallD: NIL }
RearCrownIn --> Translate(0, 0, -WallD) Wall

// -- 5. The roof: a pressure vault along the street, or an antenna deck --
RoofZone --> Pick("roof") { 55% Vault | 45% AntennaDeck }
// A pressure vault along the street over a deck that closes the top: the
// hull laid on its side, steel hoops along it, short of the party walls so
// a row's vaults read as modules.
Vault --> Split(Y) { 0.22: DeckSlab | ~1: VaultZone }
VaultZone --> Split(X) { 0.2: NIL | 0.3: VaultHoop | ~1: VaultRun | 0.2: NIL }
VaultRun --> Repeat(X, 3.2) { VaultSeg }
VaultSeg --> Split(X) { ~1: VaultPlate | 0.3: VaultHoop }
// A plate and a hoop, each laid on its side: its length along the street,
// its centre on the deck, the depth less the walls at each end.
VaultPlate --> Translate(scope.x, -Depth * 0.18 - 0.4, WallD) Rotate(0.70710678, 0, 0, 0.70710678)
    Size(Depth * 0.36 + 0.8, scope.x, Depth - 2 * WallD) I("Vault")
VaultHoop --> Translate(scope.x, -Depth * 0.18 - 0.55, WallD - 0.15)
    Rotate(0.70710678, 0, 0, 0.70710678)
    Size(Depth * 0.36 + 1.1, scope.x, Depth - 2 * WallD + 0.3) Mat("Steel") I("Hoop")
AntennaDeck --> Split(Y) { 0.22: DeckSlab | ~1: DeckKit }
DeckSlab --> Mat("Deck") I("Roof")
DeckKit --> Split(Z) { ~1: NIL | ~3: KitRow | ~1: NIL }
KitRow --> Split(X) { ~1: NIL | ~4: SolarRack | ~1: NIL | 0.32: MastFoot | ~1: NIL }
SolarRack --> Split(Y) { 0.3: RackBase | ~1: RackTilt }
RackBase --> Mat("Steel") I("Housing")
RackTilt --> Roof(Shed, 14, overhang=0) { Slope: SolarFace | _: RackSide }
SolarFace --> Mat("Solar") I("Panel")
RackSide --> Mat("Steel") I("Housing")
MastFoot --> Split(Z) { ~1: NIL | 0.32: Mast | ~1: NIL }
Mast --> Size(scope.x, 6.0, scope.z) Split(Y) { ~1: MastPole | 0.4: BeaconLamp }
MastPole --> Mat("Steel") I("Mast")
BeaconLamp --> Mat("Beacon") I("Mast")
