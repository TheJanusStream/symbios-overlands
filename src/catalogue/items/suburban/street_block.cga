// The suburb's long block (#1598): a garden apartment block in face brick
// and siding. See street_block.rs for the block, and catalogue::items::street
// for the conventions and for what is declared ahead of these rules and after
// them.

const WallD = 0.34
const PaneSet = 0.13
const StepH = 0.5
const EaveH = 0.45
const RoofH = 1.0
// One stair to a section: under twelve metres so the frontages, less the
// party walls, hold two, three and four of them (a Repeat floors its count).
const SectionW = 11.5
const StairW = 2.6

// -- 1. The block: its brick rolled once, then storeys, eaves, roof --
Lot --> Extrude(GroundH + FloorH * (Storeys - 1) + EaveH + RoofH) Brick
Brick --> 38% Mat("BrickTan") Massing | 32% Mat("BrickRed") Massing
    | 30% Mat("BrickBuff") Massing
Massing --> Split(Y) { GroundH: Ground | ~1: Uppers | EaveH: Eave | RoofH: RoofZone }
// Party walls: the sides, the full depth, turning the corners.
PartyIn --> Translate(0, 0, -WallD) Wall
// The siding panels, their colour rolled once for the block.
Siding --> Pick("siding") { 30% SidingBlue | 25% SidingCream | 25% SidingSage
    | 20% SidingWhite }
SidingBlue --> Mat("SidingBlue") SidingPanel
SidingCream --> Mat("SidingCream") SidingPanel
SidingSage --> Mat("SidingSage") SidingPanel
SidingWhite --> Mat("SidingWhite") SidingPanel
SidingPanel --> Extrude(WallD) I("Wall")

// -- 2. The ground storey: an entry porch to each stair, shops or flats --
Ground --> Comp(Faces) { Front: GroundFrontInset | Back: RearGroundInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
GroundFrontInset --> Split(X) { WallD: NIL | ~1: GroundFrontIn | WallD: NIL }
GroundFrontIn --> Translate(0, 0, -WallD) GroundFront
GroundFront --> Repeat(X, SectionW) { GroundSection }
GroundSection --> Split(X) { ~1: GroundRun | StairW: Entry | ~1: GroundRun }
GroundRun --> when(Trade == 1): ShopRun | else: FlatRun
// The stair door up a step, under a little gabled porch roof.
Entry --> Split(X) { 0.35: Wall | ~1: EntryCol | 0.35: Wall }
EntryCol --> Split(Y) { StepH: Step | 2.3: DoorLeaf | ~1: EntryTop }
Step --> Extrude(WallD + 0.4) Mat("Deck") I("Trim")
DoorLeaf --> Extrude(WallD - 0.14) Mat("Door") I("Door")
EntryTop --> Extrude(WallD + 1.1) Split(Z) { WallD: EntrySlab | ~1: EntryHood }
EntrySlab --> Comp(Faces) { Back: EntryFace | Front: NIL | Left: NIL | Right: NIL | Top: NIL
    | Bottom: NIL }
EntryFace --> Translate(0, 0, -WallD) Wall
EntryHood --> Split(Y) { 0.14: HoodBoard | ~1: HoodRoof }
HoodBoard --> Mat("Trim") I("Canopy")
// An open gable: its back end would lie in the wall's face.
HoodRoof --> Roof(Gable, 35, overhang=0, ridge=Z) { Slope: Shingles | GableEnd: NIL }
// The strip of shops: windows and doors under a shingled mansard fascia
// carrying a lit sign.
ShopRun --> Split(Y) { ~1: ShopLevel | 0.85: Mansard }
ShopLevel --> Repeat(X, 3.0) { ShopBay }
ShopBay --> Split(X) { 0.25: Wall | ~1: ShopUnit | 0.25: Wall }
ShopUnit --> when(scope.x > 2.2): Split(X) { ~1: ShopWindow | 1.0: ShopDoor } | else: ShopWindow
ShopWindow --> Split(Y) { 0.55: Wall | ~1: ShopGlazing }
ShopDoor --> Split(Y) { 0.45: Step | ~1: GlassDoor | 0.2: Wall }
GlassDoor --> Extrude(WallD - 0.14) Mat("Fascia") I("Door")
Mansard --> Extrude(WallD + 0.95) Split(Z) { WallD + 0.9: MansardBox | ~1: SignFace }
MansardBox --> Mat("Shingle") I("Canopy")
SignFace --> Split(Y) { 0.25: NIL | ~1: SignRow | 0.25: NIL }
SignRow --> Split(X) { ~1: NIL | 2.7: Cells | ~1: NIL }
Cells --> Repeat(X, 0.45) { Cell }
Cell --> Split(X) { 0.1: NIL | ~1: CellLit }
CellLit --> Mat("SignLit") I("Sign")
// Flats on the street: windows over a high brick sill.
FlatRun --> Repeat(X, 2.9) { FlatBay }
FlatBay --> Split(X) { ~1: Wall | 1.5: FlatWindow | ~1: Wall }
FlatWindow --> Split(Y) { 1.0: Wall | 0.08: Sill | 1.45: Glazing | ~1: Wall }
Sill --> Extrude(WallD + 0.06) Mat("Trim") I("Trim")
RearGroundInset --> Split(X) { WallD: NIL | ~1: RearGroundIn | WallD: NIL }
RearGroundIn --> Translate(0, 0, -WallD) RearGround
RearGround --> Repeat(X, 3.8) { RearBay }
RearBay --> Split(X) { ~1: Wall | 1.4: RearWindow | ~1: Wall }
RearWindow --> Split(Y) { 1.0: Wall | 1.4: Glazing | ~1: Wall }

// -- 3. The storeys: brick with sills, a siding stair column to each
// section, and stacked balconies at the ends of its runs where the block
// has them --
Uppers --> Comp(Faces) { Front: UpperFrontInset | Back: RearUpperInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
UpperFrontInset --> Split(X) { WallD: NIL | ~1: UpperFrontIn | WallD: NIL }
UpperFrontIn --> Translate(0, 0, -WallD) UpperFront
UpperFront --> Repeat(X, SectionW) { Section }
Section --> Split(X) { ~1: Run | StairW: StairCol | ~1: Run }
Run --> when(split.i == 0): Split(X) { ~1: OuterCol | ~1: WinCol }
    | else: Split(X) { ~1: WinCol | ~1: OuterCol }
OuterCol --> Pick("balconies") { 60% BalconyCol | 40% WinCol }
// A column of windows: its piers the full height, so a storey costs only
// its window and the brick over and under it.
WinCol --> Split(X) { ~1: Wall | 1.4: WinStack | ~1: Wall }
WinStack --> Repeat(Y, FloorH) { WinBox }
WinBox --> Split(Y) { 0.8: Wall | 1.45: Glazing | ~1: Wall }
// The stair: a column of siding, a landing window in each storey.
StairCol --> Split(X) { 0.3: Wall | ~1: StairPanel | 0.3: Wall }
StairPanel --> Split(X) { ~1: Siding | 0.9: StairStack | ~1: Siding }
StairStack --> Repeat(Y, FloorH) { StairWin }
StairWin --> Split(Y) { ~1: Siding | 1.1: Glazing | 0.4: Siding }
// A balcony: a deck and a white rail before a siding panel and a patio
// door.
BalconyCol --> Split(X) { 0.25: Wall | ~1: BalconyStack | 0.25: Wall }
BalconyStack --> Repeat(Y, FloorH) { BalconySlot }
BalconySlot --> Extrude(WallD + 1.4) Split(Z) { WallD: BalconySlab | ~1: Balcony }
BalconySlab --> Comp(Faces) { Back: BalconyFace | Front: NIL | Left: NIL | Right: NIL
    | Top: NIL | Bottom: NIL }
BalconyFace --> Translate(0, 0, -WallD) BalconyBack
BalconyBack --> Split(X) { ~1: Siding | 1.6: PatioCol | ~1: Siding }
PatioCol --> Split(Y) { 0.22: Siding | 2.1: Glazing | ~1: Siding }
Balcony --> Split(Y) { 0.18: BalconyDeck | ~1: BalconyAir }
BalconyDeck --> Mat("Deck") I("Balcony")
BalconyAir --> Split(Z) { ~1: NIL | 0.06: RailPlane }
RailPlane --> Split(Y) { 1.0: Rail | ~1: NIL }
Rail --> Mat("Trim") I("Balcony")
RearUpperInset --> Split(X) { WallD: NIL | ~1: RearUpperIn | WallD: NIL }
RearUpperIn --> Translate(0, 0, -WallD) RearUpper
RearUpper --> Repeat(Y, FloorH) { RearStorey }
RearStorey --> Repeat(X, 3.8) { RearUpperBay }
RearUpperBay --> Split(X) { ~1: Wall | 1.4: RearUpperWindow | ~1: Wall }
RearUpperWindow --> Split(Y) { 0.8: Wall | 1.45: Glazing | ~1: Wall }

// -- 4. The eaves: a white fascia board the whole frontage --
Eave --> Comp(Faces) { Front: EaveBoard | Back: RearEaveInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
EaveBoard --> Extrude(0.2) Mat("Trim") I("Trim")
RearEaveInset --> Split(X) { WallD: NIL | ~1: RearEaveIn | WallD: NIL }
RearEaveIn --> Translate(0, 0, -WallD) Wall

// -- 5. The roof: a long shingled gable along the street, or a hip --
RoofZone --> Pick("roof") { 60% LongGable | 40% LongHip }
LongGable --> Roof(Gable, 26, overhang=0, ridge=X) { Slope: Shingles | GableEnd: Gable }
LongHip --> Roof(Hip, 26, overhang=0) { Slope: BrownShingles | _: BrownShingles }
Shingles --> Mat("Shingle") I("Roof")
BrownShingles --> Mat("ShingleBrown") I("Roof")
Gable --> I("Wall")
