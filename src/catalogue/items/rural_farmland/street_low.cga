// The farm country's low building (#1598): a barn-built farm shop, or -
// where nothing trades - a row of clapboard farm cottages. See street_low.rs
// for the building, and catalogue::items::street for the conventions and
// for what is declared ahead of these rules and after them.

const WallD = 0.3
const PaneSet = 0.12
const PlinthH = 0.6
const StepH = 0.5
const CanopyH = 0.18
const RoofH = 1.0
// The canopy reaches this far out of the lot's front; a post stands just
// inside its edge.
const CanopyOut = 1.8
const PostOut = 1.6
const PostD = 0.16
// A cottage's width along the street: a lot holds as many as fit.
const CotW = 5.0

Lot --> when(Trade == 1): Barn | else: Cottages
// Party walls: the sides, the full depth, turning the corners.
PartyIn --> Translate(0, 0, -WallD) Wall
Trim --> Mat("Trim") I("Trim")
Step --> Extrude(WallD + 0.3) Mat("Stone") I("Trim")
Sill --> Extrude(WallD + 0.06) Trim
Head --> Extrude(WallD + 0.1) Trim
Post --> Mat("Post") I("Post")
PierWall --> I("Wall")

// -- 1. The farm shop: red boards, a big plank door between produce
// windows, a tin canopy on posts, a gambrel over all --
Barn --> Extrude(GroundH + FloorH * (Storeys - 1) + RoofH) BarnPaint
BarnPaint --> 70% Mat("BarnRed") BarnMass | 30% Mat("BarnGrey") BarnMass
BarnMass --> when(Storeys == 1): Split(Y) { GroundH: BarnGround | RoofH: BarnRoof }
    | else: Split(Y) { GroundH: BarnGround | ~1: BarnLoft | RoofH: BarnRoof }
BarnGround --> Comp(Faces) { Front: BarnFace | Back: RearInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
BarnFace --> Split(Y) { ~1: BarnMid | CanopyH: Canopy }
Canopy --> Extrude(CanopyOut) Mat("MetalRoof") I("Canopy")
BarnMid --> Split(X) { WallD: EndPost | ~1: BarnFrontIn | WallD: EndPost }
EndPost --> Extrude(PostOut) Split(Z) { ~1: NIL | PostD: Post }
// A pier between two windows stands its post out at the canopy's edge.
Pier --> Extrude(WallD + PostOut) Split(Z) { WallD: PierWall | ~1: NIL | PostD: Post }
BarnFrontIn --> Translate(0, 0, -WallD) BarnFront
BarnFront --> Split(X) { ~1: ProduceRun | 3.0: BarnDoor | ~1: ProduceRun }
// A Repeat floors its count: a run narrower than one bay is one bay.
ProduceRun --> when(scope.x < 3.2): ProduceBay | else: Repeat(X, 3.2) { ProduceBay }
ProduceBay --> Split(X) { 0.35: Pier | ~1: ProduceWin | 0.35: Wall }
ProduceWin --> Split(Y) { PlinthH: Wall | 1.9: ShopGlazing | 0.14: Head | ~1: Wall }
// The barn door: two plank leaves in a white frame, up a step.
BarnDoor --> Split(X) { 0.15: Frame | ~1: BarnLeaves | 0.15: Frame }
Frame --> Split(Y) { StepH: Wall | ~1: FrameBoard }
FrameBoard --> Extrude(WallD + 0.04) Trim
BarnLeaves --> Split(Y) { StepH: Step | 2.7: Leaves | 0.15: FrameBoard | ~1: Wall }
Leaves --> Split(X) { ~1: DoorLeaf | 0.1: FrameBoard | ~1: DoorLeaf }
DoorLeaf --> Extrude(WallD - 0.1) Mat("Door") I("Door")
// The yard side: a feed store's windows.
RearInset --> Split(X) { WallD: NIL | ~1: RearIn | WallD: NIL }
RearIn --> Translate(0, 0, -WallD) Rear
Rear --> Repeat(X, 3.4) { RearBay }
RearBay --> Split(X) { ~1: Wall | 1.0: RearWindow | ~1: Wall }
RearWindow --> Split(Y) { 1.3: Wall | 1.1: Glazing | ~1: Wall }
// The hayloft: windows either side of a loft door.
BarnLoft --> Comp(Faces) { Front: LoftInset | Back: RearLoftInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
LoftInset --> Split(X) { WallD: NIL | ~1: LoftIn | WallD: NIL }
LoftIn --> Translate(0, 0, -WallD) Loft
Loft --> Split(X) { ~1: LoftRun | 2.0: LoftDoorCol | ~1: LoftRun }
LoftRun --> when(scope.x < 2.6): LoftBay | else: Repeat(X, 2.6) { LoftBay }
LoftBay --> Split(X) { ~1: Wall | 1.0: LoftWin | ~1: Wall }
LoftWin --> Split(Y) { 0.7: Wall | 0.08: Sill | 1.2: Glazing | 0.14: Head | ~1: Wall }
LoftDoorCol --> Split(X) { ~1: Wall | 1.5: LoftDoor | ~1: Wall }
LoftDoor --> Split(Y) { 0.3: Wall | 2.1: LoftLeaf | ~1: Wall }
LoftLeaf --> Extrude(WallD - 0.1) Mat("Door") I("Door")
RearLoftInset --> Split(X) { WallD: NIL | ~1: RearLoftIn | WallD: NIL }
RearLoftIn --> Translate(0, 0, -WallD) RearLoft
RearLoft --> Repeat(X, 3.4) { RearLoftBay }
RearLoftBay --> Split(X) { ~1: Wall | 1.0: RearLoftWin | ~1: Wall }
RearLoftWin --> Split(Y) { 0.8: Wall | 1.1: Glazing | ~1: Wall }
// A gambrel along the street, its gable ends the party walls: a steep
// lower slope a storey high, a shallow one over it.
BarnRoof --> Roof(Gambrel, 60, 28, overhang=0, ridge=X, tier=0.4)
    { LowerSlope: Metal | UpperSlope: Metal | GableEnd: Gable }
Metal --> Mat("MetalRoof") I("Roof")
Gable --> I("Wall")

// -- 2. The cottages: each its own clapboard and its own door, a hood
// over the door, under one shingle roof --
Cottages --> Extrude(GroundH + FloorH * (Storeys - 1) + RoofH) Mat("White") CotMass
CotMass --> Split(Y) { ~1: CotBody | RoofH: CotRoof }
CotBody --> Comp(Faces) { Front: CotFrontInset | Back: RearInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
CotFrontInset --> Split(X) { WallD: NIL | ~1: CotFrontIn | WallD: NIL }
CotFrontIn --> Translate(0, 0, -WallD) CotFront
CotFront --> when(scope.x < CotW): Cottage | else: Repeat(X, CotW) { Cottage }
Cottage --> 40% Mat("Cream") CotCol | 35% Mat("White") CotCol | 25% Mat("Sage") CotCol
CotCol --> when(Storeys == 1): CotGround
    | else: Split(Y) { GroundH: CotGround | ~1: CotUp }
CotGround --> Split(X) { ~1: Wall | 1.2: CotWindow | 0.5: Wall | 1.0: CotDoor | ~1: Wall }
CotWindow --> Split(Y) { 0.85: Wall | 0.08: Sill | 1.5: Glazing | 0.14: Head | ~1: Wall }
CotDoor --> Split(Y) { StepH: Step | 2.15: CotLeaf | 0.14: Hood | ~1: Wall }
Hood --> Extrude(WallD + 0.7) Trim
// Every household its own door colour.
CotLeaf --> 35% Mat("Door") Leaf | 35% Mat("DoorGreen") Leaf | 30% Mat("DoorRed") Leaf
Leaf --> Extrude(WallD - 0.1) I("Door")
CotUp --> Split(X) { ~1: Wall | 1.0: LoftWin | ~1: Wall | 1.0: LoftWin | ~1: Wall }
// A shingle gable along the street, its ends the party walls.
CotRoof --> Roof(Gable, 40, overhang=0, ridge=X) { Slope: Shingles | GableEnd: Gable }
Shingles --> Mat("Shingle") I("Roof")
