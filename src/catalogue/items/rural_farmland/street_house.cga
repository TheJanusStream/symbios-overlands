// The farm country's street house (#1598): a tall brick market-town house
// built like a farmhouse, its half-hipped gable to the street. See
// street_house.rs for the house, and catalogue::items::street for the
// conventions and for what is declared ahead of these rules (Storeys, Trade,
// Frontage, Depth, GroundH, FloorH) and after them (Glazing, ShopGlazing,
// Wall).

const WallD = 0.42
const PaneSet = 0.16
const PlinthH = 0.6
const CourseH = 0.3
const StepH = 0.55
const CrownH = 0.35
// The roof zone holds the gable's loft door and hoist beam; the roof
// itself rises by its pitch over half the frontage.
const RoofH = 3.0
// The roof's gable end stands this far behind the front, so the loft door
// and the beam can be set into it.
const LoftSet = 0.04

// -- 1. The house: its brick rolled once, then storeys, eaves, gable --
Lot --> Extrude(GroundH + FloorH * (Storeys - 1) + CrownH + RoofH) Brick
Brick --> 50% Mat("BrickRed") Massing | 30% Mat("BrickDark") Massing
    | 20% Mat("BrickBuff") Massing
Massing --> Split(Y) { GroundH: Ground | ~1: Uppers | CrownH: Crown | RoofH: RoofZone }
// Party walls: the sides, the full depth, turning the corners.
PartyIn --> Translate(0, 0, -WallD) Wall
Trim --> Mat("Trim") I("Trim")
// A soldier course over an opening: the brick arch, darker than the wall.
ArchHead --> Extrude(WallD + 0.05) Mat("Arch") I("Trim")
StoneWall --> Mat("Stone") Wall

// -- 2. The ground storey: a farm shop under a tin canopy, or the house's
// own rooms, on a fieldstone plinth --
Ground --> Comp(Faces) { Front: GroundFace | Back: RearGroundInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
GroundFace --> Split(Y) { ~1: GroundFrontInset | CourseH: Course }
Course --> Extrude(0.1) Mat("Arch") I("Trim")
GroundFrontInset --> Split(X) { WallD: NIL | ~1: GroundFrontIn | WallD: NIL }
GroundFrontIn --> Translate(0, 0, -WallD) GroundFront
GroundFront --> when(Trade == 1): ShopFront | else: HomeFront
ShopFront --> Split(X) { ~1: ShopRun | 2.2: Entrance | ~1: ShopRun }
// A Repeat floors its count: a run narrower than one bay is one bay.
ShopRun --> when(scope.x < 3.6): ShopBay | else: Repeat(X, 3.6) { ShopBay }
ShopBay --> Split(X) { 0.45: Wall | ~1: ShopUnit | 0.45: Wall }
ShopUnit --> when(scope.x > 2.4): Split(X) { ~1: ShopWindow | 1.1: ShopDoor }
    | else: ShopWindow
ShopWindow --> Split(Y) { PlinthH: StoneWall | 2.2: ShopGlazing | 0.18: Canopy | 0.55: Sign
    | ~1: Wall }
ShopDoor --> Split(Y) { StepH: Step | 2.25: DoorLeaf | 0.18: Canopy | 0.55: Sign | ~1: Wall }
Canopy --> Extrude(WallD + 1.3) Mat("Canopy") I("Canopy")
Sign --> Extrude(WallD + 0.06) Mat("Sign") I("Fascia")
Step --> Extrude(WallD + 0.3) Mat("Stone") I("Trim")
DoorLeaf --> Extrude(WallD - 0.18) Mat("Door") I("Door")
HomeFront --> Split(X) { ~1: HomeRun | 2.2: Entrance | ~1: HomeRun }
HomeRun --> when(scope.x < 2.8): HomeBay | else: Repeat(X, 2.8) { HomeBay }
HomeBay --> Split(X) { ~1: Wall | 1.2: HomeWindow | ~1: Wall }
HomeWindow --> Split(Y) { PlinthH: StoneWall | 0.5: Wall | 0.1: Sill | 2.0: Glazing
    | 0.3: ArchHead | ~1: Wall }
Sill --> Extrude(WallD + 0.06) Trim
// The house door: a panelled leaf under a fanlight, up a stone step.
Entrance --> Split(X) { 0.3: Wall | ~1: EntranceDoor | 0.3: Wall }
EntranceDoor --> Split(Y) { StepH: Step | 2.4: DoorLeaf | ~1: Fanlight }
Fanlight --> Split(Y) { ~1: Glazing | 0.25: ArchHead }
// The yard side: windows over high sills.
RearGroundInset --> Split(X) { WallD: NIL | ~1: RearGroundIn | WallD: NIL }
RearGroundIn --> Translate(0, 0, -WallD) RearGround
RearGround --> Repeat(X, 3.0) { RearBay }
RearBay --> Split(X) { ~1: Wall | 1.1: RearWindow | ~1: Wall }
RearWindow --> Split(Y) { 1.3: Wall | 1.8: Glazing | ~1: Wall }

// -- 3. The storeys: windows under brick arches, shuttered or not --
Uppers --> Comp(Faces) { Front: UpperFrontInset | Back: RearUpperInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
UpperFrontInset --> Split(X) { WallD: NIL | ~1: UpperFrontIn | WallD: NIL }
UpperFrontIn --> Translate(0, 0, -WallD) UpperFront
UpperFront --> Repeat(Y, FloorH) { Storey }
Storey --> Split(X) { 0.7: Wall | ~1: Bays | 0.7: Wall }
Bays --> Repeat(X, 2.6) { Bay }
Bay --> Pick("shutters") { 60% ShutteredBay | 40% WinBay }
WinBay --> Split(X) { ~1: Wall | 1.1: WinCol | ~1: Wall }
ShutteredBay --> Split(X) { ~1: Wall | 0.45: ShutterCol | 1.1: WinCol | 0.45: ShutterCol
    | ~1: Wall }
WinCol --> Split(Y) { 0.75: Wall | 0.1: Sill | 1.9: Glazing | 0.3: ArchHead | ~1: Wall }
ShutterCol --> Split(Y) { 0.85: Wall | 1.9: Shutter | ~1: Wall }
Shutter --> Extrude(WallD + 0.05) Mat("Shutter") I("Shutter")
RearUpperInset --> Split(X) { WallD: NIL | ~1: RearUpperIn | WallD: NIL }
RearUpperIn --> Translate(0, 0, -WallD) RearUpper
RearUpper --> Repeat(Y, FloorH) { RearStorey }
RearStorey --> Repeat(X, 3.0) { RearUpperBay }
RearUpperBay --> Split(X) { ~1: Wall | 1.1: RearUpperWindow | ~1: Wall }
RearUpperWindow --> Split(Y) { 0.8: Wall | 1.7: Glazing | ~1: Wall }

// -- 4. The eaves course, the half-hipped roof, the loft in its gable --
Crown --> Comp(Faces) { Front: EavesCourse | Back: RearCrownInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
EavesCourse --> Split(Y) { ~1: EavesLow | 0.15: EavesTop }
EavesLow --> Extrude(0.1) Mat("Arch") I("Trim")
EavesTop --> Extrude(0.2) Mat("Arch") I("Trim")
RearCrownInset --> Split(X) { WallD: NIL | ~1: RearCrownIn | WallD: NIL }
RearCrownIn --> Translate(0, 0, -WallD) Wall
RoofZone --> Split(Z) { LoftSet: LoftLayer | ~1: RoofBox }
// Half-hipped, its gable to the street, so a row stands gable by gable;
// shingle or ribbed metal, `Pick`ed once.
RoofBox --> Pick("roof") { 55% ShingleRoof | 45% MetalRoof }
ShingleRoof --> Roof(Jerkinhead, 38, overhang=0, ridge=Z)
    { Slope: Shingles | HipEnd: Shingles | GableEnd: Gable }
MetalRoof --> Roof(Jerkinhead, 38, overhang=0, ridge=Z)
    { Slope: Metal | HipEnd: Metal | GableEnd: Gable }
Shingles --> Mat("Shingle") I("Roof")
Metal --> Mat("MetalRoof") I("Roof")
Gable --> I("Wall")
// The loft door and the hoist beam over it, set into the gable.
LoftLayer --> Comp(Faces) { Front: LoftFace | Back: NIL | Left: NIL | Right: NIL | Top: NIL
    | Bottom: NIL }
LoftFace --> Split(X) { ~1: NIL | 1.4: LoftCol | ~1: NIL }
LoftCol --> Split(Y) { 0.45: NIL | 1.9: LoftDoor | 0.15: NIL | 0.22: BeamBand | ~1: NIL }
LoftDoor --> Translate(0, 0, -2 * LoftSet) Extrude(2 * LoftSet + 0.1) Mat("Loft") I("Door")
BeamBand --> Split(X) { ~1: NIL | 0.24: Beam | ~1: NIL }
Beam --> Translate(0, 0, -2 * LoftSet) Extrude(2 * LoftSet + 1.1) Mat("Beam") I("Beam")
