// The sports theme's street house (#1598): a club house in a Berlin
// Altbau. See street_house.rs for the house, and catalogue::items::street
// for the conventions and for what is declared ahead of these rules
// (Storeys, Trade, Frontage, Depth, GroundH, FloorH) and after them
// (Glazing, ShopGlazing, Wall).

const WallD = 0.4
const PaneSet = 0.15
const PlinthH = 0.6
const StepH = 0.55
const BandH = 0.45
const ParapetH = 1.1
const RoofH = 6.0
const CageH = 2.6

// -- 1. The house: its cladding rolled once, then storeys, parapet, roof --
Lot --> Extrude(GroundH + FloorH * (Storeys - 1) + ParapetH + RoofH) Cladding
Cladding --> 40% Mat("Render") Massing | 30% Mat("Concrete") Massing
    | 30% Mat("Panel") Massing
Massing --> Split(Y) { GroundH: Ground | ~1: Uppers | ParapetH: Parapet | RoofH: RoofTop }
// Party walls: the sides, the full depth, turning the corners.
PartyIn --> Translate(0, 0, -WallD) Wall

// -- The club's colour, Picked once: a part names its kind --
Team(k) --> Pick("team") { 30% TeamRed(k) | 25% TeamBlue(k) | 25% TeamGreen(k)
    | 20% TeamOrange(k) }
TeamRed(k) --> Mat("TeamRed") TeamPart(k)
TeamBlue(k) --> Mat("TeamBlue") TeamPart(k)
TeamGreen(k) --> Mat("TeamGreen") TeamPart(k)
TeamOrange(k) --> Mat("TeamOrange") TeamPart(k)
TeamPart(k) --> when(k == 1): Band | when(k == 2): Fascia | when(k == 3): Rail | else: Post
// A band at a floor line, cut from the full face: a row's bands meet.
Band --> Extrude(0.16) I("Band")
Fascia --> Extrude(WallD + 0.1) I("Fascia")
Rail --> I("Rail")
Post --> I("Rail")

// -- 2. The ground storey: a sports shop or club rooms, under a band --
Ground --> Comp(Faces) { Front: GroundFace | Back: RearGroundInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
GroundFace --> Split(Y) { ~1: GroundFrontInset | BandH: Team(1) }
GroundFrontInset --> Split(X) { WallD: NIL | ~1: GroundFrontIn | WallD: NIL }
GroundFrontIn --> Translate(0, 0, -WallD) GroundFront
GroundFront --> when(Trade == 1): ShopFront | else: HomeFront
ShopFront --> Split(X) { ~1: ShopRun | 2.2: Entrance | ~1: ShopRun }
ShopRun --> Repeat(X, 3.6) { ShopBay }
ShopBay --> Split(X) { 0.35: Wall | ~1: ShopUnit | 0.35: Wall }
ShopUnit --> when(scope.x > 2.4): Split(X) { ~1: ShopWindow | 1.1: ShopDoor }
    | else: ShopWindow
ShopWindow --> Split(Y) { PlinthH: Wall | ~1: ShopGlazing | 0.7: Team(2) }
ShopDoor --> Split(Y) { StepH: Step | 2.3: DoorLeaf | ~1: ShopGlazing | 0.7: Team(2) }
DoorLeaf --> Extrude(WallD - 0.2) Mat("Door") I("Door")
// A step standing out of the wall: the sink buries all but its top.
Step --> Extrude(WallD + 0.3) Mat("Trim") I("Trim")
HomeFront --> Split(X) { ~1: HomeRun | 2.2: Entrance | ~1: HomeRun }
HomeRun --> Repeat(X, 2.6) { HomeBay }
HomeBay --> Split(X) { ~1: Wall | 1.8: HomeWindow | ~1: Wall }
HomeWindow --> Split(Y) { 1.3: Wall | 0.1: Sill | 1.6: Glazing | ~1: Wall }
Sill --> Extrude(WallD + 0.06) Mat("Trim") I("Trim")
// The club's door: a glazed leaf up a step, a lit crest over it.
Entrance --> Split(X) { 0.3: Wall | ~1: EntranceDoor | 0.3: Wall }
EntranceDoor --> Split(Y) { StepH: Step | 2.6: DoorLeaf | 0.15: Wall | ~1: Crest | 0.15: Wall }
Crest --> Split(X) { 0.2: Wall | ~1: CrestLit | 0.2: Wall }
CrestLit --> Extrude(WallD + 0.08) Mat("Score") I("Sign")
// The yard side: windows over high sills.
RearGroundInset --> Split(X) { WallD: NIL | ~1: RearGroundIn | WallD: NIL }
RearGroundIn --> Translate(0, 0, -WallD) RearGround
RearGround --> Repeat(X, 2.8) { RearBay }
RearBay --> Split(X) { ~1: Wall | 1.2: RearWindow | ~1: Wall }
RearWindow --> Split(Y) { 1.4: Wall | 1.8: Glazing | ~1: Wall }

// -- 3. The upper storeys: the club terrace, then banded storeys --
Uppers --> Comp(Faces) { Front: UpperFace | Back: RearUpperInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
UpperFace --> Split(Y) { FloorH: TerraceFace | ~1: StoreysFace }
StoreysFace --> Repeat(Y, FloorH) { StoreyFace }
StoreyFace --> Split(Y) { ~1: StoreyInset | BandH: Team(1) }
StoreyInset --> Split(X) { WallD: NIL | ~1: StoreyIn | WallD: NIL }
StoreyIn --> Translate(0, 0, -WallD) Storey
Storey --> Split(X) { 0.7: Wall | ~1: Bays | 0.7: Wall }
Bays --> Repeat(X, 2.6) { Bay }
Bay --> Split(X) { ~1: Wall | 2.0: WinCol | ~1: Wall }
WinCol --> Split(Y) { 0.8: Wall | 0.1: Sill | 1.6: Glazing | ~1: Wall }
// The first floor: a terrace the width of the house, where it has one.
TerraceFace --> Split(Y) { ~1: TerraceInset | BandH: Team(1) }
TerraceInset --> Split(X) { WallD: NIL | ~1: TerraceIn | WallD: NIL }
TerraceIn --> Translate(0, 0, -WallD) Terrace
Terrace --> Pick("terrace") { 55% ClubTerrace | 45% Storey }
ClubTerrace --> Split(Y) { 0.25: TerraceSlab | 1.0: TerraceRail | ~1: TerraceDoors }
TerraceSlab --> Extrude(WallD + 1.5) Mat("Concrete") I("Balcony")
// The rail stands at the slab's edge, a low wall behind it.
TerraceRail --> Extrude(WallD + 1.5) Split(Z) { WallD: TerraceSill | ~1: NIL | 0.08: Team(3) }
TerraceSill --> I("Wall")
TerraceDoors --> Repeat(X, 2.2) { TerraceDoor }
TerraceDoor --> Split(X) { 0.25: Wall | ~1: TerraceGlass | 0.25: Wall }
TerraceGlass --> Split(Y) { ~1: Glazing | 0.3: Wall }
RearUpperInset --> Split(X) { WallD: NIL | ~1: RearUpperIn | WallD: NIL }
RearUpperIn --> Translate(0, 0, -WallD) RearUpper
RearUpper --> Repeat(Y, FloorH) { RearStorey }
RearStorey --> Repeat(X, 2.8) { RearUpperBay }
RearUpperBay --> Split(X) { ~1: Wall | 1.2: RearUpperWindow | ~1: Wall }
RearUpperWindow --> Split(Y) { 0.9: Wall | 1.7: Glazing | ~1: Wall }

// -- 4. The parapet, its coping, and the court inside it --
Parapet --> Comp(Faces) { Front: ParapetFront | Back: ParapetFace | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: Deck }
ParapetFace --> Split(Y) { ~1: ParapetInset | 0.14: Coping }
ParapetInset --> Split(X) { WallD: NIL | ~1: ParapetIn | WallD: NIL }
ParapetIn --> Translate(0, 0, -WallD) Wall
// The front parapet carries the club's scoreboard: lit cells in a dark
// housing.
ParapetFront --> Split(Y) { ~1: ParapetBoardInset | 0.14: Coping }
ParapetBoardInset --> Split(X) { WallD: NIL | ~1: ParapetBoardIn | WallD: NIL }
ParapetBoardIn --> Translate(0, 0, -WallD) Split(X) { ~1: Wall | 3.4: Board | ~1: Wall }
Board --> Split(Y) { 0.12: Housing | ~1: BoardRow | 0.12: Housing }
BoardRow --> Split(X) { 0.15: Housing | ~1: Cell | 0.25: Housing | ~1: Cell | 0.25: Housing
    | ~1: Cell | 0.15: Housing }
Housing --> Extrude(WallD + 0.12) Mat("Door") I("Sign")
Cell --> Extrude(WallD + 0.16) Mat("Score") I("Sign")
Coping --> Extrude(0.05) Mat("Trim") I("Trim")
// The deck fills the ring inside the parapet's walls: a court.
Deck --> Translate(WallD, WallD, -0.2) Size(scope.x - 2 * WallD, scope.y - 2 * WallD, 0)
    Extrude(0.2) Mat("Court") I("Roof")

// -- 5. The roof: a cage of netting on the parapets, two floodlights --
RoofTop --> Split(Z) { WallD: CageSide | ~1: RoofMiddle | WallD: CageSide }
CageSide --> Split(Y) { CageH: CageRow | ~1: NIL }
CageRow --> Split(Z) { ~1: NIL | 0.05: CageRun | ~1: NIL }
CageRun --> Split(X) { 0.1: NIL | ~1: CageBays | 0.1: Team(4) | 0.1: NIL }
CageBays --> Repeat(X, 3.0) { CageBay }
CageBay --> Split(X) { 0.1: Team(4) | ~1: Net }
Net --> Mat("Net") I("Fence")
RoofMiddle --> Split(Z) { ~1: NIL | 0.3: MastRow | ~1: NIL }
MastRow --> Split(X) { 1.2: NIL | 0.3: Mast | ~1: NIL | 0.3: Mast | 1.2: NIL }
// A mast stands on the court, through the parapet's height.
Mast --> Translate(0, 0.2 - ParapetH, 0) Size(scope.x, scope.y + ParapetH - 0.2, scope.z)
    Split(Y) { ~1: MastStem | 0.5: LampSlot }
MastStem --> Mat("Steel") I("Mast")
LampSlot --> Translate(-0.4, 0, -0.03) Size(1.1, 0.5, 0.36) Mat("Lamp") I("Lamp")
