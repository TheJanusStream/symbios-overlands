// The sports theme's low building (#1598): a row of changing rooms, or -
// where it trades - a club kiosk. See street_low.rs for the building, and
// catalogue::items::street for the conventions and for what is declared
// ahead of these rules and after them.

const WallD = 0.32
const PaneSet = 0.12
const StepH = 0.5
const BandH = 0.4
const RoofH = 1.0
const ParapetH = 1.1
// A changing room's width along the street: a lot holds as many as fit.
const RoomW = 3.8

Lot --> when(Trade == 1): Kiosk | else: Rooms
// Party walls: the sides, the full depth, turning the corners.
PartyIn --> Translate(0, 0, -WallD) Wall

// -- The club's colour, Picked once: a part names its kind --
Team(k) --> Pick("team") { 30% TeamRed(k) | 25% TeamBlue(k) | 25% TeamGreen(k)
    | 20% TeamOrange(k) }
TeamRed(k) --> Mat("TeamRed") TeamPart(k)
TeamBlue(k) --> Mat("TeamBlue") TeamPart(k)
TeamGreen(k) --> Mat("TeamGreen") TeamPart(k)
TeamOrange(k) --> Mat("TeamOrange") TeamPart(k)
TeamPart(k) --> when(k == 1): Band | when(k == 2): TeamDoor | when(k == 3): Awning
    | else: Fascia
// A band cut from the full face: a row's bands meet at the party walls.
Band --> Extrude(0.12) I("Band")
TeamDoor --> Extrude(WallD - 0.14) I("Door")
Awning --> Extrude(1.7) I("Awning")
Fascia --> Extrude(WallD + 0.06) I("Fascia")
Step --> Extrude(WallD + 0.3) Mat("Block") I("Trim")

// -- 1. The changing rooms: painted block under a mono-pitch roof --
Rooms --> Extrude(GroundH + FloorH * (Storeys - 1) + RoofH) Paint
Paint --> 40% Mat("White") RoomsMass | 30% Mat("Cream") RoomsMass
    | 30% Mat("Block") RoomsMass
RoomsMass --> when(Storeys == 1): Split(Y) { GroundH: RoomsGround | RoofH: RoomsRoof }
    | else: Split(Y) { GroundH: RoomsGround | ~1: RoomsUpper | RoofH: RoomsRoof }
RoomsGround --> Comp(Faces) { Front: RoomsFace | Back: RoomsRearInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
// Doors and high windows, a canopy the whole frontage over them, a band
// in the club's colour under the eaves.
RoomsFace --> Split(Y) { 2.95: RoomsFrontInset | 0.15: RoomsCanopy | ~1: RoomsHeadInset
    | BandH: Team(1) }
RoomsCanopy --> Extrude(1.5) Mat("Steel") I("Canopy")
RoomsFrontInset --> Split(X) { WallD: NIL | ~1: RoomsFrontIn | WallD: NIL }
RoomsFrontIn --> Translate(0, 0, -WallD) RoomsFront
RoomsHeadInset --> Split(X) { WallD: NIL | ~1: RoomsHeadIn | WallD: NIL }
RoomsHeadIn --> Translate(0, 0, -WallD) Wall
RoomsFront --> Repeat(X, RoomW) { Room }
// Each room: its door in the club's colour, a high window, a bench rail.
Room --> Split(X) { ~1: Wall | 1.0: RoomDoor | 0.4: Wall | 1.7: RoomWin | ~1: Wall }
RoomDoor --> Split(Y) { StepH: Step | 2.2: Team(2) | ~1: Wall }
RoomWin --> Split(Y) { 0.9: Wall | 0.1: BenchRail | 0.9: Wall | 0.8: Glazing | ~1: Wall }
BenchRail --> Extrude(WallD + 0.35) Mat("Steel") I("Rail")
RoomsRearInset --> Split(X) { WallD: NIL | ~1: RoomsRearIn | WallD: NIL }
RoomsRearIn --> Translate(0, 0, -WallD) RoomsRear
RoomsRear --> Repeat(X, 2.8) { RoomsRearBay }
RoomsRearBay --> Split(X) { ~1: Wall | 1.4: RoomsRearWindow | ~1: Wall }
RoomsRearWindow --> Split(Y) { 1.9: Wall | 0.8: Glazing | ~1: Wall }
// A clubroom over the rooms: a row of wide windows.
RoomsUpper --> Comp(Faces) { Front: UpperInset | Back: UpperInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
UpperInset --> Split(X) { WallD: NIL | ~1: UpperIn | WallD: NIL }
UpperIn --> Translate(0, 0, -WallD) UpperFront
UpperFront --> Repeat(X, 2.6) { UpperBay }
UpperBay --> Split(X) { ~1: Wall | 1.9: UpperWindow | ~1: Wall }
UpperWindow --> Split(Y) { 0.8: Wall | 1.4: Glazing | ~1: Wall }
// A mono-pitch of sheet, rising to the back.
RoomsRoof --> Roof(Shed, 12, overhang=0, ridge=X) { Slope: Sheet | All: RoofWall }
Sheet --> Mat("Sheet") I("Roof")
RoofWall --> I("Wall")

// -- 2. The kiosk: hatches over a counter, a striped awning, a score --
Kiosk --> Extrude(GroundH + FloorH * (Storeys - 1) + ParapetH) KioskPaint
KioskPaint --> 55% Mat("White") KioskMass | 45% Mat("Block") KioskMass
KioskMass --> when(Storeys == 1): Split(Y) { GroundH: KioskGround | ParapetH: Parapet }
    | else: Split(Y) { GroundH: KioskGround | ~1: RoomsUpper | ParapetH: Parapet }
KioskGround --> Comp(Faces) { Front: KioskFace | Back: RoomsRearInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
KioskFace --> Split(Y) { ~1: KioskFrontInset | 0.45: AwningRow }
KioskFrontInset --> Split(X) { WallD: NIL | ~1: KioskFrontIn | WallD: NIL }
KioskFrontIn --> Translate(0, 0, -WallD) KioskFront
KioskFront --> Split(X) { ~1: HatchRun | 1.3: KioskDoor | ~1: HatchRun }
HatchRun --> Repeat(X, 2.8) { HatchBay }
HatchBay --> Split(X) { 0.3: Wall | ~1: Hatch | 0.3: Wall }
// A serving hatch: a counter standing out under the shop's glass.
Hatch --> Split(Y) { 0.95: Wall | 0.1: Counter | ~1: ShopGlazing | 0.2: Wall }
Counter --> Extrude(WallD + 0.45) Mat("Counter") I("Counter")
KioskDoor --> Split(Y) { StepH: Step | 2.2: KioskLeaf | ~1: Wall }
KioskLeaf --> Extrude(WallD - 0.14) Mat("Counter") I("Door")
// The awning: the club's colour and white in stripes.
AwningRow --> Repeat(X, 1.0) { AwningBay }
AwningBay --> Split(X) { ~1: Team(3) | ~1: WhiteStripe }
WhiteStripe --> Extrude(1.7) Mat("Stripe") I("Awning")
// The sign on the parapet: a lit score in a dark housing, the club's
// colour either side.
SignFace --> Split(Y) { ~1: SignInset | 0.12: Coping }
SignInset --> Split(X) { WallD: NIL | ~1: SignIn | WallD: NIL }
SignIn --> Translate(0, 0, -WallD) SignRow
SignRow --> Split(Y) { 0.1: Wall | ~1: SignBand | 0.1: Wall }
SignBand --> Split(X) { ~1: Team(4) | 3.2: Board | ~1: Team(4) }
Board --> Split(Y) { 0.12: Housing | ~1: BoardRow | 0.12: Housing }
BoardRow --> Split(X) { 0.15: Housing | ~1: Cell | 0.25: Housing | ~1: Cell | 0.15: Housing }
Housing --> Extrude(WallD + 0.1) Mat("Counter") I("Sign")
Cell --> Extrude(WallD + 0.14) Mat("Score") I("Sign")
// The parapet, its coping, and the deck inside it.
Parapet --> Comp(Faces) { Front: SignFace | Back: ParapetFace | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: Deck }
ParapetFace --> Split(Y) { ~1: ParapetInset | 0.12: Coping }
ParapetInset --> Split(X) { WallD: NIL | ~1: ParapetIn | WallD: NIL }
ParapetIn --> Translate(0, 0, -WallD) Wall
Coping --> Extrude(0.05) Mat("Steel") I("Trim")
Deck --> Translate(WallD, WallD, -0.2) Size(scope.x - 2 * WallD, scope.y - 2 * WallD, 0)
    Extrude(0.2) Mat("Deck") I("Roof")
