// The gothic horror theme's low building (#1598): an almshouse row, or -
// where it trades - an undertaker's parlour. See street_low.rs for the
// building, and catalogue::items::street for the conventions and for what
// is declared ahead of these rules and after them.

const WallD = 0.42
const PaneSet = 0.15
const StepH = 0.55
const CrownH = 0.5
const RoofH = 0.5
// One almshouse, under its own gable, to every five and a half metres.
const AlmsW = 5.5

Lot --> when(Trade == 1): Parlour | else: Almshouses
// Party walls: the sides, the full depth, turning the corners.
PartyIn --> Translate(0, 0, -WallD) Wall
SlotWall --> I("Wall")
// A pointed hood over a window or a door: a drip-stone, and on it a
// steep little gable of dressed stone a hair clear of the wall.
HoodBase --> Extrude(WallD + 0.16) Split(Z) { WallD: SlotWall | ~1: HoodFront }
HoodFront --> Split(Y) { 0.1: Drip | ~1: PeakSlot }
Drip --> Mat("Dressing") I("Trim")
PeakSlot --> Split(Z) { 0.03: NIL | ~1: Peak }
Peak --> Roof(Gable, 55, overhang=0, ridge=Z) { Slope: Dressed | GableEnd: Dressed }
Dressed --> Mat("Dressing") I("Trim")
Sill --> Extrude(WallD + 0.08) Mat("Dressing") I("Trim")
Step --> Extrude(WallD + 0.3) Mat("Dressing") I("Trim")
Quoin --> Extrude(WallD + 0.06) Mat("Dressing") I("Trim")
SlateSlope --> Mat("Slate") I("Roof")
// A pointed window, its sill and its hood.
PointedWin --> Split(Y) { 0.9: Wall | 0.12: Sill | 1.6: Glazing | 0.14: HoodBase | ~1: Wall }

// -- 1. The almshouses: stone cottages, each under its own gable --
Almshouses --> Extrude(GroundH + FloorH * (Storeys - 1) + RoofH) Stone
Stone --> 40% Mat("Stone") Row | 35% Mat("Mossy") Row | 25% Mat("PaleStone") Row
Row --> Repeat(X, AlmsW) { Almshouse }
Almshouse --> when(Storeys == 1): Split(Y) { GroundH: AGround | RoofH: AGable }
    | else: Split(Y) { GroundH: AGround | ~1: AUpper | RoofH: AGable }
AGround --> Comp(Faces) { Front: AFrontInset | Back: RearInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
AFrontInset --> Split(X) { WallD: NIL | ~1: AFrontIn | WallD: NIL }
AFrontIn --> Translate(0, 0, -WallD) Split(X) { 0.4: Quoin | ~1: Wall | 1.1: ADoor | 0.6: Wall
    | 1.0: AWin | ~1: Wall | 0.4: Quoin }
ADoor --> Split(Y) { StepH: Step | 2.2: ALeaf | 0.14: HoodBase | ~1: Wall }
ALeaf --> Extrude(WallD - 0.15) Mat("Door") I("Door")
AWin --> PointedWin
AUpper --> Comp(Faces) { Front: AUpInset | Back: RearUpperInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
AUpInset --> Split(X) { WallD: NIL | ~1: AUpIn | WallD: NIL }
AUpIn --> Translate(0, 0, -WallD) Split(X) { 0.4: Quoin | ~1: Wall | 1.0: AUpWin | ~1: Wall
    | 0.4: Quoin }
AUpWin --> Split(Y) { 0.5: Wall | 1.5: Glazing | 0.14: HoodBase | ~1: Wall }
// A steep slate gable turned to the street.
AGable --> Roof(Gable, 58, overhang=0, ridge=Z) { Slope: SlateSlope | GableEnd: SlotWall }

// -- 2. The parlour: a black shopfront, pointed windows over it, a gablet
// over the door and iron cresting along the ridge --
Parlour --> Extrude(GroundH + FloorH * (Storeys - 1) + CrownH + RoofH) Masonry
Masonry --> 45% Mat("BlackBrick") PMass | 30% Mat("Brick") PMass | 25% Mat("Stone") PMass
PMass --> when(Storeys == 1): Split(Y) { GroundH: PGround | CrownH: Crown | RoofH: PRoofZone }
    | else: Split(Y) { GroundH: PGround | ~1: PUpper | CrownH: Crown | RoofH: PRoofZone }
PGround --> Comp(Faces) { Front: PFrontInset | Back: RearInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
PFrontInset --> Split(X) { WallD: NIL | ~1: PFrontIn | WallD: NIL }
PFrontIn --> Translate(0, 0, -WallD) Split(X) { ~1: ShopRun | 1.8: Entrance | ~1: ShopRun }
ShopRun --> Repeat(X, 3.4) { ShopBay }
ShopBay --> Split(X) { 0.35: Pilaster | ~1: ShopWin | 0.35: Pilaster }
Pilaster --> Extrude(WallD + 0.12) Mat("Fascia") I("Fascia")
ShopWin --> Split(Y) { 0.7: Stall | 2.1: ShopGlazing | ~1: FasciaBand }
Stall --> Extrude(WallD + 0.05) Mat("Fascia") I("Fascia")
FasciaBand --> Extrude(WallD + 0.15) Mat("Fascia") I("Fascia")
Entrance --> Split(Y) { StepH: Step | 2.4: PDoor | 0.4: Fanlight | ~1: FasciaBand }
PDoor --> Extrude(WallD - 0.15) Mat("DoorBlack") I("Door")
Fanlight --> Extrude(WallD - 0.15) Mat("Stained") I("Pane")
PUpper --> Comp(Faces) { Front: PUpInset | Back: RearUpperInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
PUpInset --> Split(X) { WallD: NIL | ~1: PUpIn | WallD: NIL }
PUpIn --> Translate(0, 0, -WallD) Split(X) { 0.5: Wall | ~1: PUpRun | 0.5: Wall }
PUpRun --> Repeat(X, 2.4) { PUpBay }
PUpBay --> Split(X) { ~1: Wall | 1.0: PUpWin | ~1: Wall }
PUpWin --> Split(Y) { 0.6: Wall | 0.12: Sill | 1.6: Glazing | 0.14: HoodBase | ~1: Wall }
// The crown: a cornice, and a gablet over the door run back into the roof,
// low enough that its peak stays under the main roof at the least depth.
Crown --> Comp(Faces) { Front: CrownFace | Back: RearCrownInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
CrownFace --> Split(X) { ~1: Cornice | 3.0: DoorGable | ~1: Cornice }
Cornice --> Split(Y) { 0.22: CorniceBed | ~1: CorniceCorona }
CorniceBed --> Extrude(0.18) Mat("Dressing") I("Cornice")
CorniceCorona --> Extrude(0.45) Mat("Dressing") I("Cornice")
DoorGable --> Translate(0, 0, 0.3 - Depth / 2) Size(scope.x, CrownH + 0.6 + 3.0, 0)
    Extrude(Depth / 2 - 0.3) Split(Y) { CrownH + 0.6: SlotWall | ~1: GabletRoof }
GabletRoof --> Roof(Gable, 50, overhang=0, ridge=Z) { Slope: SlateSlope | GableEnd: SlotWall }
RearCrownInset --> Split(X) { WallD: NIL | ~1: RearCrownIn | WallD: NIL }
RearCrownIn --> Translate(0, 0, -WallD) Wall
// The roof: slate along the street at 45 degrees - its ridge half the
// depth over its eaves - drawn from a sliver at the zone's foot, and from
// the rest the cresting, lifted to the ridge.
PRoofZone --> Split(Y) { 0.01: PRoof | ~1: CrestZone }
PRoof --> Roof(Gable, 45, overhang=0, ridge=X) { Slope: SlateSlope | GableEnd: SlotWall }
CrestZone --> Translate(0.05, Depth / 2 - 0.1, Depth / 2 - 0.04) Size(scope.x - 0.1, 0.5, 0.08)
    Mat("Iron") Split(Y) { 0.1: CrestRail | ~1: Spikes }
CrestRail --> I("Iron")
Spikes --> Repeat(X, 0.45) { SpikeBay }
SpikeBay --> Split(X) { ~1: NIL | 0.06: Spike | ~1: NIL }
Spike --> I("Iron")

// -- 3. The yard side: plain windows --
RearInset --> Split(X) { WallD: NIL | ~1: RearIn | WallD: NIL }
RearIn --> Translate(0, 0, -WallD) Repeat(X, 3.0) { RearBay }
RearBay --> Split(X) { ~1: Wall | 0.9: RearWindow | ~1: Wall }
RearWindow --> Split(Y) { 1.4: Wall | 1.3: Glazing | ~1: Wall }
RearUpperInset --> Split(X) { WallD: NIL | ~1: RearUpperIn | WallD: NIL }
RearUpperIn --> Translate(0, 0, -WallD) Repeat(X, 3.0) { RearUpperBay }
RearUpperBay --> Split(X) { ~1: Wall | 0.9: RearUpperWindow | ~1: Wall }
RearUpperWindow --> Split(Y) { 0.8: Wall | 1.3: Glazing | ~1: Wall }
