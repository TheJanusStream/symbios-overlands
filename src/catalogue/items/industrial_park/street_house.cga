// The industrial park's street house (#1598): a brick loft building. See
// street_house.rs for the building, and catalogue::items::street for the
// conventions and for what is declared ahead of these rules (Storeys, Trade,
// Frontage, Depth, GroundH, FloorH) and after them (Glazing, ShopGlazing,
// Wall).

const WallD = 0.45
const PaneSet = 0.18
const StepH = 0.5
const CourseH = 0.5
const ParapetH = 1.4
const TankH = 6.0
// How far the piers stand out of the brick between them.
const PierOut = 0.2

// -- 1. The building: its brick rolled once, then storeys, parapet, roof --
Lot --> Extrude(GroundH + FloorH * (Storeys - 1) + ParapetH + TankH) Brick
Brick --> 40% Mat("BrickRed") Massing | 35% Mat("BrickDark") Massing
    | 25% Mat("BrickBrown") Massing
Massing --> Split(Y) { GroundH: Ground | ~1: Uppers | ParapetH: Parapet | TankH: RoofTop }
// Party walls: the sides, the full depth, turning the corners.
PartyIn --> Translate(0, 0, -WallD) Wall
// A brick pier, standing proud of the front.
Pier --> Extrude(WallD + PierOut) I("Wall")

// -- 2. The ground storey: a loading door or a showroom, under a concrete
// band the whole frontage --
Ground --> Comp(Faces) { Front: GroundFace | Back: RearGroundInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
GroundFace --> Split(Y) { ~1: GroundFrontInset | CourseH: Course }
Course --> Extrude(0.16) Mat("Concrete") I("Trim")
GroundFrontInset --> Split(X) { WallD: NIL | ~1: GroundFrontIn | WallD: NIL }
GroundFrontIn --> Translate(0, 0, -WallD) GroundFront
GroundFront --> Split(X) { 0.7: Pier | ~1: GroundField | 0.7: Pier }
GroundField --> Split(X) { ~1: GroundA | 2.0: Entrance | ~1: GroundB }
GroundA --> when(Trade == 1): Showroom | else: LoadingBay
GroundB --> when(Trade == 1): Showroom | else: HighWindows
// The stair door: steel, up a step, under a glazed transom.
Entrance --> Split(X) { 0.3: Wall | ~1: EntranceDoor | 0.3: Wall }
EntranceDoor --> Split(Y) { StepH: Step | 2.5: DoorLeaf | 0.2: Lintel | ~1: Glazing }
Step --> Extrude(WallD + 0.3) Mat("Concrete") I("Trim")
DoorLeaf --> Extrude(WallD - 0.2) Mat("SteelDark") I("Door")
Lintel --> Extrude(WallD + 0.08) Mat("Concrete") I("Trim")
// The loading door: a roller shutter under a steel lintel.
LoadingBay --> Split(X) { ~1: Wall | 3.0: Roller | ~1: Wall }
Roller --> Split(Y) { 0.4: Wall | 3.0: RollerDoor | 0.22: SteelLintel | ~1: Wall }
RollerDoor --> Extrude(WallD - 0.15) Mat("Roller") I("Door")
SteelLintel --> Extrude(WallD + 0.06) Mat("Steel") I("Steel")
HighWindows --> Repeat(X, 2.1) { HighBay }
HighBay --> Split(X) { ~1: Wall | 1.5: HighWindow | ~1: Wall }
HighWindow --> Split(Y) { 1.4: Wall | 2.0: Glazing | 0.2: Lintel | ~1: Wall }
// The showroom: big windows on a concrete plinth under a painted fascia.
Showroom --> Split(Y) { ~1: ShowLevel | 0.7: ShowFascia | 0.25: Wall }
ShowLevel --> Repeat(X, 3.4) { ShowBay }
ShowBay --> Split(X) { 0.25: Wall | ~1: ShowWindow | 0.25: Wall }
ShowWindow --> Split(Y) { 0.6: ShowPlinth | ~1: ShopGlazing }
ShowPlinth --> Mat("Concrete") Wall
ShowFascia --> Extrude(WallD + 0.08) Mat("Fascia") I("Fascia")
RearGroundInset --> Split(X) { WallD: NIL | ~1: RearGroundIn | WallD: NIL }
RearGroundIn --> Translate(0, 0, -WallD) RearGround
RearGround --> Repeat(X, 3.2) { RearBay }
RearBay --> Split(X) { ~1: Wall | 1.6: RearWindow | ~1: Wall }
RearWindow --> Split(Y) { 1.2: Wall | 2.0: Glazing | ~1: Wall }

// -- 3. The upper storeys: brick piers, and between each pair a stack of
// big steel-framed windows on concrete sills under concrete lintels --
Uppers --> Comp(Faces) { Front: UpperFrontInset | Back: RearUpperInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
UpperFrontInset --> Split(X) { WallD: NIL | ~1: UpperFrontIn | WallD: NIL }
UpperFrontIn --> Translate(0, 0, -WallD) UpperFront
UpperFront --> Split(X) { 0.7: Pier | ~1: BayRun | 0.7: Pier }
BayRun --> Repeat(X, 3.8) { PierBay }
PierBay --> when(split.i == split.n - 1): WinStack | else: Split(X) { ~1: WinStack | 0.55: Pier }
WinStack --> Split(X) { ~1: Wall | 2.5: LoftCol | ~1: Wall }
LoftCol --> Repeat(Y, FloorH) { LoftWin }
LoftWin --> Split(Y) { 0.85: Wall | 0.14: Sill | 2.45: Glazing | 0.32: Lintel | ~1: Wall }
Sill --> Extrude(WallD + 0.08) Mat("Concrete") I("Trim")
RearUpperInset --> Split(X) { WallD: NIL | ~1: RearUpperIn | WallD: NIL }
RearUpperIn --> Translate(0, 0, -WallD) RearUpper
RearUpper --> Repeat(Y, FloorH) { RearStorey }
RearStorey --> Repeat(X, 3.2) { RearUpperBay }
RearUpperBay --> Split(X) { ~1: Wall | 1.8: RearUpperWindow | ~1: Wall }
RearUpperWindow --> Split(Y) { 0.9: Wall | 2.3: Glazing | ~1: Wall }

// -- 4. The parapet: a corbelled brick band, a concrete coping, and the
// deck inside it --
Parapet --> Comp(Faces) { Front: ParapetFront | Back: ParapetBack | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: Deck }
ParapetFront --> Split(Y) { 0.35: Corbel | ~1: ParapetInset | 0.2: Coping }
Corbel --> Extrude(0.14) I("Trim")
ParapetBack --> Split(Y) { ~1: ParapetInset | 0.2: Coping }
ParapetInset --> Split(X) { WallD: NIL | ~1: ParapetIn | WallD: NIL }
ParapetIn --> Translate(0, 0, -WallD) Wall
Coping --> Split(X) { WallD: NIL | ~1: CopingIn | WallD: NIL }
CopingIn --> Translate(0, 0, -WallD) Extrude(WallD + 0.06) Mat("Concrete") I("Trim")
// The deck fills the ring inside the parapet's walls.
Deck --> Translate(WallD, WallD, -0.2) Size(scope.x - 2 * WallD, scope.y - 2 * WallD, 0)
    Extrude(0.2) Mat("Deck") I("Roof")

// -- 5. The roof: a stepped brick gable over the middle of the front, and
// a timber water tank on steel legs where the building has one --
RoofTop --> Split(Z) { WallD: FrontTop | ~1: BackTop }
FrontTop --> Split(X) { ~1: NIL | 5.0: StepGable | ~1: NIL }
StepGable --> Split(Y) { 1.1: StepWall | 0.2: StepCoping | ~1: NIL }
StepWall --> I("Wall")
StepCoping --> Mat("Concrete") I("Trim")
BackTop --> Pick("tank") { 65% TankZone | 35% NIL }
TankZone --> Split(X) { ~1: NIL | 3.4: TankSlot | 1.4: NIL }
TankSlot --> Split(Z) { ~1: NIL | 3.4: TankSquare | 1.2: NIL }
// Hung from the deck: the legs stand on it (0.2 m over the walls) through
// the parapet's height.
TankSquare --> Translate(0, 0.2 - ParapetH, 0) Size(scope.x, ParapetH - 0.2 + TankH, scope.z)
    Split(Y) { ParapetH + 1.7: Legs | 0.2: Platform | 2.6: Drum | 0.9: Lid | ~1: NIL }
Legs --> Split(X) { 0.22: LegRow | ~1: NIL | 0.22: LegRow }
LegRow --> Split(Z) { 0.22: Leg | ~1: NIL | 0.22: Leg }
Leg --> Mat("Steel") I("Steel")
Platform --> Mat("SteelDark") I("Steel")
Drum --> Size(scope.x - 0.3, scope.y, scope.z - 0.3) Translate(0.15, 0, 0.15) Mat("Tank")
    I("Tank")
Lid --> Size(scope.x - 0.2, scope.y, scope.z - 0.2) Translate(0.1, 0, 0.1) Taper(0.92)
    Mat("TankLid") I("Tank")
