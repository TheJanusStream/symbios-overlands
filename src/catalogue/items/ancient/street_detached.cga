// The classical theme's detached house (#1600): a Roman villa in its
// garden. See street_detached.rs for the villa, and catalogue::items::street
// for the conventions and for what is declared ahead of these rules
// (Storeys, Trade, Frontage, Depth, GroundH, FloorH) and after them
// (Glazing, ShopGlazing, Wall).

const WallD = 0.45
const PaneSet = 0.16
const StepH = 0.55
const PlinthH = 0.6
const CornH = 0.3
const RoofH = 0.5
// How far the roof reaches past the walls: the walls stand this far in
// from the lot's sides, so the eaves keep inside it.
const Eave = 0.6
// The porch: its width along the front, how far it stands out.
const PorchW = 3.0
const PorchD = 1.5

// -- 1. The villa: its walls stand in from the lot, the plaster rolled once --
Lot --> Split(X) { Eave: NIL | ~1: LotRow | Eave: NIL }
LotRow --> Split(Z) { Eave: NIL | ~1: Plot | Eave: NIL }
Plot --> Extrude(GroundH + FloorH * (Storeys - 1) + CornH + RoofH) Plaster
Plaster --> 30% Mat("PlasterOchre") Massing | 25% Mat("PlasterRed") Massing
    | 20% Mat("PlasterCream") Massing | 25% Mat("PlasterWhite") Massing
Massing --> when(Storeys == 1): Split(Y) { GroundH: Ground | ~1: RoofZone }
    | else: Split(Y) { GroundH: Ground | FloorH * (Storeys - 1): Uppers | ~1: RoofZone }

// -- 2. The ground storey on its travertine plinth: the porch on the front,
// windows all round --
Ground --> Comp(Faces) { Front: FrontInset | Back: BackInset | Left: SideIn
    | Right: SideIn | Top: NIL | Bottom: NIL }
FrontInset --> Split(X) { WallD: NIL | ~1: FrontIn | WallD: NIL }
FrontIn --> Translate(0, 0, -WallD) GroundFront
GroundFront --> Split(X) { ~1: Run | PorchW: Entry | ~1: Run }
Run --> when(scope.x > 2.9): Repeat(X, 2.9) { WinBay } | else: WinBay
// A small window under a brick flat arch, shuttered one in two where the
// bay is wide enough.
WinBay --> when(scope.x > 2.0): ShutOrOpen | else: OpenBay
ShutOrOpen --> 50% ShutBay | 50% OpenBay
ShutBay --> Split(X) { ~1: PWall | 0.42: ShutterCol | 0.9: WinCol | 0.42: ShutterCol | ~1: PWall }
OpenBay --> Split(X) { ~1: PWall | 0.9: WinCol | ~1: PWall }
WinCol --> Split(Y) { PlinthH: Plinth | 0.5: Wall | 0.1: Sill | 1.4: Glazing | 0.26: Arch
    | ~1: Wall }
ShutterCol --> Split(Y) { PlinthH: Plinth | 0.6: Wall | 1.4: Shutter | ~1: Wall }
PWall --> Split(Y) { PlinthH: Plinth | ~1: Wall }
Plinth --> Mat("Travertine") Wall
Sill --> Extrude(WallD + 0.06) Mat("Travertine") I("Trim")
Arch --> Extrude(WallD + 0.04) Mat("Brick") I("Trim")
Shutter --> Extrude(WallD + 0.05) Mat("Timber") I("Trim")
Step --> Extrude(WallD + 0.3) Mat("Travertine") I("Trim")
DoorLeaf --> 60% Mat("Door") Leaf | 40% Mat("Bronze") Leaf
Leaf --> Extrude(WallD - 0.2) I("Door")
Entry --> Pick("porch") { 55% Portico | 45% Doorway }
// A doorway between travertine jambs under a lintel.
Doorway --> Split(X) { ~1: PWall | 0.35: Jamb | 1.4: DoorCol | 0.35: Jamb | ~1: PWall }
Jamb --> Split(Y) { StepH + 2.4: JambPost | ~1: Wall }
JambPost --> Extrude(WallD + 0.12) Mat("Travertine") I("Trim")
DoorCol --> Split(Y) { StepH: Step | 2.4: DoorLeaf | 0.3: Lintel | ~1: Wall }
Lintel --> Extrude(WallD + 0.12) Mat("Travertine") I("Trim")
// The portico: two turned marble columns standing out from the wall, an
// entablature from the wall to them and a pediment over it facing the
// street. Each part is extruded with the wall's slot and split from it, so
// the wall behind it stays whole.
Portico --> Split(Y) { ~1: PortLow | 0.5: PortTop }
PortLow --> Split(X) { 0.5: PortCol | ~1: PortDoor | 0.5: PortCol }
PortCol --> Extrude(WallD + PorchD) Split(Z) { WallD: SlotWall | ~1: NIL | 0.5: ColStand }
SlotWall --> I("Wall")
ColStand --> Split(Y) { 0.3: ColBase | ~1: Column }
ColBase --> Mat("Travertine") I("Trim")
Column --> Taper(0.08) Mat("Marble") I("Column")
PortDoor --> Split(Y) { StepH: Step | 2.2: DoorLeaf | ~1: Wall }
PortTop --> Extrude(WallD + PorchD) Split(Z) { WallD: SlotWall | ~1: Entab }
// The pediment stands a hair clear of the wall: its back gable would lie
// in the wall's face.
Entab --> Mat("Marble") Split(Y) { ~1: EntabBox | 0.01: PedSlot }
EntabBox --> I("Cornice")
PedSlot --> Split(Z) { 0.03: NIL | ~1: PorchPed }
PorchPed --> Roof(Gable, 20, overhang=0, ridge=Z) { Slope: Tiles | GableEnd: PedField }
PedField --> I("Trim")
// The garden side: wide windows to the garden, one bay in two.
BackInset --> Split(X) { WallD: NIL | ~1: BackIn | WallD: NIL }
BackIn --> Translate(0, 0, -WallD) BackRun
BackRun --> when(scope.x > 2.6): Repeat(X, 2.6) { BackBay } | else: OpenBay
BackBay --> 50% OpenBay | 50% Split(X) { ~1: PWall | 1.3: GardenCol | ~1: PWall }
GardenCol --> Split(Y) { PlinthH: Plinth | 0.1: Sill | 2.1: Glazing | 0.26: Arch | ~1: Wall }
// The sides: their walls run the full depth, turning the corners.
SideIn --> Translate(0, 0, -WallD) SideFace
SideFace --> Split(X) { 0.8: PWall | ~1: Run | 0.8: PWall }

// -- 3. The upper storeys: small windows under brick arches, all round --
Uppers --> Comp(Faces) { Front: UpInset | Back: UpInset | Left: UpSideIn
    | Right: UpSideIn | Top: NIL | Bottom: NIL }
UpInset --> Split(X) { WallD: NIL | ~1: UpIn | WallD: NIL }
UpIn --> Translate(0, 0, -WallD) UpFace
UpSideIn --> Translate(0, 0, -WallD) UpFace
UpFace --> Repeat(Y, FloorH) { UpStorey }
UpStorey --> Split(X) { 0.5: Wall | ~1: UpRun | 0.5: Wall }
UpRun --> when(scope.x > 2.8): Repeat(X, 2.8) { UpBay } | else: UpBay
UpBay --> 45% Split(X) { ~1: Wall | 0.36: UpShutCol | 0.8: UpWinCol | 0.36: UpShutCol | ~1: Wall }
    | 55% Split(X) { ~1: Wall | 0.8: UpWinCol | ~1: Wall }
UpWinCol --> Split(Y) { 0.9: Wall | 0.1: Sill | 1.2: Glazing | 0.26: Arch | ~1: Wall }
UpShutCol --> Split(Y) { 1.0: Wall | 1.2: Shutter | ~1: Wall }

// -- 4. The crown: a travertine cornice slab round the walls, and the
// roof - a tiled hip, or a temple front's gable to the street --
RoofZone --> Split(Y) { CornH: CorniceSlab | ~1: RoofTop }
CorniceSlab --> Translate(-0.3, 0, -0.3) Size(scope.x + 0.6, scope.y, scope.z + 0.6)
    Mat("Travertine") I("Cornice")
RoofTop --> Pick("roof") { 60% HipRoof | 40% TempleRoof }
HipRoof --> Roof(Hip, 22, overhang=Eave) { Slope: Tiles }
TempleRoof --> Roof(Gable, 22, overhang=Eave, ridge=Z) { Slope: Tiles | GableEnd: Tympanum }
Tympanum --> I("Wall")
Tiles --> Mat("Tile") I("Roof")
