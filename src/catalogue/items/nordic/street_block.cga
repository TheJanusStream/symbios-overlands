// The nordic theme's long block (#1598): a wharf row like Bergen's
// Bryggen, a house to each section under its own gable. See
// street_block.rs for the block, and catalogue::items::street for the
// conventions and for what is declared ahead of these rules and after them.

const WallD = 0.25
const PaneSet = 0.1
const PlinthH = 0.7
const StepH = 0.55
const EaveH = 0.4
const RoofH = 0.5
// One house to a section: under twelve metres so the frontages hold two,
// three and four of them (a Repeat floors its count).
const SectionW = 11.5
// The gables' pitch, and its rise over a run of one: tan(52 degrees).
const Pitch = 52
const Rise = 1.28

// -- 1. The row: a house to each section, each its own paint --
Lot --> Extrude(GroundH + FloorH * (Storeys - 1) + EaveH + RoofH) Repeat(X, SectionW) { House }
House --> 28% Mat("FaluRed") HouseMass | 24% Mat("Ochre") HouseMass
    | 20% Mat("White") HouseMass | 16% Mat("GreyBlue") HouseMass | 12% Mat("Tar") HouseMass
HouseMass --> Split(Y) { GroundH: Ground | ~1: Uppers | EaveH: Eaves | RoofH: RoofZone }
// Party walls: each house's sides, the full depth, turning the corners -
// between two houses of the row they stand back to back.
PartyIn --> Translate(0, 0, -WallD) Wall
// White trim: corner boards, window frames, sills and head boards.
Corner --> Extrude(WallD + 0.04) Mat("Trim") I("Trim")
Frame --> Extrude(WallD + 0.05) Mat("Trim") I("Trim")
Sill --> Extrude(WallD + 0.07) Mat("Trim") I("Trim")
Head --> Extrude(WallD + 0.09) Mat("Trim") I("Trim")
Framed --> Split(X) { 0.1: Frame | ~1: Glazing | 0.1: Frame }

// -- 2. The ground storey on its fieldstone plinth --
Ground --> Comp(Faces) { Front: GroundFrontInset | Back: RearGroundInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
GroundFrontInset --> Split(X) { WallD: NIL | ~1: GroundFrontIn | WallD: NIL }
GroundFrontIn --> Translate(0, 0, -WallD) GroundFront
GroundFront --> Split(X) { 0.3: GCorner | ~1: GroundRun | 1.8: Doorway | ~1: GroundRun
    | 0.3: GCorner }
GCorner --> Split(Y) { PlinthH: Plinth | ~1: Corner }
GWall --> Split(Y) { PlinthH: Plinth | ~1: Wall }
Plinth --> Extrude(WallD + 0.08) Mat("Plinth") I("Plinth")
GroundRun --> when(Trade == 1): Repeat(X, 3.2) { ShopBay } | else: Repeat(X, 2.4) { GWinBay }
ShopBay --> Split(X) { ~1: GWall | 2.2: ShopWin | ~1: GWall }
ShopWin --> Split(Y) { PlinthH: Plinth | 0.1: Sill | 1.9: ShopFramed | 0.25: Head | ~1: Wall }
ShopFramed --> Split(X) { 0.12: Frame | ~1: ShopGlazing | 0.12: Frame }
GWinBay --> Split(X) { ~1: GWall | 1.1: GWinCol | ~1: GWall }
GWinCol --> Split(Y) { PlinthH: Plinth | 0.45: Wall | 0.1: Sill | 1.5: Framed | 0.25: Head
    | ~1: Wall }
// The warehouse door up a stone step, a woven sign over it where it trades.
Doorway --> Split(X) { 0.15: Frame | ~1: DoorCol | 0.15: Frame }
DoorCol --> Split(Y) { StepH: Step | 2.4: DoorLeaf | 0.25: Head | ~1: OverDoor }
Step --> Extrude(WallD + 0.3) Mat("Stone") I("Plinth")
DoorLeaf --> Extrude(WallD - 0.1) Mat("Door") I("Door")
OverDoor --> when(Trade == 1): Split(Y) { 0.04: Wall | 0.3: Sign | ~1: Wall } | else: Wall
Sign --> Extrude(WallD + 0.05) Mat("Sign") I("Sign")
RearGroundInset --> Split(X) { WallD: NIL | ~1: RearGroundIn | WallD: NIL }
RearGroundIn --> Translate(0, 0, -WallD) RearGround
RearGround --> Repeat(X, 3.4) { RearBay }
RearBay --> Split(X) { ~1: Wall | 1.0: RearWindow | ~1: Wall }
RearWindow --> Split(Y) { 1.2: Wall | 1.3: Glazing | ~1: Wall }

// -- 3. The storeys: framed windows either side of a column of loft
// doors, or - a house in three - a gallery at every storey --
Uppers --> 35% Comp(Faces) { Front: GalleryInset | Back: RearUpperInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
    | 65% Comp(Faces) { Front: UpperFrontInset | Back: RearUpperInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
UpperFrontInset --> Split(X) { WallD: NIL | ~1: UpperFrontIn | WallD: NIL }
UpperFrontIn --> Translate(0, 0, -WallD) Repeat(Y, FloorH) { Storey }
Storey --> Split(X) { 0.3: Corner | ~1: Run | 1.4: LoftCol | ~1: Run | 0.3: Corner }
Run --> Repeat(X, 2.4) { WinBay }
WinBay --> Split(X) { ~1: Wall | 1.1: WinCol | ~1: Wall }
WinCol --> Split(Y) { 0.8: Wall | 0.1: Sill | 1.45: Framed | 0.25: Head | ~1: Wall }
LoftCol --> Split(X) { ~1: Wall | 1.0: LoftDoorCol | ~1: Wall }
LoftDoorCol --> Split(Y) { 0.3: Wall | 2.0: LoftDoor | ~1: Wall }
LoftDoor --> Extrude(WallD - 0.08) Mat("Door") I("Door")
// A gallery: a deck the house's width at each storey's foot, a board rail
// at its edge, the deck and the wall behind it split from one extrusion.
GalleryInset --> Split(X) { WallD: NIL | ~1: GalleryIn | WallD: NIL }
GalleryIn --> Translate(0, 0, -WallD) Repeat(Y, FloorH) { GalStorey }
GalStorey --> Split(Y) { 1.05: GalleryBand | ~1: GalWall }
GalleryBand --> Extrude(WallD + 1.3) Split(Z) { WallD: SlotWall | ~1: GalleryFront }
SlotWall --> I("Wall")
GalleryFront --> Mat("Log") Split(Y) { 0.15: GalDeck | ~1: GalRailZone }
GalDeck --> I("Gallery")
GalRailZone --> Split(Z) { ~1: NIL | 0.08: GalRail }
GalRail --> I("Gallery")
GalWall --> Split(X) { 0.3: Corner | ~1: GalRun | 0.3: Corner }
GalRun --> Repeat(X, 2.2) { GalBay }
GalBay --> Split(X) { ~1: Wall | 1.0: GalWin | ~1: Wall }
GalWin --> Split(Y) { 1.4: Framed | ~1: Head }
RearUpperInset --> Split(X) { WallD: NIL | ~1: RearUpperIn | WallD: NIL }
RearUpperIn --> Translate(0, 0, -WallD) Repeat(Y, FloorH) { RearStorey }
RearStorey --> Repeat(X, 4.0) { RearUpperBay }
RearUpperBay --> Split(X) { ~1: Wall | 1.0: RearUpperWindow | ~1: Wall }
RearUpperWindow --> Split(Y) { 0.9: Wall | 1.3: Glazing | ~1: Wall }

// -- 4. The eaves: a frieze under a white eave board, and up the gable's
// middle a carved mast - a hoist beam out of it under the peak, a finial
// over the peak. The gable's rise is Rise times its half-width. --
Eaves --> Comp(Faces) { Front: EaveFace | Back: RearEaveInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
EaveFace --> SectionEave(scope.x)
SectionEave(w) --> Split(X) { ~1: EaveRun | 0.3: Mast(w) | ~1: EaveRun }
EaveRun --> Split(Y) { ~1: Frieze | 0.25: EaveBoard }
Frieze --> Extrude(0.06) I("Wall")
EaveBoard --> Extrude(0.35) Mat("Trim") I("Trim")
Mast(w) --> Size(scope.x, EaveH + Rise * w / 2 + 1.2, 0) Translate(0, 0, -0.3) Extrude(0.45)
    Mat("Carving") Split(Y) { EaveH + 2.0: MastPart | 0.3: HoistBeam | ~1: MastPart }
MastPart --> I("Carving")
HoistBeam --> Size(scope.x, scope.y, scope.z + 1.1) I("Carving")
RearEaveInset --> Split(X) { WallD: NIL | ~1: RearEaveIn | WallD: NIL }
RearEaveIn --> Translate(0, 0, -WallD) Wall

// -- 5. Each house's gable, turned to the street, of tarred shakes or
// slate (Picked once for the row) --
RoofZone --> Roof(Gable, Pitch, overhang=0, ridge=Z) { Slope: RoofSlope | GableEnd: Gable }
RoofSlope --> Pick("roof") { 70% ShakeSlope | 30% SlateSlope }
ShakeSlope --> Mat("Shakes") I("Roof")
SlateSlope --> Mat("Slate") I("Roof")
Gable --> I("Wall")
