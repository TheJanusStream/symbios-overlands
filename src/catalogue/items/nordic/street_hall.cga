// The nordic theme's hall (#1600): a row of wharf warehouses, gables to
// the street. See street_hall.rs for the hall, and catalogue::items::street
// for the conventions and for what is declared ahead of these rules
// (Storeys, Trade, Frontage, Depth, GroundH, FloorH) and after them
// (Glazing, ShopGlazing, Wall).

const WallD = 0.25
const PaneSet = 0.1
const PlinthH = 0.6
const StepH = 0.55
const EaveH = 0.4
const RoofH = 0.5
// One warehouse to every nine metres of frontage, floored: each its own
// gable, so the crown stays low however deep the hall runs.
const BayW = 9.0
// The gables' pitch, and its rise over a run of one: tan(45).
const Pitch = 45
const Rise = 1.0

// -- 1. The row: tar for a works, paint where it trades, rolled once;
// then a warehouse to each bay, side by side --
Lot --> Extrude(GroundH + FloorH * (Storeys - 1) + EaveH + RoofH) Cladding
Cladding --> when(Trade == 1): Painted | else: Tarred
Tarred --> 65% Mat("Tar") Row | 35% Mat("FaluRed") Row
Painted --> 35% Mat("FaluRed") Row | 30% Mat("Ochre") Row | 35% Mat("White") Row
Row --> Repeat(X, BayW) { Warehouse }
Warehouse --> when(Storeys == 1): Split(Y) { GroundH: WGround | EaveH: WEaves | RoofH: WRoof }
    | else: Split(Y) { GroundH: WGround | ~1: WLoft | EaveH: WEaves | RoofH: WRoof }
// Party walls: each warehouse's sides, the full depth, turning the corners.
PartyIn --> Translate(0, 0, -WallD) Wall
// Trim: corner boards, window frames, sills and head boards.
Corner --> Extrude(WallD + 0.04) Mat("Trim") I("Trim")
Frame --> Extrude(WallD + 0.05) Mat("Trim") I("Trim")
Sill --> Extrude(WallD + 0.07) Mat("Trim") I("Trim")
Head --> Extrude(WallD + 0.09) Mat("Trim") I("Trim")
Framed --> Split(X) { 0.1: Frame | ~1: Glazing | 0.1: Frame }
GWall --> Split(Y) { PlinthH: Plinth | ~1: Wall }
GCorner --> Split(Y) { PlinthH: Plinth | ~1: Corner }
Plinth --> Extrude(WallD + 0.08) Mat("Plinth") I("Plinth")
Step --> Extrude(WallD + 0.3) Mat("Stone") I("Plinth")
DoorLeaf --> Extrude(WallD - 0.1) Mat("Door") I("Door")
Leaves --> Split(X) { ~1: DoorLeaf | 0.1: Frame | ~1: DoorLeaf }

// -- 2. The ground storey: a works' wide plank doors, or a trading house's
// shop windows --
WGround --> Comp(Faces) { Front: WFrontInset | Back: RearInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
WFrontInset --> Split(X) { WallD: NIL | ~1: WFrontIn | WallD: NIL }
WFrontIn --> Translate(0, 0, -WallD) WFront
WFront --> when(Trade == 1): Split(X) { 0.25: GCorner | ~1: ShopSide | 1.6: ShopDoor
    | ~1: ShopSide | 0.25: GCorner }
    | else: Split(X) { 0.25: GCorner | ~1: WorkSide | 3.0: BigDoor | ~1: WorkSide
    | 0.25: GCorner }
// The works: a wide plank door of two leaves over a stone apron, a framed
// window either side of it.
WorkSide --> Split(X) { ~1: GWall | 0.9: SideWin | ~1: GWall }
SideWin --> Split(Y) { PlinthH: Plinth | 1.4: Wall | 0.1: Sill | 1.4: Framed | 0.2: Head
    | ~1: Wall }
BigDoor --> Split(Y) { 0.45: Apron | 3.8: Leaves | 0.25: Head | ~1: Wall }
Apron --> Extrude(WallD + 1.0) Mat("Stone") I("Plinth")
// A trading house: a shop window either side of its door, a woven sign
// over the door.
ShopSide --> Split(X) { ~1: GWall | 2.0: ShopWin | ~1: GWall }
ShopWin --> Split(Y) { PlinthH: Plinth | 0.1: Sill | 2.2: ShopFramed | 0.25: Head | ~1: Wall }
ShopFramed --> Split(X) { 0.12: Frame | ~1: ShopGlazing | 0.12: Frame }
ShopDoor --> Split(Y) { StepH: Step | 2.4: Leaves | 0.25: Head | 0.2: Wall | 0.7: Sign
    | ~1: Wall }
Sign --> Extrude(WallD + 0.05) Mat("Sign") I("Sign")
// The wharf side: plain windows.
RearInset --> Split(X) { WallD: NIL | ~1: RearIn | WallD: NIL }
RearIn --> Translate(0, 0, -WallD) Repeat(X, 4.5) { RearBay }
RearBay --> Split(X) { ~1: Wall | 0.9: RearWin | ~1: Wall }
RearWin --> Split(Y) { 1.4: Wall | 1.2: Glazing | ~1: Wall }

// -- 3. The loft: a loading door of two leaves in the middle, a framed
// window either side --
WLoft --> Comp(Faces) { Front: LoftInset | Back: RearLoftInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
LoftInset --> Split(X) { WallD: NIL | ~1: LoftIn | WallD: NIL }
LoftIn --> Translate(0, 0, -WallD) Split(X) { 0.25: Corner | ~1: LoftSide | 1.6: LoftDoor
    | ~1: LoftSide | 0.25: Corner }
LoftSide --> Split(X) { ~1: Wall | 0.9: LoftWin | ~1: Wall }
LoftWin --> Split(Y) { 0.8: Wall | 0.1: Sill | 1.3: Framed | 0.2: Head | ~1: Wall }
LoftDoor --> Split(Y) { 0.4: Wall | 2.4: Leaves | 0.2: Head | ~1: Wall }
RearLoftInset --> Split(X) { WallD: NIL | ~1: RearLoftIn | WallD: NIL }
RearLoftIn --> Translate(0, 0, -WallD) Split(X) { ~1: Wall | 0.9: RearLoftWin | ~1: Wall }
RearLoftWin --> Split(Y) { 0.9: Wall | 1.2: Glazing | ~1: Wall }

// -- 4. The eaves: a frieze under a white eave board; in the middle of the
// gable over them a loft hatch, and a carved post up to a finial over the
// peak. The gable's rise is Rise times its half-width --
WEaves --> Comp(Faces) { Front: GableEave(scope.x) | Back: RearEaveInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
GableEave(w) --> Split(X) { ~1: EaveRun | 1.3: GableMid(w) | ~1: EaveRun }
EaveRun --> Split(Y) { ~1: Frieze | 0.22: EaveBoard }
Frieze --> Extrude(0.06) I("Wall")
EaveBoard --> Extrude(0.3) Mat("Trim") I("Trim")
GableMid(w) --> Size(scope.x, EaveH + Rise * w / 2 + 0.7, 0)
    Split(Y) { EaveH: EaveRun | 0.4: NIL | 1.4: HatchSlot | ~1: MastSlot }
// The hatch stands through the gable's face, so it shares no plane with it.
HatchSlot --> Translate(0, 0, -0.05) Extrude(0.13) Split(X) { ~1: HatchLeaf | 0.1: HatchBar
    | ~1: HatchLeaf }
HatchLeaf --> Mat("Door") I("Door")
HatchBar --> Mat("Trim") I("Trim")
MastSlot --> Split(X) { ~1: NIL | 0.28: Mast | ~1: NIL }
Mast --> Translate(0, 0, -0.3) Extrude(0.42) Mat("Carving") I("Carving")
RearEaveInset --> Split(X) { WallD: NIL | ~1: RearEaveIn | WallD: NIL }
RearEaveIn --> Translate(0, 0, -WallD) Wall

// -- 5. The roof: each warehouse's own steep gable, turned to the street,
// Picked once - tarred shakes, slate or turf --
WRoof --> Roof(Gable, Pitch, overhang=0, ridge=Z) { Slope: RoofSlope | GableEnd: Gable }
RoofSlope --> Pick("roof") { 45% ShakeSlope | 30% SlateSlope | 25% TurfSlope }
ShakeSlope --> Mat("Shakes") I("Roof")
SlateSlope --> Mat("Slate") I("Roof")
TurfSlope --> Mat("Turf") I("Roof")
Gable --> I("Wall")
