// The solarpunk theme's detached house (#1600): a timber eco house in its
// garden. See street_detached.rs for the house, and catalogue::items::street
// for the conventions and for what is declared ahead of these rules
// (Storeys, Trade, Frontage, Depth, GroundH, FloorH) and after them
// (Glazing, ShopGlazing, Wall).

const WallD = 0.4
const PaneSet = 0.14
const StepH = 0.5
const BeamH = 0.22
const RoofH = 1.0
// How far the roof reaches past the walls: the walls stand this far in
// from the lot's sides, so the eaves and verges keep inside it.
const Eave = 0.5

// -- 1. The house: its walls stand in from the lot, its boards rolled
// once, the ground storey in lime, cob or the boards --
Lot --> Split(X) { Eave: NIL | ~1: LotRow | Eave: NIL }
LotRow --> Split(Z) { Eave: NIL | ~1: Plot | Eave: NIL }
Plot --> Extrude(GroundH + FloorH * (Storeys - 1) + RoofH) Boards
Boards --> 40% Mat("Larch") Massing | 30% Mat("Silver") Massing | 30% Mat("Honey") Massing
Massing --> when(Storeys == 1): Split(Y) { GroundH: Ground | RoofH: RoofZone }
    | else: Split(Y) { GroundH: Ground | ~1: Uppers | RoofH: RoofZone }
Ground --> 40% Mat("Lime") GroundBody | 25% Mat("Cob") GroundBody | 35% GroundBody

// -- The frame: a dark post up every corner, cut from the strips each
// face's inset leaves, and a beam at every floor line between them --
Post --> Extrude(0.15) Mat("Frame") I("Frame")
Beam --> Extrude(0.15) Mat("Frame") I("Frame")
Greens --> 50% Mat("Leaf") Green | 30% Mat("Moss") Green | 20% Mat("Bloom") Green
Green --> I("Green")
PlainWall --> I("Wall")
// A window over a sill or a box of greens, under a solar shade or none,
// the window's piers climbed by a creeper here and there.
WinBay --> Split(X) { ~1: Pier | 1.3: WinCol | ~1: Pier }
UpBay --> Split(X) { ~1: Pier | 1.3: UpWinCol | ~1: Pier }
Pier --> 18% Creeper | 82% Wall
Creeper --> Extrude(WallD + 0.12) Ivy
Ivy --> 60% Mat("Leaf") Green | 40% Mat("Moss") Green
WinCol --> Split(Y) { 0.6: Wall | 0.3: SillZone | 1.6: Glazing | 0.12: ShadeZone | ~1: Wall }
UpWinCol --> Split(Y) { 0.45: Wall | 0.3: SillZone | 1.5: Glazing | 0.12: ShadeZone | ~1: Wall }
SillZone --> 40% WindowBox | 60% Split(Y) { ~1: Wall | 0.08: Sill }
Sill --> Extrude(WallD + 0.06) Mat("Frame") I("Trim")
WindowBox --> Extrude(WallD + 0.35) Split(Z) { WallD: PlainWall | ~1: BoxCol }
BoxCol --> Split(Y) { 0.2: BoxBody | ~1: Greens }
BoxBody --> Mat("Frame") I("Planter")
ShadeZone --> 60% Shade | 40% Wall
// A solar shade: a blade of panel standing out over the window, short of
// the lot's side.
Shade --> Extrude(WallD + 0.45) Mat("PV") I("Shade")

// -- 2. The ground storey: the door on the front, windows all round --
GroundBody --> Comp(Faces) { Front: GroundFace | Back: BackFace | Left: SideFace
    | Right: SideFace | Top: NIL | Bottom: NIL }
GroundFace --> Split(X) { WallD: Post | ~1: GroundMid | WallD: Post }
GroundMid --> Split(Y) { ~1: GroundFrontIn | BeamH: Beam }
GroundFrontIn --> Translate(0, 0, -WallD) Split(X) { ~1: Run | 2.6: Entrance | ~1.3: Run }
Run --> when(scope.x > 1.9): Repeat(X, 1.9) { WinBay } | else: WinBay
// The door up a lime step under a planted canopy, a rain barrel beside it.
Entrance --> Split(X) { 0.25: Wall | 1.1: DoorCol | 0.2: Wall | 0.8: BarrelStrip | ~1: Wall }
DoorCol --> Split(Y) { StepH: Step | 2.05: DoorLeaf | 0.12: CanopySlab | 0.25: CanopyGreen
    | ~1: Wall }
Step --> Extrude(WallD + 0.3) Mat("Lime") I("Trim")
DoorLeaf --> Extrude(WallD - 0.2) Mat("Door") I("Door")
CanopySlab --> Extrude(WallD + 0.8) Mat("Frame") I("Canopy")
CanopyGreen --> Extrude(WallD + 0.8) Split(Z) { WallD: PlainWall | ~1: Greens }
BarrelStrip --> Extrude(WallD + 0.75) Split(Z) { WallD: PlainWall | ~1: BarrelSlot }
BarrelSlot --> Split(X) { 0.03: NIL | ~1: BarrelCol | 0.03: NIL }
BarrelCol --> Split(Y) { 0.35: NIL | 0.95: Barrel | ~1: NIL }
Barrel --> Mat("Frame") I("Barrel")
// The garden side: a tall glazed door to the lawn, one bay in two.
BackFace --> Split(X) { WallD: Post | ~1: BackMid | WallD: Post }
BackMid --> Split(Y) { ~1: BackIn | BeamH: Beam }
BackIn --> Translate(0, 0, -WallD) Repeat(X, 2.4) { BackBay }
BackBay --> 50% WinBay | 50% Split(X) { ~1: Wall | 1.6: GardenCol | ~1: Wall }
GardenCol --> Split(Y) { 0.45: Wall | 2.2: Glazing | 0.12: ShadeZone | ~1: Wall }
// The sides: their walls run the full depth, turning the corners.
SideFace --> Split(X) { WallD: Post | ~1: SideMid | WallD: Post }
SideMid --> Split(Y) { ~1: SideIn | BeamH: Beam }
SideIn --> Translate(0, 0, -WallD) Split(X) { 0.5: Wall | ~1: SideRun | 0.5: Wall }
SideRun --> when(scope.x > 2.4): Repeat(X, 2.4) { WinBay } | else: WinBay

// -- 3. The upper storeys: boards between posts and beams, windows all
// round --
Uppers --> Comp(Faces) { Front: UpFace | Back: UpFace | Left: UpFace
    | Right: UpFace | Top: NIL | Bottom: NIL }
UpFace --> Split(X) { WallD: Post | ~1: UpMid | WallD: Post }
UpMid --> Repeat(Y, FloorH) { UpStorey }
UpStorey --> Split(Y) { ~1: UpIn | BeamH: Beam }
UpIn --> Translate(0, 0, -WallD) Split(X) { 0.2: Wall | ~1: UpRun | 0.2: Wall }
UpRun --> when(scope.x > 2.4): Repeat(X, 2.4) { UpBay } | else: UpBay

// -- 4. The roof: a sod gable with panels let into it, a mono-pitch of
// panels, or a green roof inside a parapet with rows of panels on it --
RoofZone --> Pick("roof") { 40% SodGable | 30% PanelShed | 30% GreenFlat }
SodGable --> Roof(Gable, 35, overhang=Eave, ridge=X) { Slope: SodSlope | GableEnd: Gable }
SodSlope --> Split(X) { ~1: Sod | ~2: PanelCol | ~1: Sod }
PanelCol --> Split(Y) { ~1: Sod | ~1.4: Panel | ~1: Sod }
Sod --> Mat("Moss") I("Roof")
Panel --> Mat("PV") I("PV")
Gable --> I("Wall")
// One slope of panels rising to the back, timber at its verges.
PanelShed --> Roof(Shed, 17, overhang=Eave) { Slope: PanelSlope | Back: Gable | GableEnd: Gable }
PanelSlope --> Split(X) { 0.4: Verge | ~1: Panel | 0.4: Verge }
Verge --> Mat("Frame") I("Trim")
// A timber parapet round a green deck, and a sliver at its top that sets
// rows of tilted panels down on the deck.
GreenFlat --> Split(Y) { ~1: Parapet | 0.01: PanelLayer }
Parapet --> Comp(Faces) { Front: ParapetFront | Back: ParapetFront | Left: ParapetSide
    | Right: ParapetSide | Top: NIL | Bottom: Deck }
ParapetFront --> Split(Y) { ~1: ParapetInset | 0.12: Coping }
ParapetInset --> Split(X) { WallD: NIL | ~1: ParapetIn | WallD: NIL }
ParapetIn --> Translate(0, 0, -WallD) Wall
ParapetSide --> Split(Y) { ~1: ParapetSideIn | 0.12: Coping }
ParapetSideIn --> Translate(0, 0, -WallD) Wall
Coping --> Extrude(0.08) Mat("Frame") I("Trim")
Deck --> Translate(WallD, WallD, -0.2) Size(scope.x - 2 * WallD, scope.y - 2 * WallD, 0)
    Extrude(0.2) Mat("Moss") I("Roof")
PanelLayer --> Translate(0, 0.2 - RoofH + 0.01, 0) Size(scope.x, 1.0, scope.z)
    Split(Z) { WallD + 0.4: NIL | ~1: PanelField | WallD + 0.4: NIL }
PanelField --> when(scope.z > 2.4): Repeat(Z, 2.4) { PanelRow } | else: PanelRow
PanelRow --> Split(Z) { ~1: PanelSlot | 0.7: NIL }
PanelSlot --> Split(X) { 0.8: NIL | ~1: PanelTilt | 0.8: NIL }
PanelTilt --> Roof(Shed, 25, overhang=0) { Slope: Panel | _: PanelSide }
PanelSide --> Mat("Steel") I("Trim")
