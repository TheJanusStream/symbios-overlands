// The solarpunk theme's street house (#1598): a timber town house. See
// street_house.rs for the house, and catalogue::items::street for the
// conventions and for what is declared ahead of these rules (Storeys,
// Trade, Frontage, Depth, GroundH, FloorH) and after them (Glazing,
// ShopGlazing, Wall).

const WallD = 0.4
const PaneSet = 0.14
const PlinthH = 0.6
const StepH = 0.55
const BeamH = 0.25
const PostW = 0.3
const ParapetH = 0.9
const RoofH = 5.0

// -- 1. The house: its boards rolled once, then storeys, parapet, roof --
Lot --> Extrude(GroundH + FloorH * (Storeys - 1) + ParapetH + RoofH) Boards
Boards --> 40% Mat("Larch") Massing | 30% Mat("Silver") Massing | 30% Mat("Honey") Massing
Massing --> Split(Y) { GroundH: Ground | ~1: Uppers | ParapetH: Parapet | RoofH: RoofTop }
// Party walls: the sides, the full depth, turning the corners.
PartyIn --> Translate(0, 0, -WallD) Wall

// -- The frame: a beam at every floor line, cut from the full face so a
// row's beams meet, and a post at each end of every storey --
Beam --> Extrude(0.15) Mat("Frame") I("Frame")
Post --> Extrude(WallD + 0.15) Mat("Frame") I("Frame")
Greens --> 50% Mat("Leaf") Green | 30% Mat("Moss") Green | 20% Mat("Bloom") Green
Green --> I("Green")
Step --> Extrude(WallD + 0.3) Mat("Lime") I("Trim")
DoorLeaf --> Extrude(WallD - 0.2) Mat("Door") I("Door")

// -- 2. The ground storey: a greengrocer's or a cafe, or homes, in lime --
Ground --> Mat("Lime") Comp(Faces) { Front: GroundFace | Back: RearGroundInset
    | Left: PartyIn | Right: PartyIn | Top: NIL | Bottom: NIL }
GroundFace --> Split(Y) { ~1: GroundFrontInset | BeamH: Beam }
GroundFrontInset --> Split(X) { WallD: NIL | ~1: GroundFrontIn | WallD: NIL }
GroundFrontIn --> Translate(0, 0, -WallD) GroundFront
GroundFront --> when(Trade == 1): ShopFront | else: HomeFront
ShopFront --> Split(X) { ~1: ShopRun | 2.1: Entrance | ~1: ShopRun }
ShopRun --> Repeat(X, 3.6) { ShopBay }
ShopBay --> Split(X) { 0.35: Wall | ~1: ShopUnit | 0.35: Wall }
ShopUnit --> when(scope.x > 2.4): Split(X) { ~1: ShopWindow | 1.1: ShopDoor }
    | else: ShopWindow
// A shop window over crates of greens, under a timber fascia.
ShopWindow --> Split(Y) { PlinthH: CrateZone | ~1: ShopGlazing | 0.6: Fascia }
CrateZone --> Extrude(WallD + 0.55) Split(Z) { WallD: CrateWall | ~1: Crate }
CrateWall --> I("Wall")
Crate --> Split(Y) { 0.4: CrateBox | ~1: Greens }
CrateBox --> Mat("Frame") I("Planter")
ShopDoor --> Split(Y) { StepH: Step | 2.3: DoorLeaf | ~1: ShopGlazing | 0.6: Fascia }
Fascia --> Extrude(WallD + 0.1) Mat("Frame") I("Fascia")
HomeFront --> Split(X) { ~1: HomeRun | 2.1: Entrance | ~1: HomeRun }
HomeRun --> Repeat(X, 2.6) { HomeBay }
HomeBay --> Split(X) { ~1: Wall | 1.4: HomeWindow | ~1: Wall }
HomeWindow --> Split(Y) { 1.3: Wall | 2.0: Glazing | ~1: Wall }
// The house door: a timber leaf up a step, a fanlight over it.
Entrance --> Split(X) { 0.3: Wall | ~1: EntranceDoor | 0.3: Wall }
EntranceDoor --> Split(Y) { StepH: Step | 2.6: DoorLeaf | ~1: Fanlight }
Fanlight --> Split(Y) { ~1: Glazing | 0.2: Wall }
// The garden side: tall windows.
RearGroundInset --> Split(X) { WallD: NIL | ~1: RearGroundIn | WallD: NIL }
RearGroundIn --> Translate(0, 0, -WallD) RearGround
RearGround --> Repeat(X, 2.8) { RearBay }
RearBay --> Split(X) { ~1: Wall | 1.3: RearWindow | ~1: Wall }
RearWindow --> Split(Y) { 1.0: Wall | 2.2: Glazing | ~1: Wall }

// -- 3. The upper storeys: board between posts and beams, planted
// balconies rolled bay by bay, a solar shade over every other window --
Uppers --> Comp(Faces) { Front: UpperFace | Back: RearUpperInset | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: NIL }
UpperFace --> Repeat(Y, FloorH) { StoreyFace }
StoreyFace --> Split(Y) { ~1: StoreyInset | BeamH: Beam }
StoreyInset --> Split(X) { WallD: NIL | ~1: StoreyIn | WallD: NIL }
StoreyIn --> Translate(0, 0, -WallD) Storey
Storey --> Split(X) { PostW: Post | ~1: Bays | PostW: Post }
Bays --> Repeat(X, 2.8) { Bay }
Bay --> 35% BalconyBay | 65% WinBay
WinBay --> Split(X) { ~1: Pier | 1.5: WinCol | ~1: Pier }
// A creeper climbs a pier here and there.
Pier --> 22% Creeper | 78% Wall
Creeper --> Extrude(WallD + 0.15) Ivy
Ivy --> 60% Mat("Leaf") Green | 40% Mat("Moss") Green
WinCol --> Split(Y) { 0.75: Wall | 0.1: Sill | 1.75: Glazing | 0.1: Shade | ~1: Wall }
Sill --> Extrude(WallD + 0.06) Mat("Frame") I("Trim")
// A solar shade: a blade of panel standing out over the window.
Shade --> Extrude(WallD + 0.75) Mat("PV") I("Shade")
// A planted balcony: a timber deck, a planter of greens along its edge
// over a low wall, a glazed door behind.
BalconyBay --> Split(X) { 0.25: Wall | ~1: BalconyCol | 0.25: Wall }
BalconyCol --> Split(Y) { 0.18: BalconyDeck | 0.8: PlanterZone | 1.85: Glazing | ~1: Wall }
BalconyDeck --> Extrude(WallD + 1.2) Mat("Frame") I("Balcony")
PlanterZone --> Extrude(WallD + 1.2) Split(Z) { WallD: LowWall | ~1: NIL | 0.6: Planter }
LowWall --> I("Wall")
Planter --> Split(Y) { 0.35: PlanterBox | ~1: Greens }
PlanterBox --> Mat("Frame") I("Planter")
RearUpperInset --> Split(X) { WallD: NIL | ~1: RearUpperIn | WallD: NIL }
RearUpperIn --> Translate(0, 0, -WallD) RearUpper
RearUpper --> Repeat(Y, FloorH) { RearStorey }
RearStorey --> Repeat(X, 2.8) { RearUpperBay }
RearUpperBay --> Split(X) { ~1: Wall | 1.3: RearUpperWindow | ~1: Wall }
RearUpperWindow --> Split(Y) { 0.8: Wall | 1.9: Glazing | ~1: Wall }

// -- 4. The parapet: timber, a coping, a green roof inside it --
Parapet --> Comp(Faces) { Front: ParapetFace | Back: ParapetFace | Left: PartyIn
    | Right: PartyIn | Top: NIL | Bottom: Deck }
ParapetFace --> Split(Y) { ~1: ParapetInset | 0.12: Coping }
ParapetInset --> Split(X) { WallD: NIL | ~1: ParapetIn | WallD: NIL }
ParapetIn --> Translate(0, 0, -WallD) Wall
Coping --> Extrude(0.08) Mat("Frame") I("Trim")
// The deck fills the ring inside the parapet's walls: the bottom face's
// inward is up.
Deck --> Translate(WallD, WallD, -0.2) Size(scope.x - 2 * WallD, scope.y - 2 * WallD, 0)
    Extrude(0.2) Mat("Moss") I("Roof")

// -- 5. The roof: rows of panels on the green roof, or a roof of panels
// along the street, its gable ends the party walls --
RoofTop --> Pick("roof") { 60% PanelRows | 40% PanelRoof }
PanelRows --> Translate(0, 0.2 - ParapetH, 0) Size(scope.x, scope.y + ParapetH - 0.2, scope.z)
    Split(Z) { WallD + 0.4: NIL | ~1: PanelField | WallD + 0.4: NIL }
PanelField --> Repeat(Z, 2.4) { PanelRow }
PanelRow --> Split(Z) { ~1: PanelSlot | 0.7: NIL }
PanelSlot --> Split(X) { 0.8: NIL | ~1: PanelFrame | 0.8: NIL }
PanelFrame --> Split(Y) { 1.0: PanelTilt | ~1: NIL }
PanelTilt --> Roof(Shed, 25, overhang=0, ridge=X) { Slope: PanelFace | All: PanelSide }
PanelFace --> Mat("PV") I("PV")
PanelSide --> Mat("Steel") I("Trim")
PanelRoof --> Roof(Gable, 30, overhang=0, ridge=X) { Slope: PanelFace | GableEnd: RoofGable }
RoofGable --> I("Wall")
